// Shared build settings for baucord.xcodeproj (IOS-SPEC.md §11).
//
// Machine-specific values go in Local.xcconfig beside this file — not
// committed; copy Local.xcconfig.example. It is included last, so
// whatever it sets wins.

// The app's bundle id. Bundle ids are unique across every Apple
// account: if Xcode reports this one as taken, set your own in
// Local.xcconfig.
BAUCORD_BUNDLE_ID = dev.baucord

// The signing team; Local.xcconfig sets it. Empty is enough for the
// simulator.
DEVELOPMENT_TEAM =

// The version and the build number. ios/run.sh writes Version.xcconfig
// on every run: the workspace's version (the root Cargo.toml — every
// platform ships the same number) and the commit count. These values
// only stand in until it has run once; the cargo build phase refuses
// to build while the version disagrees with the crate's.
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 1
#include? "Version.xcconfig"

#include? "Local.xcconfig"
