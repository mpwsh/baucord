// widgets.slint — reusable primitives for the baucord skin.
//
// Everything here is flat, rounded, and reactive: hover/press states
// animate over ~150ms so state changes feel intentional. Meters are
// plain Rectangles with width bindings — the custom-draw code the FLTK
// build needed is gone.

import { Icon, IconSet, IconDisplay } from "@lucide";
import { Theme } from "theme.slint";
import { MenuEntry, State } from "globals.slint";

// ── Tooltips ────────────────────────────────────────────────────────────

/// The one tooltip a window shows. A hovered control writes it here and
/// the window's `TipLayer`, declared last, draws it above every pane.
/// Each control used to draw its own tip as a child of itself, under
/// whatever was declared after it: the sidebar covered the chat's
/// tips, the channel list the sidebar header's. Globals are per
/// window, so every window that has tips also has a `TipLayer`.
export global Tip {
    out property <string> text;
    /// The control the tip is about, in window coordinates.
    out property <length> anchor-x;
    out property <length> anchor-y;
    out property <length> anchor-w;
    out property <length> anchor-h;
    /// Under the control rather than over it (a control along the top).
    out property <bool> below;

    public function show(text: string, x: length, y: length, w: length, h: length, below: bool) {
        self.anchor-x = x;
        self.anchor-y = y;
        self.anchor-w = w;
        self.anchor-h = h;
        self.below = below;
        self.text = text;
    }
    /// Clear the tip if it is still `text`'s: a hover that ended after
    /// another began must not take the newer one down.
    public function hide(text: string) {
        if (self.text == text) {
            self.text = "";
        }
    }
}

/// Draws `Tip`: after a short dwell, at once while another tip was just
/// showing (moving along a row of buttons), gone after a while like a
/// native one, flipped and clamped to stay inside the window. Put it
/// last in the window, the window's full size; it takes no input.
export component TipLayer inherits Rectangle {
    /// Off on touch screens, where a hover is a finger.
    in property <bool> enabled: true;
    property <string> text: root.enabled ? Tip.text : "";
    property <bool> dwelled: false;
    /// A tip showed a moment ago: the next one comes without the dwell.
    property <bool> warm: false;
    property <bool> shown: root.text != "" && (root.dwelled || root.warm);
    changed text => {
        if (root.text == "") {
            root.dwelled = false;
        }
    }
    Timer {
        interval: 400ms;
        running: root.text != "" && !root.dwelled && !root.warm;
        triggered => {
            root.dwelled = true;
            root.warm = true;
        }
    }
    Timer {
        interval: 500ms;
        running: root.text == "" && root.warm;
        triggered => { root.warm = false; }
    }
    // A tip whose control vanished under the pointer (no exit comes)
    // does not stay up for good.
    Timer {
        interval: 8s;
        running: root.shown;
        triggered => { Tip.hide(root.text); }
    }

    if root.shown : bubble := Rectangle {
        property <length> pad: Theme.gap-sm;
        property <length> room: 6px;
        property <bool> fits-above: Tip.anchor-y - self.height - self.room >= 4px;
        property <bool> fits-below: Tip.anchor-y + Tip.anchor-h + self.room + self.height
            <= root.height - 4px;
        property <bool> place-below: Tip.below ? self.fits-below || !self.fits-above
            : !self.fits-above && self.fits-below;
        width: Math.min(label.preferred-width, 280px) + 2 * self.pad;
        height: label.height + 8px;
        x: Math.clamp(Tip.anchor-x + (Tip.anchor-w - self.width) / 2,
            4px, Math.max(4px, root.width - self.width - 4px));
        y: self.place-below ? Tip.anchor-y + Tip.anchor-h + self.room
            : Tip.anchor-y - self.height - self.room;
        border-radius: Theme.radius-sm;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-color: #00000040;
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 2px;
        label := Text {
            x: bubble.pad;
            y: 4px;
            width: bubble.width - 2 * bubble.pad;
            text: root.text;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
    }
}

// ── Touch ───────────────────────────────────────────────────────────────

/// Touch hosts: a finger held still on something does its long-press
/// action (a row's menu, as a right-click on the desktop). `pressing`
/// is the target's TouchArea hover, which on touch means "a finger is
/// down here": Slint sends an exit after every release, and a scroll
/// taking over sends one too. `fired` holds until the finger lifts:
/// every tap handler under it checks it, so letting go after a long
/// press never also counts as a tap.
export component LongPress {
    in property <bool> pressing;
    out property <bool> fired: false;
    callback long-pressed();
    changed pressing => {
        if (!self.pressing) { self.fired = false; }
    }
    Timer {
        interval: 500ms;
        running: State.touch-host && root.pressing && !root.fired;
        triggered => {
            root.fired = true;
            root.long-pressed();
        }
    }
}

// ── Buttons ─────────────────────────────────────────────────────────────

/// Standard subdued button. `accent`/`danger` switch the fill for
/// primary and destructive actions; `engaged` marks a latched toggle.
export component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> accent: false;
    in property <bool> danger: false;
    in property <bool> engaged: false;
    in property <bool> enabled: true;
    callback clicked;

    property <bool> filled: accent || danger || engaged;
    property <brush> fill:
        danger ? Theme.danger
        : accent ? (touch.has-hover ? Theme.accent-hover : Theme.accent)
        : engaged ? Theme.accent-hover
        : touch.has-hover ? Theme.hover : Theme.bg-tertiary;

    height: 36px;
    // Room around the label: without it a layout gives the button the
    // text's own width, and the edges cut right where the letters end.
    min-width: lbl.preferred-width + 2 * Theme.gap-lg;
    border-radius: Theme.radius-md;
    background: fill;
    opacity: enabled ? (touch.pressed ? 0.85 : 1.0) : 0.4;
    animate background { duration: 150ms; }
    animate opacity { duration: 100ms; }

    lbl := Text {
        text: root.text;
        color: filled ? Theme.on-accent : Theme.text-primary;
        font-size: Theme.font-body;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Android: the tap takes the focus first. A word the keyboard is
    // still composing in the field being edited is not in that field's
    // text until committed, and Slint commits it when the field loses
    // focus — so "Connect" or "Save" now sees the whole name, not the
    // name without its last word. The keyboard closes, as on any
    // Android form.
    sink := FocusScope {
        width: 0px;
        height: 0px;
        focus-on-click: false;
        focus-on-tab-navigation: false;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            if (Platform.os == OperatingSystemType.android) {
                sink.focus();
            }
            root.clicked();
        }
    }
}

/// Square icon button around a Lucide glyph (`icon: IconSet.Mic`).
/// `active` latches it (engaged toggle) and `active-danger` colors
/// the latched state raspberry instead of cobalt.
export component IconBtn inherits Rectangle {
    in property <Icon> icon;
    in property <string> tooltip;
    /// Show the tip under the button, ending at its right edge (for
    /// buttons in a top-right corner, where above and centered would
    /// leave the window).
    in property <bool> tooltip-below: false;
    in property <bool> active: false;
    in property <bool> active-danger: false;
    in property <length> size: 40px;
    in property <length> icon-size: 18px;
    in property <color> idle-color: Theme.text-secondary;
    callback clicked;

    width: size;
    height: size;
    border-radius: Theme.radius-md;
    background:
        active ? (active-danger ? Theme.danger : Theme.accent)
        : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 150ms; }

    IconDisplay {
        icon: root.icon;
        size: root.icon-size;
        stroke: root.active ? Theme.on-accent
            : touch.has-hover ? Theme.text-primary : root.idle-color;
        animate stroke { duration: 150ms; }
    }

    /// Tell the window's tip layer about this button's tip, or that
    /// it is no longer wanted.
    function post-tip() {
        if (touch.has-hover && root.tooltip != "") {
            Tip.show(root.tooltip, self.absolute-position.x, self.absolute-position.y,
                self.width, self.height, root.tooltip-below);
        } else {
            Tip.hide(root.tooltip);
        }
    }
    // The words change under the pointer (Mute becomes Unmute).
    changed tooltip => {
        if (touch.has-hover) {
            Tip.hide(Tip.text);
            root.post-tip();
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            // A native tip goes with the click.
            Tip.hide(root.tooltip);
            root.clicked();
        }
        changed has-hover => { root.post-tip(); }
    }
}

// ── Text input ──────────────────────────────────────────────────────────

/// Single-line dark input with rounded border and focus ring.
export component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    in property <bool> secret: false;
    in property <InputType> input-type: secret ? InputType.password : InputType.text;
    callback accepted;                 // Enter
    // Fires per keystroke. Character caps are enforced host-side (the
    // shell trims and writes `text` back) — Slint strings have no
    // substring op, and the wire check in send_current still guards.
    callback edited;
    public function focus-input() { input.focus(); }
    /// Android: commit the word the keyboard is still composing into
    /// `text` (Slint does it when the field loses focus) — see the
    /// composer's twin in chat.slint.
    function commit-composition() {
        if (Platform.os == OperatingSystemType.android && input.preedit-text != "") {
            input.clear-focus();
            input.focus();
        }
    }

    height: 40px;
    // Never let content inflate the layout: a single-line TextInput's
    // minimum width tracks its text, and inside a layout that minimum
    // propagates all the way up — a long draft used to push the
    // composer's counter and send button off-window.
    min-width: 120px;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    animate border-color { duration: 150ms; }

    // The TextInput sits OUTSIDE any layout, positioned manually, so
    // its content-derived size constraints go nowhere; the viewport
    // clips, and the cursor-follow math slides the input so the caret
    // stays visible. This mirrors std-widgets' LineEditBase.
    viewport := Rectangle {
        x: Theme.gap-md;
        width: parent.width - 2 * Theme.gap-md;
        height: 100%;
        clip: true;
        input := TextInput {
            property <length> computed-x;
            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            height: 100%;
            single-line: true;
            vertical-alignment: center;
            font-size: Theme.font-body;
            color: Theme.text-primary;
            // A composing word is drawn with the selection colours:
            // plain text instead (see the composer in chat.slint).
            selection-background-color: self.preedit-text != "" ? transparent : Theme.accent;
            selection-foreground-color: self.preedit-text != "" ? Theme.text-primary : Theme.on-accent;
            input-type: root.input-type;
            // Enter on Android: the keyboard finishes its word without
            // telling the field, so commit it before acting on the text.
            accepted => {
                root.commit-composition();
                root.accepted();
            }
            edited => { root.edited(); }
            cursor-position-changed(pos) => {
                if (pos.x + self.computed-x < 0px) {
                    self.computed-x = -pos.x;
                } else if (pos.x + self.computed-x > parent.width - self.text-cursor-width) {
                    self.computed-x = parent.width - pos.x - self.text-cursor-width;
                }
            }
        }
    }
    if input.text == "" && !input.has-focus : Text {
        x: Theme.gap-md;
        height: 100%;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.text-muted;
        font-size: Theme.font-body;
    }
}

// ── Slider ──────────────────────────────────────────────────────────────

/// Horizontal slider: rounded track, accent fill, round thumb.
/// `live-changed` fires on every drag tick, `released` once at the end
/// (mirrors the FLTK release-to-commit popup behavior where needed).
export component HSlider inherits Rectangle {
    in property <float> minimum: 0.0;
    in property <float> maximum: 1.0;
    in-out property <float> value: 0.0;
    callback live-changed(float);
    callback released(float);

    height: 24px;
    property <float> norm: Math.clamp((value - minimum) / Math.max(0.0001, maximum - minimum), 0.0, 1.0);
    property <length> usable: root.width - 16px;

    track := Rectangle {
        y: (root.height - self.height) / 2;
        height: 6px;
        border-radius: 3px;
        background: Theme.subtle;
    }
    fillbar := Rectangle {
        x: 0;
        y: (root.height - self.height) / 2;
        height: 6px;
        width: 8px + root.norm * root.usable;
        border-radius: 3px;
        background: Theme.accent;
    }
    thumb := Rectangle {
        x: root.norm * root.usable;
        y: (root.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: touch.has-hover || touch.pressed ? Theme.text-primary : #C8C9CA;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if (self.pressed) {
                root.value = Math.clamp(
                    root.minimum + ((self.mouse-x - 8px) / root.usable) * (root.maximum - root.minimum),
                    root.minimum, root.maximum);
                root.live-changed(root.value);
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.value = Math.clamp(
                    root.minimum + ((self.mouse-x - 8px) / root.usable) * (root.maximum - root.minimum),
                    root.minimum, root.maximum);
                root.live-changed(root.value);
            }
            if (ev.kind == PointerEventKind.up) {
                root.released(root.value);
            }
        }
    }
}

// ── Meters ──────────────────────────────────────────────────────────────

/// VU meter: accent → amber → raspberry as the level rises.
/// The level property is pushed from Rust (8 Hz while visible).
export component VuMeter inherits Rectangle {
    in property <float> level: 0.0;       // 0.0–1.0
    in property <color> accent: Theme.meter;

    height: 20px;
    border-radius: Theme.radius-sm;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    property <float> lv: Math.clamp(level, 0.0, 1.0);
    bar := Rectangle {
        x: 2px;
        y: 3px;
        height: root.height - 6px;
        width: (root.width - 4px) * root.lv;
        border-radius: Theme.radius-sm - 2px;
        background: root.lv > 0.9 ? Theme.danger
            : root.lv > 0.7 ? Theme.warning
            : root.accent;
        // The glide between two readings, at the display's own rate:
        // without it the bar is seen stepping at the timer's rate,
        // whatever that comes to on the device. It costs frames only
        // while a bar is moving on the Audio tab — the app sets the
        // level when it changed and not otherwise (`app_core::meter`).
        // It was taken out when the timer ran on every tab and drew
        // every reading (review P2-40), and the bar stepped.
        animate width { duration: 80ms; easing: linear; }
    }
}

/// Gate meter: green when the level clears the threshold, dim below;
/// a raspberry marker shows the threshold position. `display-scale`
/// mirrors the input pipeline's rms*3 scaling.
export component GateMeter inherits Rectangle {
    in property <float> level: 0.0;
    in property <float> threshold: 0.02;   // raw threshold
    in property <float> display-scale: 3.0;

    height: 20px;
    border-radius: Theme.radius-sm;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    property <float> lv: Math.clamp(level, 0.0, 1.0);
    property <float> thr: Math.clamp(threshold * display-scale, 0.0, 1.0);

    bar := Rectangle {
        x: 2px;
        y: 4px;
        height: root.height - 8px;
        width: (root.width - 4px) * root.lv;
        border-radius: Theme.radius-sm - 2px;
        background: root.lv > root.thr ? Theme.success : Theme.subtle;
        // As the VuMeter's.
        animate width { duration: 80ms; easing: linear; }
    }
    marker := Rectangle {
        x: 2px + (root.width - 4px) * root.thr - 1px;
        y: 1px;
        width: 2px;
        height: root.height - 2px;
        background: Theme.danger;
    }
}

// ── Avatar tile ─────────────────────────────────────────────────────────

/// The avatar tile: the picture, or the initial on a tinted square.
/// Rounded square rather than a circle — it sits better in rows and
/// gives the ring something to follow. `ring` lights for voice.
export component AvatarTile inherits Rectangle {
    in property <image> source;
    in property <bool> has-image: false;
    in property <string> initial;
    in property <color> tint;
    in property <length> side: 22px;
    in property <length> corner: 6px;
    /// Voice-activity ring, 2px outside the tile (concentric radius).
    in property <bool> ring: false;
    in property <color> ring-color: Theme.success;
    /// Reserve the ring's room in the box (roster rows); off for
    /// places that never ring (chat, the card).
    in property <bool> ring-room: true;
    /// Dimmed with a strike: locally muted.
    in property <bool> struck: false;

    width: side + (ring-room ? 8px : 0px);
    height: side + (ring-room ? 8px : 0px);

    if ring : Rectangle {
        width: root.side + 4px;
        height: root.side + 4px;
        border-radius: root.corner + 2px;
        border-width: 2px;
        border-color: root.ring-color;
    }
    tile := Rectangle {
        width: root.side;
        height: root.side;
        border-radius: root.corner;
        background: root.has-image ? transparent : root.tint;
        clip: true;
        opacity: root.struck ? 0.45 : 1.0;
        if root.has-image : Image {
            width: 100%;
            height: 100%;
            source: root.source;
            image-fit: cover;
        }
        if !root.has-image : Text {
            text: root.initial;
            color: Theme.text-primary;
            font-size: root.side * 0.5;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if struck : Rectangle {
        width: root.side + 6px;
        height: 2px;
        background: Theme.text-muted;
        transform-rotation: -45deg;
    }
}

// ── Check row ───────────────────────────────────────────────────────────

/// A labelled checkbox: the whole row toggles, the box shows the
/// state, an optional hint sits under the label.
export component CheckRow inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> text;
    in property <string> hint;
    in property <bool> enabled: true;
    callback toggled(bool);

    height: body.preferred-height + 2 * Theme.gap-xs;
    // Concentric with the box: 4px box radius + 4px padding.
    border-radius: 8px;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 150ms; }

    body := HorizontalLayout {
        padding: Theme.gap-xs;
        spacing: Theme.gap-sm;
        Rectangle {
            width: 18px;
            box := Rectangle {
                y: 2px;
                width: 18px;
                height: 18px;
                border-radius: 4px;
                opacity: root.enabled ? 1.0 : 0.4;
                background: root.checked ? Theme.accent : Theme.surface;
                border-width: 1px;
                border-color: root.checked ? Theme.accent : Theme.border;
                animate background, border-color { duration: 150ms; }
                if root.checked : IconDisplay {
                    icon: IconSet.Check;
                    size: 14px;
                    stroke: Theme.on-accent;
                }
            }
        }
        VerticalLayout {
            spacing: 2px;
            Text {
                text: root.text;
                color: root.enabled ? Theme.text-primary : Theme.text-muted;
                font-size: Theme.font-body;
            }
            if root.hint != "" : Text {
                text: root.hint;
                color: Theme.text-muted;
                opacity: root.enabled ? 1.0 : 0.6;
                font-size: Theme.font-xs;
                wrap: word-wrap;
            }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// ── Layout helpers ──────────────────────────────────────────────────────

/// 1px separator line.
export component Sep inherits Rectangle {
    height: 1px;
    background: Theme.subtle;
}

/// Raised rounded card.
export component Card inherits Rectangle {
    border-radius: Theme.radius-lg;
    background: Theme.bg-secondary;
}

/// A dialog over the window: the scrim, a card in the middle of it, and
/// the ways out every dialog has — a click on the scrim, Escape, and
/// Android's Back, which arrives as a key. What is put inside is laid
/// out as a column in the card. (Eight dialogs each carried a copy of
/// this, Back handling included; review P2-58.)
///
/// The dialog takes the keyboard when it appears. A dialog that wants
/// its first field focused does that in `opened`, not in the field's
/// own `init`: that one runs before this component's, and the scope
/// then took the keyboard back — typing and Enter went nowhere.
export component Modal inherits Rectangle {
    /// The card's width, where the window has the room.
    in property <length> card-width: 380px;
    /// The dialog is up and has the keyboard: focus a field here.
    callback opened();
    /// Escape, Back, or a click outside the card.
    callback dismissed();
    /// Any other key no field inside took: Return for the dialog's
    /// default action.
    callback key(KeyEvent) -> EventResult;

    background: Theme.scrim;
    TouchArea { clicked => { root.dismissed(); } }
    FocusScope {
        init => {
            self.focus();
            root.opened();
        }
        key-pressed(ev) => {
            if (ev.text == Key.Escape || ev.text == Key.Back) {
                root.dismissed();
                return accept;
            }
            return root.key(ev);
        }
        Card {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(root.card-width, root.width - 48px);
            height: body.preferred-height;
            TouchArea { }   // swallow clicks inside the card
            body := VerticalLayout {
                padding: Theme.gap-lg;
                spacing: Theme.gap-md;
                @children
            }
        }
    }
}

/// A ring that fills with a percent: determinate, so it says how far,
/// not just that something moves. 28 px square, the ring 18 px in it.
export component ProgressRing inherits Rectangle {
    in property <int> percent;
    in property <brush> track-color: Theme.subtle;
    in property <brush> ring-color: Theme.accent-text;
    property <float> frac: Math.clamp(root.percent, 0, 100) / 100;
    property <angle> sweep: frac * 360deg;
    property <float> ex: 9 + 8 * Math.sin(sweep);
    property <float> ey: 9 - 8 * Math.cos(sweep);
    width: 28px;
    height: 28px;
    Path {
        x: 5px;
        y: 5px;
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        commands: "M 9 1 A 8 8 0 1 1 8.99 1";
        stroke: root.track-color;
        stroke-width: 2px;
    }
    Path {
        x: 5px;
        y: 5px;
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        commands: root.frac >= 0.999
            ? "M 9 1 A 8 8 0 1 1 8.99 1"
            : "M 9 1 A 8 8 0 \{root.frac > 0.5 ? 1 : 0} 1 \{root.ex} \{root.ey}";
        stroke: root.ring-color;
        stroke-width: 2px;
        stroke-line-cap: round;
    }
}

/// Small field label above a control.
export component FieldLabel inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.font-sm;
}

/// Muted hint under a control.
export component Hint inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-xs;
    wrap: word-wrap;
}

/// Bold section heading.
export component SectionHeader inherits Text {
    color: Theme.text-primary;
    font-size: Theme.font-md;
    font-weight: 700;
}

// ── Role glyph ──────────────────────────────────────────────────────────

/// A role's badge by its wire name (`permissions::ROLE_ICONS`); the
/// list is closed, so the mapping lives here.
export component RoleGlyph inherits Rectangle {
    in property <string> name;
    in property <length> size: 14px;
    in property <color> stroke: Theme.text-secondary;
    width: root.size;
    IconDisplay {
        size: root.size;
        stroke: root.stroke;
        icon: root.name == "star" ? IconSet.Star
            : root.name == "crown" ? IconSet.Crown
            : root.name == "shield" ? IconSet.Shield
            : root.name == "wrench" ? IconSet.Wrench
            : root.name == "zap" ? IconSet.Zap
            : root.name == "flame" ? IconSet.Flame
            : root.name == "heart" ? IconSet.Heart
            : root.name == "gem" ? IconSet.Gem
            : root.name == "trophy" ? IconSet.Trophy
            : root.name == "sword" ? IconSet.Sword
            : root.name == "music" ? IconSet.Music
            : root.name == "gamepad" ? IconSet.Gamepad2
            : root.name == "video" ? IconSet.Video
            : root.name == "mic" ? IconSet.Mic
            : root.name == "eye" ? IconSet.Eye
            : IconSet.Bot;
    }
}

// ── Context menu column ─────────────────────────────────────────────────

/// One column of a context menu: a raised panel of `MenuEntry` rows.
/// The overlay in main.slint places it, opens a second column beside
/// an entry with a submenu when the pointer rests on it, and forwards
/// picks to the host. Drawn in the app's own skin because the
/// toolkit's context menu is native (and unstylable) on macOS and
/// Windows.
export component MenuPanel inherits Rectangle {
    in property <[MenuEntry]> entries;
    /// The entry whose submenu is open: stays highlighted while the
    /// pointer is in the child column.
    in property <int> open-entry: -1;
    /// A `slider` entry draws as a slider bound here
    /// instead of a text row.
    in-out property <float> volume: 1.0;
    /// An entry was picked: its `MenuEntry.id`.
    callback activated(id: int);
    /// The pointer rests on `entry`; `model` is its submenu (-1 for
    /// none) and `y` where the row starts, relative to this panel.
    callback submenu-hovered(entry: int, model: int, y: length);
    callback volume-changed(float);
    callback volume-released(float);

    width: Math.clamp(body.preferred-width, 180px, 320px);
    height: body.preferred-height;
    // Concentric with the rows: radius-sm + 4px padding.
    border-radius: Theme.radius-sm + 4px;
    background: Theme.bg-tertiary;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-color: #00000066;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 4px;

    body := VerticalLayout {
        padding: 4px;
        for e[i] in root.entries : VerticalLayout {
            if e.separator : Rectangle {
                height: 9px;
                Rectangle {
                    x: Theme.gap-sm;
                    y: 4px;
                    width: parent.width - 2 * Theme.gap-sm;
                    height: 1px;
                    background: Theme.border;
                }
            }
            // The volume slider, inline: one drag instead of a dialog.
            if e.slider : Rectangle {
                height: 52px;
                // Under the slider (declared first): a pointer resting
                // on the label line is no submenu hover.
                TouchArea {
                    changed has-hover => {
                        if (self.has-hover) { root.submenu-hovered(i, -1, 0px); }
                    }
                }
                VerticalLayout {
                    padding-left: Theme.gap-sm;
                    padding-right: Theme.gap-sm;
                    padding-top: 4px;
                    spacing: 2px;
                    HorizontalLayout {
                        Text {
                            text: e.label;
                            color: Theme.text-primary;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "\{Math.round(root.volume * 100)}%";
                            color: Theme.text-muted;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                        }
                    }
                    HSlider {
                        minimum: 0.0;
                        maximum: 2.0;
                        value <=> root.volume;
                        live-changed(v) => { root.volume-changed(v); }
                        released(v) => { root.volume-released(v); }
                    }
                }
            }
            if !e.slider : row := Rectangle {
                height: 30px;
                border-radius: Theme.radius-sm;
                background: e.enabled && (it.has-hover || root.open-entry == i)
                    ? Theme.hover : transparent;
                animate background { duration: 100ms; }
                HorizontalLayout {
                    padding-left: Theme.gap-sm;
                    padding-right: Theme.gap-sm;
                    spacing: Theme.gap-sm;
                    Text {
                        text: e.label;
                        color: !e.enabled ? Theme.text-muted
                            : e.danger ? Theme.danger-text
                            : Theme.text-primary;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if e.submenu >= 0 : Rectangle {
                        width: 14px;
                        IconDisplay {
                            icon: IconSet.ChevronRight;
                            size: 14px;
                            stroke: Theme.text-muted;
                        }
                    }
                }
                it := TouchArea {
                    enabled: e.enabled;
                    mouse-cursor: e.enabled ? MouseCursor.pointer : MouseCursor.default;
                    changed has-hover => {
                        if (self.has-hover) {
                            root.submenu-hovered(i, e.submenu, row.absolute-position.y - root.absolute-position.y);
                        }
                    }
                    clicked => {
                        if (e.submenu >= 0) {
                            root.submenu-hovered(i, e.submenu, row.absolute-position.y - root.absolute-position.y);
                        } else {
                            root.activated(e.id);
                        }
                    }
                }
            }
        }
    }
}

// ── Dropdown ────────────────────────────────────────────────────────────

/// Rounded dark dropdown. Options come as a string model; index 0 is
/// conventionally the default entry ("System default", …).
export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current: 0;
    /// Shown while nothing is picked (`current` out of range).
    in property <string> placeholder;
    callback selected(int);

    height: 36px;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.border;
    animate border-color { duration: 150ms; }

    HorizontalLayout {
        padding-left: Theme.gap-md;
        padding-right: Theme.gap-sm;
        spacing: Theme.gap-sm;
        Text {
            text: root.current >= 0 && root.current < root.options.length
                ? root.options[root.current] : root.placeholder;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // An icon, not a "▾": Windows' and Android's system fonts have
        // no such character, and Slint draws a square for it there.
        Rectangle {
            width: 14px;
            IconDisplay {
                icon: IconSet.ChevronDown;
                size: 14px;
                stroke: Theme.text-muted;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { pop.show(); }
    }

    pop := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        Rectangle {
            background: Theme.bg-tertiary;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 4px;
                for opt[i] in root.options : Rectangle {
                    height: 30px;
                    border-radius: Theme.radius-sm;
                    background: it.has-hover ? Theme.hover
                        : i == root.current ? Theme.accent : transparent;
                    Text {
                        x: Theme.gap-sm;
                        width: parent.width - 2 * Theme.gap-sm;
                        height: 100%;
                        vertical-alignment: center;
                        text: opt;
                        color: i == root.current && !it.has-hover ? Theme.on-accent : Theme.text-primary;
                        font-size: Theme.font-body;
                        overflow: elide;
                    }
                    it := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current = i;
                            root.selected(i);
                        }
                    }
                }
            }
        }
    }
}
