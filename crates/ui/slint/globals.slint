// globals.slint — host interop contract.
//
// Two-global pattern (interop.md): `State` is what Rust pushes in,
// `Logic` is what the UI calls out. Any component reads/calls them
// directly — nothing threads through component properties.
//
// The row structs mirror app-core's view-model types; the shell
// converts and keeps live Rc<VecModel<…>> handles for in-place updates.

// ── App phase ───────────────────────────────────────────────────────────

export enum Phase {
    splash,          // checking for updates
    update-prompt,   // newer version available
    downloading,     // update download in progress
    download-done,   // zip staged, offer install
    download-failed, // download error
    connect,         // nickname + server form (and the invite box)
    main,            // sidebar + chat
}

// ── Row models ──────────────────────────────────────────────────────────

export struct UserRow {
    client-id-lo: int,      // ClientId is u64; split for exact round-trips
    client-id-hi: int,
    name: string,
    volume-pct: int,        // 100 = default; badge shown when != 100
    is-us: bool,
    speaking: bool,
    local-muted: bool,      // muted *by us*
    self-muted: bool,       // their broadcast state
    self-deafened: bool,
    sharing: bool,          // "LIVE" badge + Watch stream in popover
    // Voice channels: the roster is one flat model of channel header
    // rows with their members beneath (keeps ListView virtualization
    // and the in-place row-update contract). When is-channel is set,
    // only the channel-* / locked / member-label / name fields matter.
    is-channel: bool,
    channel-id: int,
    locked: bool,           // channel requires a password
    member-label: string,   // "3" or "3/8" with a user limit
    is-our-channel: bool,   // the channel we are in (highlight, no-op click)
    // 1.1 — from the server's tables (UserDetails / ChannelDetails).
    // For user rows `channel-id` is the channel they are in.
    role: int,              // users: 0 unknown, 1 guest, 2 member, 3 organizer, 4 admin
    level: int,             // users: progress level, 0 = unknown
    level-label: string,    // users: "Level 3" for the hover card ("" = unknown)
    role-label: string,     // users: "Member" for the hover card ("" = none)
    role-icon: string,      // users: a custom role's glyph name ("" = none)
    role-color: color,      // users: a custom role's color
    has-role-color: bool,
    xp-pct: int,            // users: 0…100 into the current level; -1 = unknown
    xp-line: string,        // users: "128 / 250 xp to level 4"
    telemetry: string,      // users: the last telemetry (admins only), "" otherwise
    // Profile look (spec §7.1): the picture, or a tinted tile with the
    // initial; the name's color and style.
    avatar: image,
    has-avatar: bool,
    initial: string,
    tile-tint: color,
    name-color: color,
    has-name-color: bool,   // false = the theme's default name color
    name-style: int,        // 0 normal, 1 bold, 2 italic
    outranked: bool,        // users: rank strictly below ours — mute/disconnect/kick/ban apply
    role-editable: bool,    // users: rank at or below ours — the role submenu applies
    channel-kickable: bool, // users: we own their channel (or manage all) — send to default
    members-only: bool,     // channels: a min-role gate exists
    temporary: bool,        // channels: evaporates when left empty
    is-afk: bool,           // channels: the server's AFK room
    owned: bool,            // channels: this session created it
    from-config: bool,      // channels: the server's file owns it (no delete/rename)
}

/// A channel as the "Move to" submenu lists it (visible ones only).
export struct ChannelOption { id: int, name: string }

/// One direct-message conversation in the sidebar's Messages section.
export struct DmRow {
    name: string,
    unread: int,
    active: bool,        // the conversation open in the chat pane
    online: bool,        // the other person has a session
    avatar: image,
    has-avatar: bool,
    initial: string,
    tile-tint: color,
    admin: bool,         // the admin channel (spec §8): a shield, not a person
}

/// The toast's register: what color and glyph it carries.
export enum ToastKind { info, success, warning, error }

/// What a moderation dialog is about to do (spec §4.1 / §4.2).
export enum ModAction { mute-voice, mute-chat, unmute-voice, unmute-chat, disconnect, kick, ban }

/// What a context-menu entry does (app-core's `menu::Action`, minus
/// its parameter, which rides in `MenuEntry.arg`). The host builds
/// the entries and dispatches the pick against the target it
/// remembered — a roster row, a message, the composer.
export enum MenuAction {
    none,
    channel-edit, channel-delete,
    volume, mute-for-me, reset-audio, watch, message,
    set-role, move-to, channel-kick,
    mute-voice, mute-chat, unmute-voice, unmute-chat, disconnect, kick, ban,
    copy-text, select-text, edit-message, delete-message, open-image, save-image,
    cut, copy, paste,
    save-file,
    copy-image,
}

/// One row of a context menu, drawn by the overlay in main.slint.
export struct MenuEntry {
    label: string,
    action: MenuAction,
    arg: int,            // role, channel id, or 1/0 for select-text
    enabled: bool,
    separator: bool,     // a rule above this entry
    danger: bool,        // destructive: danger-colored label
    submenu: int,        // index into State.menu-submenus; -1 = none
}

/// One chat row. `kind`: 0 = message, 1 = system, 2 = image, 3 = code
/// (a ```-fenced block; links stay inline in kind-0 rows via
/// StyledText), 4 = day divider (`body` is its label).
export struct ChatRow {
    kind: int,
    ts: string,
    user: string,
    body: string,        // message text / system text / code (kind 3)
    styled: bool,        // kind 0 — body carries *bold*/_italic_/`code` markup
    body-styled: styled-text, // kind 0 when styled — pre-parsed by the shell
    image: image,        // kind 2 — current frame (Rust swaps for GIFs)
    img-w: float,        // native px, for aspect layout
    img-h: float,
    row-id: int,         // stable id for gif hover/click callbacks
    is-gif: bool,
    // 1.1 — the server's message id (u64, split like client ids) and
    // what it lets the row do.
    msg-id-lo: int,
    msg-id-hi: int,
    own: bool,           // authored by this session: edit/delete in the menu
    edited: bool,        // "(edited)" mark after the body
    deleted: bool,       // body gone: muted placeholder, no menu
    pending: bool,       // sent, not acknowledged yet: drawn muted
    /// Continues the run above (same author within five minutes, no
    /// system line or divider between): no picture, no header.
    continuation: bool,
    // The author's look (see UserRow).
    avatar: image,
    has-avatar: bool,
    initial: string,
    tile-tint: color,
    name-color: color,
    has-name-color: bool,
    name-style: int,
    file-kind: string,      // files: "PDF" — the card's type word
    file-meta: string,      // files: "1.2 MB" — the card's second line
    transfer-kind: int,     // files: 0 none, 1 uploading, 2 downloading
    transfer-pct: int,      // files: 0…100 while a transfer runs
    file-saved: bool,       // files: already in the Downloads folder
}

export struct EmojiRow  { glyph: string, code: string, section: string }
export struct KeybindRow { action-label: string, bind: string, recording: bool }
export struct ServerRow { name: string, address: string, is-default: bool }

// ── State (host → UI) ───────────────────────────────────────────────────

export global State {
    in property <Phase> phase: Phase.connect;

    // Startup / update flow (formatted host-side)
    in property <string> update-heading;
    in property <string> update-body;
    in property <float>  update-progress: 0.0;   // 0..1
    in property <string> update-progress-text;

    // Connect view
    in-out property <string> nickname;
    in property <[string]> server-names;   // saved servers, by name
    in-out property <int> server-index: 0; // dropdown pick = default server
    /// The server asked for an invite (unknown device, or the code did
    /// not admit): show the code box with this explanation.
    in property <bool> invite-prompt: false;
    in property <string> invite-prompt-text;
    /// Typed into the code box. Connect sends it; it is stored on the
    /// selected server until the server admits us.
    in-out property <string> invite-code;
    /// A verdict that stays until the next attempt (banned, name in
    /// use, device unlinked, removed by an admin).
    in property <string> connect-notice;
    in property <string> error-text;       // 5s toast, cleared by host
    /// A file from the OS is being dragged over the window.
    in property <bool> drop-hover: false;
    in property <ToastKind> toast-kind: ToastKind.error;
    in property <string> device-warning;   // "saved mic missing" notice

    // Roster / sidebar
    in property <[UserRow]> users;
    /// The server's display name (`Init`): the sidebar's title.
    in property <string> server-name;
    /// The server's greeting (`Init`): the General header's second line.
    in property <string> greeting;
    in property <string> users-count-label;
    /// The Messages section is folded to its header (a setting).
    in property <bool> messages-collapsed: false;
    /// The sidebar's width: dragged at its edge, kept in settings.
    in-out property <length> sidebar-width: 260px;
    /// The Messages section's height: dragged at its divider, kept in
    /// settings.
    in-out property <length> messages-height: 200px;
    in property <bool> muted;
    in property <bool> deafened;
    /// Push-to-talk: the mic is closed until the key is held.
    in property <bool> ptt-mode: false;
    in property <bool> ptt-held: false;
    in property <string> ptt-tooltip;      // "Push to talk — hold F10"
    // Chat preferences (Settings → General → Chat)
    in property <bool> show-timestamps: true;
    in property <bool> compact-rows: false;
    in property <bool> sharing;
    in property <string> status-text;      // "● Connected"
    in property <color> status-color: #2BAC76;
    in property <string> latency-line;
    in property <string> resource-line;
    in property <string> stream-stats;     // "" hides the block
    in property <bool> stream-degraded;

    // Chat
    in property <[ChatRow]> chat;
    in-out property <string> draft;
    in property <int> max-chars: 400;
    /// Older pages exist on the server (History.more): the "load
    /// earlier" control appears at the top of the list.
    in property <bool> history-more: false;
    in property <bool> history-loading: false;
    /// The composer is rewriting one of our messages (Enter saves,
    /// Escape restores the draft).
    in property <bool> editing: false;
    /// RESTRICT: the delete entry appears on everyone's messages.
    in property <bool> perm-delete-any: false;
    /// The one styled chat row shown as selectable plain text (its
    /// row id; -1 = none). The row's menu and a double-click toggle it.
    in-out property <int> selecting-row: -1;

    // ── Invite dialog (spec §3.1) ───────────────────────────────────
    // Options are indices into the lists the host fills; the created
    // code shows in the same dialog, with a copy button.
    in property <bool> invite-dialog-open: false;
    in property <[string]> invite-role-options;
    in property <[string]> invite-expiry-options;
    in property <[string]> invite-uses-options;
    in-out property <int> invite-dialog-role: 0;
    in-out property <int> invite-dialog-expiry: 1;
    in-out property <int> invite-dialog-uses: 3;
    in property <string> invite-dialog-code;      // "" until created
    in property <string> invite-dialog-summary;   // "member, expires in 23 h, unlimited uses"
    in property <string> invite-dialog-error;     // "" when none

    // ── Context menu (main.slint draws it; the host fills it) ──────
    // Window coordinates of the click that opened it; the overlay
    // keeps the panel inside the window.
    in property <bool> menu-open: false;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <[MenuEntry]> menu-entries;
    /// Second columns, referenced by `MenuEntry.submenu`.
    in property <[[MenuEntry]]> menu-submenus;
    /// A user row's menu carries their volume slider (0…2, 1 = as
    /// sent); the host seeds it and applies every move.
    in-out property <float> menu-volume: 1.0;

    // Channel dialog (create, or edit one we may manage; spec §5)
    in property <bool> channel-dialog-open: false;
    in property <bool> channel-dialog-editing: false;   // false = create
    in property <string> channel-dialog-title;
    in-out property <string> channel-dialog-name;
    in-out property <string> channel-dialog-password;
    in-out property <string> channel-dialog-limit;      // "" = unlimited
    in-out property <string> channel-dialog-afk;        // minutes; "" = server default
    in-out property <bool> channel-dialog-keep: false;  // permanent
    in-out property <bool> channel-dialog-members-only: false;
    in property <string> channel-dialog-error;          // "" when none
    /// Editing a protected channel whose password this device never
    /// saw: the server needs it resent or it is cleared.
    in property <string> channel-dialog-password-note;

    // Generic confirm (delete a message or a channel): the host
    // remembers what is being confirmed.
    in property <bool> confirm-open: false;
    in property <string> confirm-title;
    in property <string> confirm-body;
    in property <string> confirm-label;     // verb-first, repeats the consequence

    // Emoji picker (from app-core's catalog)
    in property <[EmojiRow]> emoji;

    // Screen share dialog
    in property <[string]> monitors;      // preformatted "Name — 1920x1080 (primary)"
    in property <[string]> qualities;
    in property <int> default-monitor: 0;
    in property <int> default-quality: 0;
    // 0 = my channel, 1 = everyone — prefilled from saved settings.
    in property <int> default-scope: 0;

    // Image send preview overlay
    in property <bool> preview-open: false;
    in property <image> preview-image;
    in property <string> preview-caption;  // "1280×720 — 412 KB"

    // Channel password prompt (locked channel clicked / wrong password)
    in property <bool> channel-prompt-open: false;
    in property <string> channel-prompt-name;
    in property <string> channel-prompt-error;   // "" when none
    in-out property <string> channel-password;


    // ── 1.1: what this session may do (Session.permissions, rendered
    // as bools — Slint has no 64-bit int). The server decides; these
    // only choose what to draw.
    in property <bool> perm-mute: false;        // MUTE or RESTRICT
    in property <bool> perm-disconnect: false;
    in property <bool> perm-kick: false;
    in property <bool> perm-ban: false;
    in property <bool> perm-move: false;        // MANAGE_CHANNELS
    /// Connected but in no room yet: the server's lobby (spec §12,
    /// 1.1.5). The banner shows, the mic hint says why.
    in property <bool> in-lobby: false;
    in property <bool> perm-roles: false;       // MANAGE_ROLES
    in property <bool> perm-users: false;       // MANAGE_USERS (telemetry tooltip)
    in property <bool> perm-create-channels: false;
    in property <bool> perm-create-invites: false;
    in property <bool> perm-manage-invites: false;  // longer expiries
    in property <bool> perm-panel: false;           // the Admin chip (PANEL)
    in property <bool> perm-admin-channel: false;   // the Messages row (ADMIN_CHANNEL)
    in property <bool> perm-manage-own: false;  // MANAGE_OWN_CHANNELS
    /// Our highest built-in role (same scale as UserRow.role): the
    /// role submenu offers roles up to it.
    in property <int> our-role: 0;
    /// `Session.persistent`: false earns a standing notice on
    /// moderation dialogs and in chat (spec §1.1).
    in property <bool> server-persistent: true;
    /// Channels this session can see, for the "Move to" submenu.
    in property <[ChannelOption]> channel-options;

    // ── 1.1.1: direct messages (spec §6) ────────────────────────────
    /// The Messages section: DM conversations, newest first.
    in property <[DmRow]> dms;
    /// Which DM is open in the chat pane; -1 = General.
    in property <int> active-dm: -1;
    in property <string> conv-name;         // the partner's name when a DM is open
    in property <bool> perm-dm: false;      // we may send DMs (members and up)
    /// Sum of unread DMs, for the Messages header.
    in property <int> dm-unread-total: 0;
    /// Messages that landed in General while a DM was open.
    in property <int> general-unread: 0;

    // Profile card (roster rows and chat pictures summon it): which
    // roster row it shows, and where the hovered element sits in
    // window coordinates. -1 = none.
    in-out property <int> card-index: -1;
    /// A chat author who is no longer in the roster: the host builds a
    /// row from what it still knows (name, look, "Offline") and opens
    /// the same card with it.
    in property <UserRow> card-guest;
    in property <bool> card-guest-open: false;
    in-out property <length> card-x;
    in-out property <length> card-y;
    in-out property <length> card-anchor-h;

    // Moderation dialog (kick / ban / disconnect / mute with a reason)
    in property <bool> moderation-open: false;
    in property <ModAction> moderation-action: ModAction.kick;
    in property <string> moderation-title;         // "Kick alice?"
    in property <string> moderation-hint;          // what it means
    in property <string> moderation-confirm-label; // "Kick alice"
    in property <[string]> moderation-durations;   // ban / mute only; empty = none
    in-out property <int> moderation-duration: 0;
    in-out property <string> moderation-reason;

    // Image viewer overlay (chat image tapped) — replaces the old
    // separate gallery window.
    in property <bool> viewer-open: false;
    in property <image> viewer-image;
    in property <string> viewer-heading;
    in property <bool> viewer-has-prev: false;
    in property <bool> viewer-has-next: false;
}

// ── Logic (UI → host) ───────────────────────────────────────────────────

export global Logic {
    // Connect view
    callback connect-clicked();
    /// Dropdown pick — the host persists it as the default server.
    callback connect-server-selected(int);
    /// Pencil icon — open Settings on the Servers tab.
    callback edit-servers();
    callback open-settings();
    callback quit();

    // Sidebar
    callback toggle-mute();
    callback toggle-deafen();
    callback toggle-share();
    callback disconnect();
    /// The pointer entered/left a user row: the host fetches the last
    /// telemetry for the card when it may.
    callback user-hovered(int, bool);
    /// The LIVE chip on a user row was clicked: open (or raise) that
    /// sharer's viewer.
    callback watch-user(index: int);
    /// Drag a user onto a channel (spec §12, 1.1.5; holders of
    /// MANAGE_CHANNELS). The payload is opaque to Slint: the host
    /// builds it from the row's index and reads it back on the
    /// channel row. `can-drop-user` says whether this channel takes
    /// this user (a different channel than the one they are in).
    pure callback user-drag-data(id-lo: int, id-hi: int) -> data-transfer;
    pure callback can-drop-user(data: data-transfer, channel-index: int) -> bool;
    callback drop-user(data: data-transfer, channel-index: int);
    /// The pointer entered/left an author's picture in chat: the host
    /// resolves the name to a roster row and sets `State.card-index`.
    callback author-hovered(string, bool);

    // ── Context menus ───────────────────────────────────────────
    // A row asks for its menu at a window position; the host builds
    // the entries (app-core's `menu`) and opens the overlay. Every
    // pick comes back through `menu-activated` and is dispatched
    // against the row the host remembered.
    /// A roster row (right-click, or a left-click on a user row).
    callback user-context(index: int, x: length, y: length);
    /// A chat row; `selecting` = a styled body is in its plain view.
    callback row-context(row: ChatRow, selecting: bool, x: length, y: length);
    callback composer-context(x: length, y: length);
    callback menu-activated(action: MenuAction, arg: int);
    /// The slider in a user's menu: every move is heard at once,
    /// the release is what is kept.
    callback menu-volume-changed(float);
    callback menu-volume-released(float);
    /// Escape, or a click outside the panel.
    callback menu-closed();
    // 1.1.1 — the Messages section
    callback dm-clicked(int);                  // index into State.dms
    callback dm-closed(int);                   // hide the conversation (nothing is deleted)
    callback general-clicked();                // back to the general chat
    /// The Messages header's chevron: fold the section or open it.
    callback messages-toggle();
    /// The sidebar's edge was dragged and let go: keep the width.
    callback sidebar-resized(length);
    callback moderation-confirm();             // reads State.moderation-*
    callback moderation-cancel();

    // Chat
    callback send-message();
    callback draft-edited();              // host enforces the char cap
    /// Shift+Enter: splice a newline at the caret (byte offsets; the
    /// host owns string surgery — .slint has no substring ops).
    callback composer-newline(cursor: int, anchor: int);
    /// macOS Ctrl+A / Ctrl+E (and ⌘←/⌘→): the caret to the line start/end.
    callback composer-line-edge(cursor: int, to-end: bool);
    /// ⌘↓: the caret to the end of the draft (a byte offset the host
    /// knows; .slint has no byte length).
    callback composer-doc-end();
    /// A printable key landed on a chat row (focus went there with a
    /// text selection): the host appends it to the draft and refocuses
    /// the composer, so typing anywhere in the chat writes a message.
    callback type-through(string);
    /// The paperclip: any file — an image previews as before, the
    /// rest uploads and posts as a card (spec §7).
    callback attach-image();
    /// A card's Save: fetch the blob into the Downloads folder.
    callback file-save(int);
    /// A saved card's Open: the file, with what the system uses for it.
    callback file-open(int);
    /// Stop the card's transfer, whichever way it goes.
    callback file-cancel(int);
    /// The Voice/Messages divider was let go: keep the height.
    callback messages-resized(length);
    // Wipe the local chat history/images (each user clears their own).
    callback clear-chat();
    callback emoji-picked(string);
    callback paste-rich();                // Ctrl/Cmd+V — host runs the paste chain
    callback link-clicked(string);
    callback row-open-image(int);
    callback edit-cancel();
    callback load-earlier();
    callback confirm-accept();
    callback confirm-cancel();
    /// Image viewer overlay: step -1/+1, save current, close.
    callback viewer-step(int);
    callback viewer-save();
    /// The gallery's copy button: the shown picture to the clipboard.
    callback viewer-copy();
    callback viewer-close();
    callback gif-hover(int, bool);        // row-id, entering

    // Image preview overlay
    callback preview-send();
    callback preview-cancel();

    // Screen share dialog
    callback start-share(int, int, bool); // monitor index, quality index, everyone?

    // Voice channels
    callback channel-clicked(int);        // channel id (header row tapped)
    callback channel-password-ok();       // reads State.channel-password
    callback channel-password-cancel();
    /// The Invite button: open the dialog.
    callback invite-create();
    /// The Admin chip: open the panel (spec §8).
    callback admin-open();
    /// The Messages section's shield row: open the admin channel.
    callback admin-channel-open();
    /// The dialog: mint with the picked options; copy the code; close.
    callback invite-dialog-create();
    callback invite-dialog-copy();
    callback invite-dialog-cancel();
    // 1.1 — channels from the UI (spec §5)
    callback channel-create();            // the `+`: open the dialog empty
    callback channel-dialog-save();       // reads State.channel-dialog-*
    callback channel-dialog-cancel();

    // Startup / update flow
    callback update-now();
    callback update-skip();
    callback update-cancel();
    callback update-install();

    /// The toast was clicked: hide it now.
    callback toast-dismiss();

    // Window lifecycle
    callback main-close-requested();
}
