// theme.slint — the "workbench" palette as design tokens.
//
// Same hues the FLTK build shipped (layered dark greys + cobalt accent,
// Slack-adjacent, no purple), promoted from per-widget constants to one
// global every component reads. New in the Slint skin: a radius scale
// (flat but curved) and an 8px spacing scale.
//
// | name      | hex       | role                 |
// |-----------|-----------|----------------------|
// | graphite  | #1A1D21   | ground               |
// | gunmetal  | #222529   | raised panels        |
// | fog       | #D1D2D3   | primary text         |
// | steel     | #ABADB0   | secondary text       |
// | ash       | #929598   | muted text (4.5:1 on every surface) |
// | cobalt    | #1264A3   | accent fills         |
// | sky       | #4A9AE0   | accent as text: names, links (4.5:1+) |
// | green     | #2BAC76   | positive / speaking  |
// | amber     | #ECB22E   | caution              |
// | raspberry | #E01E5A   | errors / live        |

export global Theme {
    // ── Backgrounds ────────────────────────────────────────────────
    out property <brush> bg-primary:   #1A1D21;
    out property <brush> bg-secondary: #222529;
    out property <brush> bg-tertiary:  #2B2E33;
    out property <brush> surface:      #15171A;
    out property <brush> hover:        #272A2F;
    out property <brush> subtle:       #303338;
    out property <brush> border:       #3A3D42;

    // ── Text ───────────────────────────────────────────────────────
    out property <color> text-primary:   #D1D2D3;
    out property <color> text-secondary: #ABADB0;
    // Measured, not eyeballed: 5.6:1 on graphite, 5.1:1 on gunmetal,
    // 4.5:1 on the tertiary panels — the old #808386 fell short of
    // AA on all three at the 11–12 px it is used at.
    out property <color> text-muted:     #929598;
    out property <color> mono-text:      #86AA90;
    out property <color> on-accent:      #FFFFFF;

    // ── Accents & status ───────────────────────────────────────────
    out property <color> accent:       #1264A3;   // fills: buttons, selection
    out property <color> accent-hover: #0E5082;
    // Cobalt is a fill, not a text color: 2.7:1 on graphite. This is
    // the same hue lifted until names and links read (5.6:1).
    out property <color> accent-text:  #4A9AE0;
    out property <color> success:      #2BAC76;
    out property <color> warning:      #ECB22E;
    out property <color> gold:         #ECB22E;   // honors (credits super-testers) — amber hue, celebratory role
    out property <color> danger:       #E01E5A;
    out property <color> meter:        #ABADB0;

    // ── Row tints (sidebar) ────────────────────────────────────────
    out property <brush> row-muted-tint:  #2E1C23;
    out property <brush> row-volume-tint: #1C232D;

    // ── Radii — "flat but curved" ──────────────────────────────────
    out property <length> radius-lg: 14px;  // cards, panels, popovers
    out property <length> radius-md: 10px;  // buttons, inputs, rows
    out property <length> radius-sm: 6px;   // chips, badges

    // ── Spacing scale ──────────────────────────────────────────────
    out property <length> gap-xs: 4px;
    out property <length> gap-sm: 8px;
    out property <length> gap-md: 12px;
    out property <length> gap-lg: 16px;
    out property <length> gap-xl: 24px;

    // ── Chat grid ──────────────────────────────────────────────────
    // The gutter holds a 36 px picture with gap-sm each side; header
    // lines are one text line tall.
    out property <length> chat-gutter: 52px;
    out property <length> chat-header: 20px;

    // ── Type scale ─────────────────────────────────────────────────
    // 11 px is the floor: counts, timestamps and hints sit there, body
    // one step up. (10/11 read as noise at typical desktop DPI.)
    // `scale` is the "Text size" setting; the host sets it on every
    // window's Theme (globals are per window instance). Rounded to
    // whole pixels so glyphs stay crisp.
    in-out property <float> scale: 1.0;
    out property <length> font-xs:    Math.round(11 * scale) * 1px;
    out property <length> font-sm:    Math.round(12 * scale) * 1px;
    out property <length> font-body:  Math.round(13 * scale) * 1px;
    out property <length> font-md:    Math.round(14 * scale) * 1px;
    out property <length> font-lg:    Math.round(16 * scale) * 1px;
    out property <length> font-title: Math.round(30 * scale) * 1px;
}
