// sidebar.slint — roster + voice controls + stats.
//
// Feature parity with the FLTK sidebar, restyled:
//  - rows: speaking dot, name (accent for self, grey when locally
//    muted), role badge (guest ring / organizer wrench / admin shield),
//    volume badge, remote mute/deafen icon, LIVE chip;
//  - the row's menu (right-click, left-click, or the "…" affordance)
//    is a ContextMenuArea: audio items for everyone, and the
//    moderation items only when `Session.permissions` and the rank
//    rule allow them — the server would refuse anything else, so it is
//    never advertised (spec §8);
//  - a hover tooltip with the level and role, plus the last telemetry
//    for admins (spec §8 "connection info");
//  - row tint for locally-muted / volume-adjusted users;
//  - stream-stats block while sharing (amber when degraded);
//  - status / latency / resource lines;
//  - control bar: mic, headphones, screen — icons, per the redesign —
//    plus settings and disconnect.
//
// The list virtualizes via ListView; updates are in-place row writes
// from the shell, so scroll position survives (same contract as before).

import { ListView, ScrollView } from "std-widgets.slint";
import { IconSet, IconDisplay } from "@lucide";
import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { State, Logic, UserRow, ModAction } from "globals.slint";
import { IconBtn, Btn, AvatarTile } from "widgets.slint";

component UserRowView inherits Rectangle {
    in property <UserRow> user;
    in property <int> index;

    height: user.is-channel ? 32px : 40px;
    border-radius: Theme.radius-md;
    background: user.is-channel
        ? (user.is-our-channel ? Theme.row-volume-tint
            : touch.has-hover ? Theme.hover : transparent)
        : touch.has-hover ? Theme.hover
        : user.local-muted ? Theme.row-muted-tint
        : user.volume-pct != 100 ? Theme.row-volume-tint
        : transparent;
    animate background { duration: 150ms; }

    // Any moderation entry at all? Decides the separator.
    property <bool> moderates: !user.is-channel && !user.is-us && (
        (State.perm-roles && user.role-editable)
        || State.perm-move
        || user.channel-kickable
        || (user.outranked && (State.perm-mute || State.perm-disconnect
            || State.perm-kick || State.perm-ban)));

    pure function role-name(r: int) -> string {
        return r == 1 ? Tr.role-guest
            : r == 2 ? Tr.role-member
            : r == 3 ? Tr.role-organizer
            : r == 4 ? Tr.role-admin
            : "";
    }

    // A channel header we may manage (the server's `may_manage`): our
    // own with MANAGE_OWN_CHANNELS, or any user channel with
    // MANAGE_CHANNELS. Config channels get a one-line explanation
    // instead of actions.
    property <bool> channel-manageable: user.is-channel && !user.from-config
        && ((user.owned && State.perm-manage-own) || State.perm-move);

    menu := ContextMenuArea {
        // Our own row has nothing to offer; a channel header only when
        // there is something to say about it.
        enabled: user.is-channel
            ? (root.channel-manageable || (user.from-config && (State.perm-move || State.perm-create-channels)))
            : !user.is-us;
        Menu {
            // ── Channel header ─────────────────────────────────────
            if user.is-channel && user.from-config : MenuItem {
                title: Tr.menu-channel-config-owned;
                enabled: false;
            }
            if root.channel-manageable : MenuItem {
                title: Tr.menu-channel-edit;
                activated => { Logic.channel-edit(user.channel-id); }
            }
            if root.channel-manageable : MenuItem {
                title: Tr.menu-channel-delete;
                activated => { Logic.channel-delete(user.channel-id); }
            }

            // ── Audio, for every user row ──────────────────────────
            if !user.is-channel : MenuItem {
                title: Tr.menu-volume;
                activated => { Logic.user-menu(root.index); }
            }
            if !user.is-channel : MenuItem {
                title: user.local-muted ? Tr.menu-unmute-for-me : Tr.menu-mute-for-me;
                activated => { Logic.popup-toggle-mute(root.index); }
            }
            if !user.is-channel : MenuItem {
                title: Tr.reset-audio;
                activated => { Logic.popup-reset-audio(root.index); }
            }
            if !user.is-channel && user.sharing : MenuItem {
                title: Tr.watch-stream;
                activated => { Logic.popup-watch(root.index); }
            }

            // ── Direct message (members to members) ───────────────
            if !user.is-channel && State.perm-dm && user.role != 1 : MenuSeparator { }
            if !user.is-channel && State.perm-dm && user.role != 1 : MenuItem {
                title: Tr.menu-message;
                activated => { Logic.user-dm(root.index); }
            }

            // ── Moderation, permission- and rank-gated ─────────────
            if root.moderates : MenuSeparator { }
            if State.perm-roles && user.role-editable : Menu {
                title: Tr.menu-role;
                // Roles up to our own; the one they hold is greyed.
                for r in 4 : MenuItem {
                    title: root.role-name(r + 1);
                    enabled: r + 1 <= State.our-role && user.role != r + 1;
                    activated => { Logic.user-set-role(root.index, r + 1); }
                }
            }
            if State.perm-move : Menu {
                title: Tr.menu-move-to;
                for ch in State.channel-options : MenuItem {
                    title: ch.name;
                    enabled: ch.id != user.channel-id;
                    activated => { Logic.user-move(root.index, ch.id); }
                }
            }
            if user.channel-kickable : MenuItem {
                title: Tr.menu-channel-kick;
                activated => { Logic.user-channel-kick(root.index); }
            }
            if user.outranked && State.perm-mute : Menu {
                title: Tr.menu-mute;
                MenuItem {
                    title: Tr.menu-mute-voice;
                    activated => { Logic.user-moderate(root.index, ModAction.mute-voice); }
                }
                MenuItem {
                    title: Tr.menu-mute-chat;
                    activated => { Logic.user-moderate(root.index, ModAction.mute-chat); }
                }
                MenuSeparator { }
                MenuItem {
                    title: Tr.menu-unmute-voice;
                    activated => { Logic.user-moderate(root.index, ModAction.unmute-voice); }
                }
                MenuItem {
                    title: Tr.menu-unmute-chat;
                    activated => { Logic.user-moderate(root.index, ModAction.unmute-chat); }
                }
            }
            if user.outranked && State.perm-disconnect : MenuItem {
                title: Tr.menu-disconnect;
                activated => { Logic.user-moderate(root.index, ModAction.disconnect); }
            }
            if user.outranked && State.perm-kick : MenuItem {
                title: Tr.menu-kick;
                activated => { Logic.user-moderate(root.index, ModAction.kick); }
            }
            if user.outranked && State.perm-ban : MenuItem {
                title: Tr.menu-ban;
                activated => { Logic.user-moderate(root.index, ModAction.ban); }
            }
        }

        // The whole row is the click target — a hover-gated button was
        // impossible to hit (its own TouchArea stole the hover that made
        // it visible). Channel headers join on click; user rows open
        // the menu on left click (right-click is the area's own).
        touch := TouchArea {
            mouse-cursor: (user.is-channel && !user.is-our-channel) || (!user.is-channel && !user.is-us)
                ? MouseCursor.pointer : MouseCursor.default;
            clicked => {
                if (user.is-channel) {
                    if (!user.is-our-channel) { Logic.channel-clicked(user.channel-id); }
                } else if (!user.is-us) {
                    menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
            }
            changed has-hover => {
                if (!user.is-channel) {
                    if (self.has-hover) {
                        State.card-x = root.absolute-position.x;
                        State.card-y = root.absolute-position.y;
                        State.card-anchor-h = root.height;
                        State.card-index = root.index;
                        Logic.user-hovered(root.index, true);
                    } else if (State.card-index == root.index) {
                        State.card-index = -1;
                        Logic.user-hovered(root.index, false);
                    }
                }
            }
        }

        // ── Channel header row ──────────────────────────────────────
        if user.is-channel : HorizontalLayout {
            padding-left: Theme.gap-xs;
            padding-right: Theme.gap-xs;
            spacing: Theme.gap-xs;

            Text {
                text: user.name;
                color: user.is-our-channel ? Theme.accent-text : Theme.text-secondary;
                font-size: Theme.font-body;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if user.temporary : Rectangle {
                width: 12px;
                IconDisplay {
                    icon: IconSet.Hourglass;
                    size: 12px;
                    stroke: Theme.text-muted;
                }
            }
            if user.members-only : Rectangle {
                width: 12px;
                IconDisplay {
                    icon: IconSet.Users;
                    size: 12px;
                    stroke: Theme.text-muted;
                }
            }
            if user.locked : Rectangle {
                width: 12px;
                IconDisplay {
                    icon: IconSet.Lock;
                    size: 12px;
                    stroke: Theme.text-muted;
                }
            }
            Text {
                text: user.member-label;
                color: Theme.text-muted;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
        }

        // ── User row ────────────────────────────────────────────────
        if !user.is-channel : HorizontalLayout {
            padding-left: Theme.gap-sm;   // indent members under their channel
            padding-right: Theme.gap-xs;
            spacing: Theme.gap-xs;

            // The avatar tile; its ring is the speaking indicator.
            AvatarTile {
                source: user.avatar;
                has-image: user.has-avatar;
                initial: user.initial;
                tint: user.tile-tint;
                ring: user.speaking && !user.local-muted;
                struck: user.local-muted;
            }

            // The name in the profile's color and style (spec §7.1);
            // ours keeps the accent when no color is set so it stays
            // findable, a local mute greys it.
            name := Text {
                text: user.name;
                color: user.local-muted ? Theme.text-muted
                    : user.has-name-color ? user.name-color
                    : user.is-us ? Theme.accent-text
                    : Theme.text-primary;
                font-size: Theme.font-body;
                font-weight: user.name-style == 1 || (user.is-us && user.name-style == 0) ? 600 : 400;
                font-italic: user.name-style == 2;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            // Role badge (spec §4, §8): the server's roster says who
            // is what; the name string itself is never altered.
            if user.role == 1 || user.role == 3 || user.role == 4 : Rectangle {
                width: 14px;
                IconDisplay {
                    icon: user.role == 4 ? IconSet.Shield
                        : user.role == 3 ? IconSet.Wrench
                        : IconSet.CircleDashed;
                    size: 14px;
                    stroke: user.role == 4 ? Theme.gold
                        : user.role == 3 ? Theme.text-secondary
                        : Theme.text-muted;
                }
            }

            // Volume badge for non-default remote volume.
            if !user.is-us && user.volume-pct != 100 : Rectangle {
                width: badge.preferred-width + 10px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                border-radius: 9px;
                background: Theme.bg-tertiary;
                badge := Text {
                    text: "\{user.volume-pct}%";
                    color: Theme.text-secondary;
                    font-size: Theme.font-xs;
                }
            }

            // Remote (or own) self-mute / deafen status icon.
            if user.self-deafened || user.self-muted : Rectangle {
                width: 15px;
                IconDisplay {
                    icon: user.self-deafened ? IconSet.HeadphoneOff : IconSet.MicOff;
                    size: 15px;
                    stroke: Theme.text-muted;
                }
            }

            // LIVE chip / hover "…" menu.
            if user.sharing : Rectangle {
                width: live.preferred-width + 14px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: 10px;
                background: Theme.danger;
                live := Text {
                    text: Tr.live;
                    color: Theme.on-accent;
                    font-size: Theme.font-xs;
                    font-weight: 700;
                }
            }
            // Pure affordance — clicks land on the row's own TouchArea.
            if !user.sharing && !user.is-us && touch.has-hover : Rectangle {
                width: 14px;
                IconDisplay {
                    icon: IconSet.Ellipsis;
                    size: 14px;
                    stroke: Theme.text-muted;
                }
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    background: Theme.bg-secondary;

    VerticalLayout {
        padding: Theme.gap-md;
        spacing: Theme.gap-md;

        HorizontalLayout {
            spacing: Theme.gap-sm;
            Text {
                text: State.users-count-label;
                color: Theme.text-secondary;
                font-size: Theme.font-body;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            // `+`: only when the server said we may (spec §5).
            if State.perm-create-channels : IconBtn {
                size: 28px;
                icon-size: 16px;
                icon: IconSet.Plus;
                tooltip: Tr.channel-new;
                tooltip-below: true;
                clicked => { Logic.channel-create(); }
            }
        }

        list := ListView {
            vertical-stretch: 1;
            for user[i] in State.users : UserRowView {
                user: user;
                index: i;
            }
        }

        // ── Messages (spec §6): the lower half of the sidebar ──────
        // General first, then one row per DM partner, newest first,
        // with an unread badge; the open conversation is highlighted.
        // Only when the session may DM at all, or has conversations
        // to read.
        if State.perm-dm || State.dms.length > 0 : Rectangle {
            height: 1px;
            background: Theme.border;
        }
        if State.perm-dm || State.dms.length > 0 : Text {
            text: Tr.messages-header;
            color: Theme.text-secondary;
            font-size: Theme.font-body;
            font-weight: 600;
            vertical-alignment: center;
        }
        if State.perm-dm || State.dms.length > 0 : dm-list := ScrollView {
            // A short list: the roster keeps the room.
            height: Math.min(200px, 34px + 34px * State.dms.length);
            vertical-stretch: 0;
            VerticalLayout {
            spacing: 2px;
            // General
            Rectangle {
                height: 32px;
                border-radius: Theme.radius-md;
                background: State.active-dm < 0 ? Theme.row-volume-tint
                    : general-t.has-hover ? Theme.hover : transparent;
                animate background { duration: 150ms; }
                HorizontalLayout {
                    padding-left: Theme.gap-sm;
                    padding-right: Theme.gap-xs;
                    spacing: Theme.gap-sm;
                    Rectangle {
                        width: 16px;
                        IconDisplay {
                            icon: IconSet.Hash;
                            size: 16px;
                            stroke: State.active-dm < 0 ? Theme.accent-text : Theme.text-muted;
                        }
                    }
                    Text {
                        text: Tr.dm-general;
                        color: State.active-dm < 0 ? Theme.accent-text
                            : State.general-unread > 0 ? Theme.text-primary
                            : Theme.text-secondary;
                        font-size: Theme.font-body;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if State.general-unread > 0 && State.active-dm >= 0 : Rectangle {
                        width: general-badge.preferred-width + 12px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 9px;
                        background: Theme.accent;
                        general-badge := Text {
                            text: State.general-unread;
                            color: Theme.on-accent;
                            font-size: Theme.font-xs;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
                general-t := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Logic.general-clicked(); }
                }
            }
            for dm[i] in State.dms : Rectangle {
                height: 32px;
                border-radius: Theme.radius-md;
                background: dm.active ? Theme.row-volume-tint
                    : dm-t.has-hover ? Theme.hover : transparent;
                animate background { duration: 150ms; }
                HorizontalLayout {
                    padding-left: Theme.gap-sm;
                    padding-right: Theme.gap-xs;
                    spacing: Theme.gap-sm;
                    // The picture at the `#`'s size; the ring means
                    // "online".
                    Rectangle {
                        width: 16px;
                        AvatarTile {
                            y: (parent.height - self.height) / 2;
                            source: dm.avatar;
                            has-image: dm.has-avatar;
                            initial: dm.initial;
                            tint: dm.tile-tint;
                            side: 16px;
                            corner: 4px;
                            ring: dm.online;
                            ring-color: Theme.text-muted;
                        }
                    }
                    Text {
                        text: dm.name;
                        color: dm.active ? Theme.accent-text
                            : dm.unread > 0 ? Theme.text-primary
                            : Theme.text-secondary;
                        font-size: Theme.font-body;
                        font-weight: dm.unread > 0 || dm.active ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if dm.unread > 0 : Rectangle {
                        width: badge.preferred-width + 12px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 9px;
                        background: Theme.accent;
                        badge := Text {
                            text: dm.unread;
                            color: Theme.on-accent;
                            font-size: Theme.font-xs;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
                dm-t := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Logic.dm-clicked(i); }
                }
            }
            }
        }

        // Stream stats — visible while sharing, amber when the sender
        // is shedding fps for lossy viewers.
        if State.stream-stats != "" : Rectangle {
            height: stats.preferred-height + 2 * Theme.gap-sm;
            border-radius: Theme.radius-md;
            background: Theme.bg-primary;
            stats := Text {
                x: Theme.gap-sm;
                width: parent.width - 2 * Theme.gap-sm;
                text: State.stream-stats;
                color: State.stream-degraded ? Theme.warning : Theme.text-muted;
                font-size: Theme.font-xs;
                wrap: word-wrap;
            }
        }

        // Status block
        VerticalLayout {
            spacing: 2px;
            Text {
                text: State.status-text;
                color: State.status-color;
                font-size: Theme.font-sm;
                font-weight: 600;
            }
            Text {
                text: State.latency-line;
                color: Theme.text-muted;
                font-size: Theme.font-xs;
                overflow: elide;
            }
            Text {
                text: State.resource-line;
                color: Theme.text-muted;
                font-size: Theme.font-xs;
                overflow: elide;
            }
            if State.upload-line != "" : Text {
                text: State.upload-line;
                color: Theme.accent-text;
                font-size: Theme.font-xs;
            }
        }

        // ── Control bar: mic / headphones / screen ─────────────────
        Rectangle {
            height: 52px;
            border-radius: Theme.radius-md;
            background: Theme.bg-primary;
            HorizontalLayout {
                padding: 6px;
                spacing: Theme.gap-xs;
                alignment: space-around;
                // In push-to-talk mode the mic lights up while the key
                // is held; a click still toggles the hard mute.
                IconBtn {
                    icon: State.muted ? IconSet.MicOff : IconSet.Mic;
                    active: State.muted || (State.ptt-mode && State.ptt-held);
                    active-danger: State.muted;
                    tooltip: State.muted ? Tr.unmute
                        : State.ptt-mode ? State.ptt-tooltip : Tr.mute;
                    clicked => { Logic.toggle-mute(); }
                }
                IconBtn {
                    icon: State.deafened ? IconSet.HeadphoneOff : IconSet.Headphones;
                    active: State.deafened;
                    active-danger: true;
                    tooltip: State.deafened ? Tr.undeafen : Tr.deafen;
                    clicked => { Logic.toggle-deafen(); }
                }
                IconBtn {
                    icon: State.sharing ? IconSet.MonitorOff : IconSet.Monitor;
                    active: State.sharing;
                    active-danger: true;
                    tooltip: State.sharing ? Tr.stop-sharing : Tr.share-screen;
                    clicked => { Logic.toggle-share(); }
                }
                IconBtn {
                    icon: IconSet.Settings;
                    tooltip: Tr.settings;
                    clicked => { Logic.open-settings(); }
                }
            }
        }

        Btn {
            text: Tr.disconnect;
            accent: true;
            clicked => { Logic.disconnect(); }
        }
    }

}
