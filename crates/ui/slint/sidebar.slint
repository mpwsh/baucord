// sidebar.slint — roster + voice controls + stats.
//
// Feature parity with the FLTK sidebar, restyled:
//  - rows: speaking dot, name (accent for self, grey when locally
//    muted), role badge (guest ring / organizer wrench / admin shield),
//    volume badge, remote mute/deafen icon, LIVE chip;
//  - the row's menu (right-click, left-click, or the "…" affordance)
//    is the window's own overlay (main.slint), filled by the host from
//    app-core's `menu`: audio items for everyone, and the moderation
//    items only when `Session.permissions` and the rank rule allow
//    them — the server would refuse anything else, so it is never
//    advertised (spec §8). Not a ContextMenuArea: that one is native
//    on macOS/Windows, and a row's TouchArea swallowed its right-click;
//  - a hover tooltip with the level and role, plus the last telemetry
//    for admins (spec §8 "connection info");
//  - row tint for locally-muted / volume-adjusted users;
//  - stream-stats block while sharing (amber when degraded);
//  - status / latency / resource lines;
//  - control bar: mic, headphones, screen — icons, per the redesign —
//    plus settings and disconnect.
//
// The list virtualizes via ListView; updates are in-place row writes
// from the shell, so scroll position survives (same contract as before).

import { ListView, ScrollView } from "std-widgets.slint";
import { Icon, IconSet, IconDisplay } from "@lucide";
import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { State, Logic, UserRow } from "globals.slint";
import { IconBtn, Btn, AvatarTile, RoleGlyph, Tip, LongPress } from "widgets.slint";

component UserRowView inherits Rectangle {
    in property <UserRow> user;
    in property <int> index;
    /// A dragged user hovers this channel row and may be dropped.
    in property <bool> drop-target;

    height: user.is-channel ? 32px : 40px;
    border-radius: Theme.radius-md;
    background: user.is-channel
        ? (drop-target ? Theme.accent.with-alpha(0.35)
            : user.is-our-channel ? Theme.row-volume-tint
            : touch.has-hover ? Theme.hover : transparent)
        : touch.has-hover ? Theme.hover
        : user.local-muted ? Theme.row-muted-tint
        : user.volume-pct != 100 ? Theme.row-volume-tint
        : transparent;
    animate background { duration: 150ms; }

    // The row's menu (app-core `menu::user_menu` / `channel_menu`):
    // the host builds the entries from what the session may do and
    // opens the window overlay at the click. Right-click on any row;
    // user rows also open it on a left click, since the whole row is
    // the target (a hover-gated button was impossible to hit).
    function open-menu() {
        Logic.user-context(root.index,
            touch.absolute-position.x + touch.mouse-x,
            touch.absolute-position.y + touch.mouse-y);
    }

    // On touch a held finger is the right-click: a channel's menu (no
    // other way to reach it there). A person's card is already up by
    // then — the hover's dwell — and stays the answer: the release
    // opens nothing.
    lp := LongPress {
        pressing: touch.has-hover;
        long-pressed => {
            if (user.is-channel) {
                root.open-menu();
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: (user.is-channel && !user.is-our-channel) || (!user.is-channel && !user.is-us)
            ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.open-menu();
            }
        }
        clicked => {
            // The release of a long press is not a tap.
            if (lp.fired) {
                return;
            }
            if (user.is-channel) {
                if (!user.is-our-channel) { Logic.channel-clicked(user.channel-id); }
            } else if (!user.is-us) {
                root.open-menu();
            }
        }
        changed has-hover => {
            if (!user.is-channel) {
                if (self.has-hover) {
                    State.card-x = root.absolute-position.x;
                    State.card-y = root.absolute-position.y;
                    State.card-anchor-h = root.height;
                    State.card-index = root.index;
                    Logic.user-hovered(root.index, true);
                } else if (State.card-index == root.index) {
                    State.card-index = -1;
                    Logic.user-hovered(root.index, false);
                }
            }
        }
    }

    // ── Channel header row ──────────────────────────────────────
    // The ListView's scrollbar is drawn over the right edge; the
    // badges and counts sit clear of it.
    if user.is-channel : HorizontalLayout {
        padding-left: Theme.gap-xs;
        padding-right: 20px;
        spacing: Theme.gap-xs;

        Text {
            text: user.name;
            color: user.is-our-channel ? Theme.accent-text : Theme.text-secondary;
            font-size: Theme.font-body;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if user.temporary : Rectangle {
            width: 12px;
            IconDisplay {
                icon: IconSet.Hourglass;
                size: 12px;
                stroke: Theme.text-muted;
            }
        }
        if user.members-only : Rectangle {
            width: 12px;
            IconDisplay {
                icon: IconSet.Users;
                size: 12px;
                stroke: Theme.text-muted;
            }
        }
        if user.locked : Rectangle {
            width: 12px;
            IconDisplay {
                icon: IconSet.Lock;
                size: 12px;
                stroke: Theme.text-muted;
            }
        }
        Text {
            text: user.member-label;
            color: Theme.text-muted;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
    }

    // ── User row ────────────────────────────────────────────────
    if !user.is-channel : HorizontalLayout {
        padding-left: Theme.gap-sm;   // indent members under their channel
        padding-right: 20px;
        spacing: Theme.gap-xs;

        // The avatar tile; its ring is the speaking indicator. A
        // fixed-height child sits at the top of a HorizontalLayout,
        // so it is centered by hand in a wrapper that takes the row.
        Rectangle {
            width: tile.width;
            tile := AvatarTile {
                y: (parent.height - self.height) / 2;
                source: user.avatar;
                has-image: user.has-avatar;
                initial: user.initial;
                tint: user.tile-tint;
                ring: user.speaking && !user.local-muted;
                struck: user.local-muted;
            }
        }

        // The name in the profile's color and style (spec §7.1);
        // ours keeps the accent when no color is set so it stays
        // findable, a local mute greys it.
        name := Text {
            text: user.name;
            color: user.local-muted ? Theme.text-muted
                : user.has-name-color ? user.name-color
                : user.is-us ? Theme.accent-text
                : Theme.text-primary;
            font-size: Theme.font-body;
            font-weight: user.name-style == 1 || (user.is-us && user.name-style == 0) ? 600 : 400;
            font-italic: user.name-style == 2;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // Role badge (spec §4, §8): the server's roster says who
        // is what; the name string itself is never altered. A custom
        // role's own glyph and color come first.
        if user.role-icon != "" : RoleGlyph {
            name: user.role-icon;
            size: 14px;
            stroke: user.has-role-color ? user.role-color : Theme.text-secondary;
        }
        if user.role-icon == "" && (user.role == 1 || user.role == 3 || user.role == 4) : Rectangle {
            width: 14px;
            IconDisplay {
                icon: user.role == 4 ? IconSet.Shield
                    : user.role == 3 ? IconSet.Wrench
                    : IconSet.CircleDashed;
                size: 14px;
                stroke: user.role == 4 ? Theme.admin
                    : user.role == 3 ? Theme.text-secondary
                    : Theme.text-muted;
            }
        }

        // Volume badge for non-default remote volume.
        if !user.is-us && user.volume-pct != 100 : Rectangle {
            width: badge.preferred-width + 10px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            background: Theme.bg-tertiary;
            badge := Text {
                text: "\{user.volume-pct}%";
                color: Theme.text-secondary;
                font-size: Theme.font-xs;
            }
        }

        // Remote (or own) self-mute / deafen status icon.
        if user.self-deafened || user.self-muted : Rectangle {
            width: 15px;
            IconDisplay {
                icon: user.self-deafened ? IconSet.HeadphoneOff : IconSet.MicOff;
                size: 15px;
                stroke: Theme.text-muted;
            }
        }

        // LIVE chip / hover "…" menu. The chip is a button: one click
        // opens the viewer (declared inside the layout, so it sits in
        // front of the row's own TouchArea and takes the click first).
        if user.sharing : Rectangle {
            width: live.preferred-width + 14px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            // Our own chip is a badge, not a button: no hover, no click.
            background: live-t.has-hover && !user.is-us ? Theme.danger.brighter(0.15) : Theme.danger;
            animate background { duration: 150ms; }
            live := Text {
                text: Tr.live;
                color: Theme.on-accent;
                font-size: Theme.font-xs;
                font-weight: 700;
            }
            live-t := TouchArea {
                enabled: !user.is-us;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    if (!lp.fired) {
                        Logic.watch-user(root.index);
                    }
                }
            }
        }
        // Pure affordance — clicks land on the row's own TouchArea.
        if !user.sharing && !user.is-us && touch.has-hover : Rectangle {
            width: 14px;
            IconDisplay {
                icon: IconSet.Ellipsis;
                size: 14px;
                stroke: Theme.text-muted;
            }
        }
    }
}

/// An action chip beside the server's name: an icon and its word, or
/// — when the row has no room for the words — the icon alone, with the
/// word as a tooltip under a mouse.
component ChipButton inherits Rectangle {
    in property <string> text;
    in property <Icon> icon;
    in property <bool> show-text: true;
    in property <brush> tint: Theme.text-primary;
    callback clicked;
    width: root.show-text ? lbl.preferred-width + 2 * Theme.gap-sm + 14px + Theme.gap-xs : 28px;
    height: 26px;
    border-radius: Theme.radius-sm;
    background: chip-t.has-hover ? Theme.hover : Theme.bg-tertiary;
    animate background { duration: 150ms; }
    HorizontalLayout {
        padding-left: root.show-text ? Theme.gap-sm : 7px;
        padding-right: root.show-text ? Theme.gap-sm : 7px;
        spacing: Theme.gap-xs;
        Rectangle {
            width: 14px;
            IconDisplay {
                icon: root.icon;
                size: 14px;
                stroke: root.tint;
            }
        }
        lbl := Text {
            visible: root.show-text;
            text: root.text;
            color: root.tint;
            font-size: Theme.font-sm;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    // The word as a tip, through the window's tip layer, when the chip
    // shows the icon alone.
    function post-tip() {
        if (chip-t.has-hover && !root.show-text) {
            Tip.show(root.text, self.absolute-position.x, self.absolute-position.y,
                self.width, self.height, true);
        } else {
            Tip.hide(root.text);
        }
    }
    changed show-text => { root.post-tip(); }
    chip-t := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Tip.hide(root.text);
            root.clicked();
        }
        changed has-hover => { root.post-tip(); }
    }
}

/// "Connected" behind a dot in the latency's color: the dot is drawn,
/// not a "●" (Android's system font has none, and Slint shows a gap or
/// a square there).
component StatusLine inherits HorizontalLayout {
    spacing: Theme.gap-sm;
    Rectangle {
        width: 8px;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: State.status-color;
        }
    }
    Text {
        text: State.status-text;
        color: State.status-color;
        font-size: Theme.font-sm;
        font-weight: 600;
        vertical-alignment: center;
    }
}

/// A transfer rate behind its drawn arrow.
component Rate inherits HorizontalLayout {
    in property <Icon> arrow;
    in property <string> value;
    horizontal-stretch: 0;
    Rectangle {
        width: 10px;
        IconDisplay {
            icon: root.arrow;
            size: 10px;
            stroke: Theme.text-muted;
        }
    }
    Text {
        text: root.value;
        color: Theme.text-muted;
        font-size: Theme.font-xs;
        vertical-alignment: center;
    }
}

/// "Audio: 42ms | Net: 38ms | ↑0.1 ↓0.3 Mb", the arrows drawn (no "↑",
/// "↓" in Android's system font). The latencies elide before the rates.
component LatencyLine inherits HorizontalLayout {
    spacing: Theme.gap-xs;
    Text {
        text: State.latency-line + " |";
        color: Theme.text-muted;
        font-size: Theme.font-xs;
        vertical-alignment: center;
        overflow: elide;
        // Its own width at most (the rates follow it, not the far
        // edge); less when the line is short, and then it elides.
        horizontal-stretch: 1;
        min-width: 0px;
        max-width: self.preferred-width;
    }
    Rate { arrow: IconSet.ArrowUp; value: State.latency-up; }
    Rate { arrow: IconSet.ArrowDown; value: State.latency-down + " " + Tr.latency-unit; }
    Rectangle { horizontal-stretch: 1; }
}

export component Sidebar inherits Rectangle {
    /// The Messages height the divider is being dragged to (-1 = no drag).
    property <length> divider-preview: -1px;
    /// Too short for the full stack — a phone on its side (~370 px
    /// tall), a small desktop window. Everything stays on screen by
    /// giving up room, not controls: tighter gaps, Messages capped to a
    /// share of the height, the status on one line, Disconnect as a
    /// button in the control bar (ANDROID-SPEC.md D42, IOS-SPEC.md
    /// D35). The full stack needs about 600 px.
    property <bool> compact: root.height < 600px;
    background: Theme.bg-secondary;

    // The header's chips keep their words while the server's name
    // keeps ~96 px beside them; on a narrower sidebar (or a longer
    // language) they become icons. Measured off-layout, per language.
    invite-words := Text { visible: false; text: Tr.invite-button; font-size: Theme.font-sm; font-weight: 500; }
    channel-words := Text { visible: false; text: Tr.channel-new; font-size: Theme.font-sm; font-weight: 500; }
    admin-words := Text { visible: false; text: Tr.admin-button; font-size: Theme.font-sm; font-weight: 500; }
    property <length> chip-frame: 2 * Theme.gap-sm + 14px + Theme.gap-xs + Theme.gap-sm;
    property <length> chips-with-words:
        (State.perm-create-invites ? invite-words.preferred-width + root.chip-frame : 0px)
        + (State.perm-create-channels ? channel-words.preferred-width + root.chip-frame : 0px)
        + (State.perm-panel ? admin-words.preferred-width + root.chip-frame : 0px);
    property <bool> chip-words:
        root.width - 2 * (root.compact ? Theme.gap-sm : Theme.gap-md) - root.chips-with-words >= 96px;

    VerticalLayout {
        padding: root.compact ? Theme.gap-sm : Theme.gap-md;
        spacing: root.compact ? Theme.gap-sm : Theme.gap-md;

        // ── The server, and what this session may add to it ───────
        // One row: its name (the title — the greeting in chat no longer
        // repeats it), then Invite users, New channel and Admin, each
        // only for whoever the server lets (spec §3.1, §5, §8). They
        // used to take a row of their own under the name.
        HorizontalLayout {
            spacing: Theme.gap-sm;
            Text {
                text: State.server-name != "" ? State.server-name : Tr.voice-header;
                color: Theme.text-secondary;
                font-size: Theme.font-body;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            // Invite: a code with the defaults; it lands in chat and
            // on the clipboard.
            if State.perm-create-invites : ChipButton {
                icon: IconSet.UserPlus;
                text: Tr.invite-button;
                show-text: root.chip-words;
                clicked => { Logic.invite-create(); }
            }
            if State.perm-create-channels : ChipButton {
                icon: IconSet.Plus;
                text: Tr.channel-new;
                show-text: root.chip-words;
                clicked => { Logic.channel-create(); }
            }
            // Admin: the panel (spec §8), for whoever holds `panel`.
            if State.perm-panel : ChipButton {
                icon: IconSet.Shield;
                text: Tr.admin-button;
                tint: Theme.admin;
                show-text: root.chip-words;
                clicked => { Logic.admin-open(); }
            }
        }

        // The lobby (spec §12, 1.1.5): connected, invisible, silent,
        // until a channel is picked. The row itself is hidden; this
        // line is what the user sees instead.
        if State.in-lobby : Rectangle {
            height: banner.preferred-height + 2 * Theme.gap-sm;
            border-radius: Theme.radius-md;
            background: Theme.bg-tertiary;
            banner := Text {
                x: Theme.gap-md;
                y: Theme.gap-sm;
                width: parent.width - 2 * Theme.gap-md;
                text: Tr.lobby-banner;
                color: Theme.text-muted;
                font-size: Theme.font-sm;
                wrap: word-wrap;
            }
        }

        list := ListView {
            vertical-stretch: 1;
            // Fluent's ScrollView does not pan on a drag; a finger needs
            // it to (ANDROID-SPEC.md D27).
            mouse-drag-pan-enabled: State.touch-host;
            // Each row sits inside a DragArea (users are sources) with
            // a DropArea in front (channels are targets). The DragArea
            // must be the row's *parent*: it watches the press through
            // its children and only takes over past the drag
            // threshold, so clicks still reach the row's TouchArea. A
            // DropArea ignores ordinary mouse events, so it can sit in
            // front without stealing clicks.
            for user[i] in State.users : DragArea {
                height: row.height;
                enabled: State.perm-move && !user.is-channel;
                allow-move: true;
                data: Logic.user-drag-data(user.client-id-lo, user.client-id-hi);
                row := UserRowView {
                    user: user;
                    index: i;
                    drop-target: drop.has-drag;
                }
                drop := DropArea {
                    enabled: State.perm-move && user.is-channel;
                    can-drop(e) => {
                        Logic.can-drop-user(e.data, i) ? DragAction.move : DragAction.none
                    }
                    dropped(e) => {
                        Logic.drop-user(e.data, i);
                        e.proposed-action
                    }
                }
            }
        }

        // ── Messages (spec §6): the lower half of the sidebar ──────
        // General first, then one row per DM partner, newest first,
        // with an unread badge; the open conversation is highlighted.
        // Only when the session may DM at all, or has conversations
        // to read. The header folds the list away (a setting) so the
        // voice channels get the room; while folded, the unread total
        // moves up onto the header.
        // The divider, and the grip on it: drag to give Messages more
        // or less of the sidebar (the section's own height; the voice
        // list takes the rest).
        if State.perm-dm || State.dms.length > 0 : Rectangle {
            height: 1px;
            background: Theme.border;
            divider-grip := TouchArea {
                y: -4px;
                height: 9px;
                // Compact caps the height (below): no dragging there.
                enabled: !State.messages-collapsed && !root.compact;
                mouse-cursor: MouseCursor.row-resize;
                // Dragging the divider up grows Messages. Only a line
                // moves during the drag; the height lands on release
                // (re-laying out both lists per move flickered).
                pure function target() -> length {
                    return Math.clamp(State.messages-height - (self.mouse-y - self.pressed-y),
                        100px, 480px);
                }
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        root.divider-preview = State.messages-height;
                    } else if (ev.kind == PointerEventKind.up && root.divider-preview >= 0px) {
                        State.messages-height = self.target();
                        root.divider-preview = -1px;
                        Logic.messages-resized(State.messages-height);
                    } else if (ev.kind == PointerEventKind.cancel) {
                        root.divider-preview = -1px;
                    }
                }
                moved => { if (self.pressed) { root.divider-preview = self.target(); } }
            }
            // Where the divider will land: offset by how much the
            // height changes (up for taller).
            if root.divider-preview >= 0px : Rectangle {
                y: -(root.divider-preview - State.messages-height) - 1px;
                width: 100%;
                height: 2px;
                background: Theme.accent-text;
            }
        }
        if State.perm-dm || State.dms.length > 0 : fold := Rectangle {
            property <int> hidden-unread: State.dm-unread-total
                + (State.active-dm >= 0 ? State.general-unread : 0);
            height: 28px;
            border-radius: Theme.radius-sm;
            background: fold-t.has-hover ? Theme.hover : transparent;
            animate background { duration: 150ms; }
            fold-t := TouchArea {
                mouse-cursor: pointer;
                clicked => { Logic.messages-toggle(); }
            }
            HorizontalLayout {
                padding-left: Theme.gap-xs;
                padding-right: 2px;
                spacing: Theme.gap-sm;
                Text {
                    text: Tr.messages-header;
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if State.messages-collapsed && fold.hidden-unread > 0 : Rectangle {
                    width: fold-badge.preferred-width + 12px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 9px;
                    background: Theme.accent;
                    fold-badge := Text {
                        text: fold.hidden-unread;
                        color: Theme.on-accent;
                        font-size: Theme.font-xs;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
                Rectangle {
                    width: 24px;
                    IconBtn {
                        y: (parent.height - self.height) / 2;
                        size: 24px;
                        icon-size: 16px;
                        icon: State.messages-collapsed ? IconSet.ChevronUp : IconSet.ChevronDown;
                        tooltip: State.messages-collapsed ? Tr.messages-expand : Tr.messages-collapse;
                        clicked => { Logic.messages-toggle(); }
                    }
                }
            }
        }
        if (State.perm-dm || State.dms.length > 0) && !State.messages-collapsed : dm-list := ScrollView {
            // A short list: the roster keeps the room. Compact: at
            // most 30 % of the sidebar (about three rows on a phone on
            // its side) and no taller than its rows (General and each
            // DM: 32 px + 2 px apart), so the voice list and the
            // controls keep theirs.
            height: root.compact
                ? Math.min(State.messages-height, Math.max(64px, root.height * 0.3),
                    (State.dms.length + 1) * 34px)
                : State.messages-height;
            vertical-stretch: 0;
            mouse-drag-pan-enabled: State.touch-host;   // D27
            VerticalLayout {
            spacing: 2px;
            // General
            Rectangle {
                height: 32px;
                border-radius: Theme.radius-md;
                background: State.active-dm < 0 ? Theme.row-volume-tint
                    : general-t.has-hover ? Theme.hover : transparent;
                animate background { duration: 150ms; }
                HorizontalLayout {
                    padding-left: Theme.gap-sm;
                    padding-right: 16px;
                    spacing: Theme.gap-sm;
                    Rectangle {
                        width: 16px;
                        IconDisplay {
                            icon: IconSet.Hash;
                            size: 16px;
                            stroke: State.active-dm < 0 ? Theme.accent-text : Theme.text-muted;
                        }
                    }
                    Text {
                        text: Tr.dm-general;
                        color: State.active-dm < 0 ? Theme.accent-text
                            : State.general-unread > 0 ? Theme.text-primary
                            : Theme.text-secondary;
                        font-size: Theme.font-body;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if State.general-unread > 0 && State.active-dm >= 0 : Rectangle {
                        width: general-badge.preferred-width + 12px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 9px;
                        background: Theme.accent;
                        general-badge := Text {
                            text: State.general-unread;
                            color: Theme.on-accent;
                            font-size: Theme.font-xs;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
                general-t := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Logic.general-clicked();
                        // The narrow layout turns the page to the chat.
                        State.narrow-chat-open = true;
                    }
                }
            }
            for dm[i] in State.dms : dm-row := Rectangle {
                height: 32px;
                border-radius: Theme.radius-md;
                background: dm.active ? Theme.row-volume-tint
                    : dm-t.has-hover ? Theme.hover : transparent;
                animate background { duration: 150ms; }
                // The rightmost 28 px of the row are the ✕: one
                // TouchArea decides by position, so the hover that
                // reveals the button never ends under it and the
                // click reaches the right handler (a button on top
                // of the row's area got neither).
                property <bool> on-close: dm-t.has-hover && dm-t.mouse-x > dm-t.width - 28px - 16px;
                dm-t := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (self.mouse-x > self.width - 28px - 16px) {
                            Logic.dm-closed(i);
                        } else {
                            Logic.dm-clicked(i);
                            State.narrow-chat-open = true;
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: Theme.gap-sm;
                    // Clear of the ScrollView's scrollbar (14 px at
                    // the right edge, over the content).
                    padding-right: 16px;
                    spacing: Theme.gap-sm;
                    // The picture at the `#`'s size; the ring means
                    // "online".
                    Rectangle {
                        width: 16px;
                        if !dm.admin : AvatarTile {
                            y: (parent.height - self.height) / 2;
                            source: dm.avatar;
                            has-image: dm.has-avatar;
                            initial: dm.initial;
                            tint: dm.tile-tint;
                            side: 16px;
                            corner: 4px;
                            // No ring here: rings are for speaking in
                            // voice rows, not for a conversation.
                            ring: false;
                            ring-room: false;
                        }
                        // Admin logs: a channel like General, so a `#`.
                        if dm.admin : IconDisplay {
                            icon: IconSet.Hash;
                            size: 16px;
                            stroke: dm.active ? Theme.accent-text : Theme.text-muted;
                        }
                    }
                    Text {
                        text: dm.name;
                        color: dm.active ? Theme.accent-text
                            : dm.unread > 0 ? Theme.text-primary
                            : Theme.text-secondary;
                        font-size: Theme.font-body;
                        font-weight: dm.unread > 0 || dm.active ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if dm.unread > 0 : Rectangle {
                        width: badge.preferred-width + 12px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 9px;
                        background: Theme.accent;
                        badge := Text {
                            text: dm.unread;
                            color: Theme.on-accent;
                            font-size: Theme.font-xs;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                    // Close: hides the conversation from the list; the
                    // messages stay on the server and it comes back on
                    // the next message. General cannot be closed. Pure
                    // affordance: the row's TouchArea handles the click.
                    // A touch screen has no hover to reveal it, and the
                    // zone answers taps either way, so there it always
                    // shows.
                    if dm-t.has-hover || State.touch-host : Rectangle {
                        width: 20px;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 20px;
                            height: 20px;
                            border-radius: Theme.radius-sm;
                            background: dm-row.on-close ? Theme.subtle : transparent;
                            animate background { duration: 100ms; }
                            IconDisplay {
                                icon: IconSet.X;
                                size: 12px;
                                stroke: Theme.text-secondary;
                            }
                        }
                    }
                }
            }
            }
        }

        // Stream stats — visible while sharing, amber when the sender
        // is shedding fps for lossy viewers.
        if State.stream-stats != "" : Rectangle {
            height: stats.preferred-height + 2 * Theme.gap-sm;
            border-radius: Theme.radius-md;
            background: Theme.bg-primary;
            stats := Text {
                x: Theme.gap-sm;
                width: parent.width - 2 * Theme.gap-sm;
                text: State.stream-stats;
                color: State.stream-degraded ? Theme.warning : Theme.text-muted;
                font-size: Theme.font-xs;
                wrap: word-wrap;
            }
        }

        // Status block. Compact: the status and the latency on one
        // line (the resource line is for the desktop's curious).
        if root.compact : HorizontalLayout {
            spacing: Theme.gap-sm;
            StatusLine { horizontal-stretch: 0; }
            LatencyLine { horizontal-stretch: 1; }
        }
        if !root.compact : VerticalLayout {
            spacing: 2px;
            StatusLine { }
            LatencyLine { }
            Text {
                text: State.resource-line;
                color: Theme.text-muted;
                font-size: Theme.font-xs;
                overflow: elide;
            }
        }

        // ── Control bar: mic / headphones / screen ─────────────────
        Rectangle {
            height: root.compact ? 44px : 52px;
            border-radius: Theme.radius-md;
            background: Theme.bg-primary;
            HorizontalLayout {
                padding: root.compact ? 2px : 6px;
                spacing: Theme.gap-xs;
                alignment: space-around;
                // In push-to-talk mode the mic lights up while the key
                // is held; a click still toggles the hard mute.
                IconBtn {
                    icon: State.muted ? IconSet.MicOff : IconSet.Mic;
                    active: State.muted || (State.ptt-mode && State.ptt-held);
                    active-danger: State.muted;
                    // In the lobby the mic goes nowhere: greyed, and
                    // the tooltip says why (the toggle still sets the
                    // preference for the room to come).
                    idle-color: State.in-lobby ? Theme.text-muted : Theme.text-secondary;
                    tooltip: State.in-lobby ? Tr.lobby-mic-hint
                        : State.muted ? Tr.unmute
                        : State.ptt-mode ? State.ptt-tooltip : Tr.mute;
                    clicked => { Logic.toggle-mute(); }
                }
                IconBtn {
                    icon: State.deafened ? IconSet.HeadphoneOff : IconSet.Headphones;
                    active: State.deafened;
                    active-danger: true;
                    tooltip: State.deafened ? Tr.undeafen : Tr.deafen;
                    clicked => { Logic.toggle-deafen(); }
                }
                // A phone cannot share its screen (ANDROID-SPEC.md §9.4):
                // no button that could only fail.
                if !State.touch-host : IconBtn {
                    icon: State.sharing ? IconSet.MonitorOff : IconSet.Monitor;
                    active: State.sharing;
                    active-danger: true;
                    tooltip: State.sharing ? Tr.stop-sharing : Tr.share-screen;
                    clicked => { Logic.toggle-share(); }
                }
                IconBtn {
                    icon: IconSet.Settings;
                    tooltip: Tr.settings;
                    clicked => { Logic.open-settings(); }
                }
                // Compact: Disconnect joins the bar — a red hang-up,
                // not filled, so it does not read as a toggle that is
                // on (muted and deafened are filled red).
                if root.compact : IconBtn {
                    icon: IconSet.PhoneOff;
                    idle-color: Theme.danger;
                    tooltip: Tr.disconnect;
                    clicked => { Logic.disconnect(); }
                }
            }
        }

        if !root.compact : Btn {
            text: Tr.disconnect;
            accent: true;
            clicked => { Logic.disconnect(); }
        }
    }

}
