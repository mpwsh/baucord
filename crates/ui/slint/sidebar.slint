// sidebar.slint — roster + voice controls + stats.
//
// Feature parity with the FLTK sidebar, restyled:
//  - rows: speaking dot, name (accent for self, grey when locally
//    muted), volume badge, remote mute/deafen icon, LIVE chip, and a
//    hover "…" that opens the per-user popover (also right-click);
//  - row tint for locally-muted / volume-adjusted users;
//  - stream-stats block while sharing (amber when degraded);
//  - status / latency / resource lines;
//  - control bar: mic, headphones, screen — icons, per the redesign —
//    plus settings and disconnect.
//
// The list virtualizes via ListView; updates are in-place row writes
// from the shell, so scroll position survives (same contract as before).

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { State, Logic, UserRow } from "globals.slint";
import { IconBtn, Btn, Sep } from "widgets.slint";

component UserRowView inherits Rectangle {
    in property <UserRow> user;
    in property <int> index;

    height: user.is-channel ? 32px : 40px;
    border-radius: Theme.radius-md;
    background: user.is-channel
        ? (user.is-our-channel ? Theme.row-volume-tint
            : touch.has-hover ? Theme.hover : transparent)
        : touch.has-hover ? Theme.hover
        : user.local-muted ? Theme.row-muted-tint
        : user.volume-pct != 100 ? Theme.row-volume-tint
        : transparent;
    animate background { duration: 150ms; }

    // The whole row is the click target — a hover-gated button was
    // impossible to hit (its own TouchArea stole the hover that made
    // it visible). Channel headers join on click; user rows open the
    // per-user menu on left or right click.
    touch := TouchArea {
        mouse-cursor: (user.is-channel && !user.is-our-channel) || (!user.is-channel && !user.is-us)
            ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (user.is-channel) {
                if (!user.is-our-channel) { Logic.channel-clicked(user.channel-id); }
            } else if (!user.is-us) {
                Logic.user-menu(root.index);
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right
                && !user.is-channel && !user.is-us) {
                Logic.user-menu(root.index);
            }
        }
    }

    // ── Channel header row ──────────────────────────────────────────
    if user.is-channel : HorizontalLayout {
        padding-left: Theme.gap-xs;
        padding-right: Theme.gap-xs;
        spacing: Theme.gap-xs;

        Text {
            text: user.name;
            color: user.is-our-channel ? Theme.accent : Theme.text-secondary;
            font-size: Theme.font-body;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if user.locked : Image {
            width: 12px;
            source: @image-url("icons/lock.svg");
            colorize: Theme.text-muted;
        }
        Text {
            text: user.member-label;
            color: Theme.text-muted;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
    }

    // ── User row ────────────────────────────────────────────────────
    if !user.is-channel : HorizontalLayout {
        padding-left: Theme.gap-md;   // indent members under their channel
        padding-right: Theme.gap-xs;
        spacing: Theme.gap-sm;

        // Speaking indicator: filled green dot while speaking, ring
        // otherwise, crossed grey when locally muted.
        Rectangle {
            width: 14px;
            dot := Rectangle {
                width: 10px; height: 10px;
                border-radius: 5px;
                background: user.speaking && !user.local-muted ? Theme.success : transparent;
                border-width: user.speaking && !user.local-muted ? 0px : 2px;
                border-color: Theme.text-muted;
                animate background { duration: 100ms; }
            }
            if user.local-muted : Rectangle {
                width: 14px; height: 2px;
                background: Theme.text-muted;
                // diagonal strike
                transform-rotation: -45deg;
            }
        }

        name := Text {
            text: user.name;
            color: user.is-us ? Theme.accent
                : user.local-muted ? Theme.text-muted
                : Theme.text-primary;
            font-size: Theme.font-body;
            font-weight: user.is-us ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // Volume badge for non-default remote volume.
        if !user.is-us && user.volume-pct != 100 : Rectangle {
            width: badge.preferred-width + 10px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            background: Theme.bg-tertiary;
            badge := Text {
                text: "\{user.volume-pct}%";
                color: Theme.text-secondary;
                font-size: Theme.font-xs;
            }
        }

        // Remote (or own) self-mute / deafen status icon.
        if user.self-deafened || user.self-muted : Image {
            width: 15px;
            source: user.self-deafened
                ? @image-url("icons/headphones-off.svg")
                : @image-url("icons/mic-off.svg");
            colorize: Theme.text-muted;
        }

        // LIVE chip / hover "…" menu.
        if user.sharing : Rectangle {
            width: live.preferred-width + 14px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            background: Theme.danger;
            live := Text {
                text: Tr.live;
                color: Theme.on-accent;
                font-size: Theme.font-xs;
                font-weight: 700;
            }
            lt := TouchArea {
                mouse-cursor: pointer;
                clicked => { if (!user.is-us) { Logic.user-menu(root.index); } }
            }
        }
        // Pure affordance — clicks land on the row's own TouchArea.
        if !user.sharing && !user.is-us && touch.has-hover : Image {
            width: 14px;
            source: @image-url("icons/dots.svg");
            colorize: Theme.text-muted;
        }
    }
}

export component Sidebar inherits Rectangle {
    background: Theme.bg-secondary;

    VerticalLayout {
        padding: Theme.gap-md;
        spacing: Theme.gap-md;

        Text {
            text: State.users-count-label;
            color: Theme.text-secondary;
            font-size: Theme.font-body;
            font-weight: 600;
        }

        list := ListView {
            vertical-stretch: 1;
            for user[i] in State.users : UserRowView {
                user: user;
                index: i;
            }
        }

        // Stream stats — visible while sharing, amber when the sender
        // is shedding fps for lossy viewers.
        if State.stream-stats != "" : Rectangle {
            height: stats.preferred-height + 2 * Theme.gap-sm;
            border-radius: Theme.radius-md;
            background: Theme.bg-primary;
            stats := Text {
                x: Theme.gap-sm;
                width: parent.width - 2 * Theme.gap-sm;
                text: State.stream-stats;
                color: State.stream-degraded ? Theme.warning : Theme.text-muted;
                font-size: Theme.font-xs;
                wrap: word-wrap;
            }
        }

        // Status block
        VerticalLayout {
            spacing: 2px;
            Text {
                text: State.status-text;
                color: State.status-color;
                font-size: Theme.font-sm;
                font-weight: 600;
            }
            Text {
                text: State.latency-line;
                color: Theme.text-muted;
                font-size: Theme.font-xs;
                overflow: elide;
            }
            Text {
                text: State.resource-line;
                color: Theme.text-muted;
                font-size: Theme.font-xs;
                overflow: elide;
            }
            if State.upload-line != "" : Text {
                text: State.upload-line;
                color: Theme.accent;
                font-size: Theme.font-xs;
            }
        }

        // ── Control bar: mic / headphones / screen ─────────────────
        Rectangle {
            height: 52px;
            border-radius: Theme.radius-md;
            background: Theme.bg-primary;
            HorizontalLayout {
                padding: 6px;
                spacing: Theme.gap-xs;
                alignment: space-around;
                IconBtn {
                    icon: State.muted ? @image-url("icons/mic-off.svg") : @image-url("icons/mic.svg");
                    active: State.muted;
                    active-danger: true;
                    tooltip: State.muted ? Tr.unmute : Tr.mute;
                    clicked => { Logic.toggle-mute(); }
                }
                IconBtn {
                    icon: State.deafened ? @image-url("icons/headphones-off.svg") : @image-url("icons/headphones.svg");
                    active: State.deafened;
                    active-danger: true;
                    tooltip: State.deafened ? Tr.undeafen : Tr.deafen;
                    clicked => { Logic.toggle-deafen(); }
                }
                IconBtn {
                    icon: State.sharing ? @image-url("icons/monitor-off.svg") : @image-url("icons/monitor.svg");
                    active: State.sharing;
                    active-danger: true;
                    tooltip: State.sharing ? Tr.stop-sharing : Tr.share-screen;
                    clicked => { Logic.toggle-share(); }
                }
                IconBtn {
                    icon: @image-url("icons/gear.svg");
                    tooltip: Tr.settings;
                    clicked => { Logic.open-settings(); }
                }
            }
        }

        Btn {
            text: Tr.disconnect;
            accent: true;
            clicked => { Logic.disconnect(); }
        }
    }
}
