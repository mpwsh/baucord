// tray.slint — the system-tray icon (Slint's builtin SystemTrayIcon,
// 1.17+; native backends: Shell_NotifyIconW / AppKit / StatusNotifier).
//
// A SystemTrayIcon is a top-level component: the shell instantiates it
// alongside MainWindow, and the icon lives exactly as long as the
// instance. A tray component gets its OWN copy of every global (it
// shares nothing with MainWindow), so every label arrives through a
// plain property instead of Tr, already worded by the host.
//
// The menu is rebuilt by Slint whenever a property it reads changes,
// so the host sets these only when something it shows moved (a mute,
// someone joining the room), never on a speaking edge. The native
// menus draw no check marks (none of the three backends does), so a
// state is said in the words: Mute / Unmute.
//
// The room's people are items of the menu itself, not of a submenu
// named after the room: muting someone is one click from the icon, and
// the list is short — only the people in our voice room.

/// One person in our voice room, as the menu offers them.
export struct TrayPerson {
    /// "Mute Ana" or "Unmute Ana": muting is for us alone.
    title: string,
}

export component BaucordTray inherits SystemTrayIcon {
    in property <string> show-label: "Show";
    in property <string> quit-label: "Quit";
    in property <string> mute-label: "Mute";
    in property <string> deafen-label: "Deafen";
    in property <string> tip: "baucord";
    /// Connected: our own mute and deafen are offered.
    in property <bool> connected: false;
    /// Nobody hears us (our mute, our deafen, or the server's mute):
    /// the icon goes red.
    in property <bool> quiet: false;
    /// The other people in our voice room; empty outside one.
    in property <[TrayPerson]> people;
    callback show-app();
    callback quit-app();
    callback toggle-mute();
    callback toggle-deafen();
    /// `people[index]`, muted or unmuted for us.
    callback toggle-person(int);

    // A flat glyph that still reads at 16 px (scripts/tray-icons.py),
    // red while nobody hears us.
    icon: root.quiet ? @image-url("../../../assets/icons/tray-quiet.png")
        : @image-url("../../../assets/icons/tray.png");
    tooltip: root.tip;

    // Left-click restores the window (Windows: WM_LBUTTONUP, Linux:
    // StatusNotifier Activate, macOS: AppKit click); right-click opens
    // the menu — covers both the single- and double-click habits.
    clicked => { root.show-app(); }

    Menu {
        MenuItem { title: root.show-label; activated => { root.show-app(); } }
        if root.connected : MenuSeparator { }
        if root.connected : MenuItem {
            title: root.mute-label;
            activated => { root.toggle-mute(); }
        }
        if root.connected : MenuItem {
            title: root.deafen-label;
            activated => { root.toggle-deafen(); }
        }
        if root.people.length > 0 : MenuSeparator { }
        for person[i] in root.people : MenuItem {
            title: person.title;
            activated => { root.toggle-person(i); }
        }
        MenuSeparator { }
        MenuItem { title: root.quit-label; activated => { root.quit-app(); } }
    }
}
