// chat.slint — rich chat history + composer.
//
// The FLTK build's 1,500-line custom-drawn ChatView collapses into a
// ListView over a row model. Row kinds:
//   0 message  — [12:34] name  body (wraps)
//   1 system   — muted italic notice
//   2 image    — header + rounded inline image; GIFs animate (the shell
//                swaps frames into `image` on a slint::Timer, autoplay
//                ~3 loops → freeze → hover replay), click opens the
//                gallery viewer, right-click offers save/open
//   3 code     — ```-fenced block as a monospace panel (links stay
//                inline in message rows: the markdown translator
//                linkifies them for StyledText)
//
// Context menus are the window's own overlay (main.slint), filled by
// the host from app-core's `menu`: copy / select / edit / delete for
// messages, open / save for images, cut / copy / paste in the
// composer. A right-click reaches a row's TouchArea because the
// read-only TextInputs ignore every button but the left one; a
// StyledText accepts them all, so on a formatted body the menu opens
// from the header, the gutter or the margin.
//
// The composer: emoji + attach icon buttons, the input, live counter
// (amber past 380), send. The emoji palette is an in-window popover —
// the entire FLTK focus-churn saga (Unfocus debounce, generation
// guards, deferred teardown) is retired by construction.

import { ListView } from "std-widgets.slint";
import { Icon, IconSet, IconDisplay } from "@lucide";
import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { State, Logic, ChatRow } from "globals.slint";
import { IconBtn, AvatarTile, ProgressRing, LongPress } from "widgets.slint";

// ── Rows ────────────────────────────────────────────────────────────────
//
// Two densities (Settings → General → Chat). Cozy, the default, is
// Slack's shape: a gutter with the author's picture, a header (name,
// time) on the first message of a run, bodies below; a continuation
// (same author within five minutes) shows only its body, aligned.
// Compact is one line per message: name, time, body.

/// The author's picture in the gutter, on the first row of a run.
/// Hovering it summons the profile card (the host maps the name to
/// the roster row; someone who left gets none).
component Gutter inherits Rectangle {
    in property <ChatRow> data;
    in property <bool> head;
    /// A right-click on the picture: the row opens its menu there
    /// (the tile's own TouchArea would otherwise swallow it).
    callback context(x: length, y: length);
    /// The pointer (on touch: a finger) is on the picture.
    callback hovered(bool);
    width: Theme.chat-gutter;
    if head : tile := Rectangle {
        x: Theme.gap-sm;
        y: 0px;
        width: 36px;
        height: 36px;
        AvatarTile {
            source: data.avatar;
            has-image: data.has-avatar;
            initial: data.initial;
            tint: data.tile-tint;
            side: 36px;
            corner: 8px;
            ring-room: false;
        }
        TouchArea {
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                    root.context(self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
            }
            changed has-hover => {
                if (self.has-hover) {
                    State.card-x = tile.absolute-position.x;
                    State.card-y = tile.absolute-position.y;
                    State.card-anchor-h = tile.height;
                }
                Logic.author-hovered(data.user, self.has-hover);
                root.hovered(self.has-hover);
            }
        }
    }
}

/// Name and time, on the first row of a run.
component RowHeader inherits HorizontalLayout {
    in property <ChatRow> data;
    spacing: Theme.gap-sm;
    height: Theme.chat-header;
    Text {
        text: data.user;
        color: data.has-name-color ? data.name-color : Theme.accent-text;
        font-size: Theme.font-body;
        font-weight: data.name-style == 2 ? 600 : 700;
        font-italic: data.name-style == 2;
        vertical-alignment: center;
    }
    if State.show-timestamps : Text {
        text: data.ts;
        color: Theme.text-muted;
        font-size: Theme.font-sm;
        vertical-alignment: center;
    }
    Rectangle { }
}

/// What a person's row has around its body, whatever the body is: the
/// roster's hover tint, the right-click (and, on touch, the held
/// finger) that opens the row's menu, the author's picture in the
/// gutter and the name line on the first row of a run. The row puts
/// its body inside and says where the name line goes. (Four rows each
/// carried a copy; review P2-58.)
component RowFrame inherits Rectangle {
    in property <ChatRow> data;
    /// The body is in its selectable plain view: told to the host with
    /// the menu request (a text row's; false elsewhere).
    in property <bool> selecting: false;
    /// Where the row's content starts, from its top edge.
    in property <length> top;
    /// The name line: whether this row has one, where it starts and
    /// what it leaves free on the right.
    in property <bool> header-shown: root.cozy && root.head;
    in property <length> header-x: Theme.chat-gutter;
    in property <length> header-margin: Theme.gap-sm;
    out property <bool> cozy: !State.compact-rows;
    out property <bool> head: !root.data.continuation;
    /// A long press opened the menu and the finger is still down: its
    /// release is not a tap.
    out property <bool> held: lp.fired;
    /// Open the row's menu at window coordinates.
    public function context-menu(x: length, y: length) {
        Logic.row-context(root.data, root.selecting, x, y);
    }

    // The TouchArea wraps the content, so its hover holds over the
    // text bodies as well.
    border-radius: Theme.radius-sm;
    background: ctx.has-hover ? Theme.hover : transparent;
    animate background { duration: 100ms; }

    /// A finger on the author's picture: holding it is the person's
    /// card (as on a roster row), not the message's menu.
    property <bool> on-avatar: false;

    // Under everything: a read-only body ignores right-clicks, so
    // they land here.
    lp := LongPress {
        pressing: ctx.has-hover && !root.on-avatar;
        long-pressed => {
            root.context-menu(ctx.absolute-position.x + ctx.mouse-x,
                ctx.absolute-position.y + ctx.mouse-y);
        }
    }
    ctx := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.context-menu(self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
        // A row reused for another message, or a picture that went
        // away under the pointer, never sends its own exit.
        changed has-hover => {
            if (!self.has-hover) { root.on-avatar = false; }
        }
        Rectangle {
            if root.cozy : Gutter {
                x: 0px;
                y: root.top;
                height: 36px;
                data: root.data;
                head: root.head;
                context(x, y) => { root.context-menu(x, y); }
                hovered(on) => { root.on-avatar = on; }
            }
            if root.header-shown : RowHeader {
                x: root.header-x;
                y: root.top;
                width: parent.width - root.header-x - root.header-margin;
                data: root.data;
            }
            @children
        }
    }
}

component MessageRow inherits RowFrame {
    /// StyledText cannot be selected with the mouse, so a styled row
    /// can be switched to its selectable plain view (menu, or a
    /// double-click on the text) and back.
    in property <bool> select-mode: false;
    callback select-requested(bool);

    // Which view is up: the selectable input for plain rows and for
    // styled rows in select mode, the StyledText otherwise.
    property <bool> plain-view: !root.data.styled || root.select-mode;
    top: root.cozy ? (root.head ? Theme.gap-sm : 2px) : (root.head ? 4px : 1px);
    property <length> header-h: root.cozy && root.head ? Theme.chat-header : 0px;
    height: root.top + root.header-h + cell.height + (root.cozy ? 4px : 3px);
    selecting: root.select-mode;

    // Compact: name and time inline, in front of the body. Always
    // instantiated (hidden in cozy) so the cell can read its width.
    compact-head := HorizontalLayout {
        x: Theme.gap-sm;
        y: root.top;
        height: cell.height;
        visible: !root.cozy && root.head;
        spacing: Theme.gap-sm;
        Text {
            text: root.data.user;
            color: root.data.has-name-color ? root.data.name-color : Theme.accent-text;
            font-size: Theme.font-body;
            font-weight: root.data.name-style == 2 ? 600 : 700;
            font-italic: root.data.name-style == 2;
        }
        if State.show-timestamps : Text {
            text: root.data.ts;
            color: Theme.text-muted;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
    }

    // Plain messages render in a read-only TextInput (mouse
    // selection + Ctrl/Cmd+C); styled ones in a StyledText
    // (inline bold/italic/code — not selectable, but the
    // right-click Copy still grabs the raw text). Both live in
    // one cell; `visible` picks the active one and the cell
    // tracks its height. A deleted message keeps its header and
    // shows a muted placeholder instead.
    cell := Rectangle {
        x: root.cozy ? Theme.chat-gutter
            : root.head ? Theme.gap-sm + compact-head.preferred-width + Theme.gap-sm
            : Theme.gap-sm + 20px;
        y: root.top + root.header-h;
        width: parent.width - self.x - Theme.gap-sm
            - (root.data.edited && !root.plain-view && !root.data.deleted ? mark.preferred-width + Theme.gap-sm : 0px);
        height: root.data.deleted ? gone.preferred-height
            : root.plain-view ? body.preferred-height
            : styled-body.preferred-height;
        // Under the StyledText: a double-click on the text
        // (off a link) switches to the selectable view.
        if root.data.styled && !root.select-mode : TouchArea {
            double-clicked => { root.select-requested(true); }
        }
        body := TextInput {
            x: 0;
            y: 0;
            width: 100%;
            visible: root.plain-view && !root.data.deleted;
            text: root.data.edited ? "\{root.data.body} \{Tr.chat-edited-mark}" : root.data.body;
            read-only: true;
            single-line: false;
            // Sent and waiting for the server: muted until acked.
            color: root.data.pending ? Theme.text-muted : Theme.text-secondary;
            font-size: Theme.font-body;
            wrap: word-wrap;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-accent;
            // A key on a read-only row: printable characters go
            // to the composer (see Logic.type-through); the
            // rest (⌘C, arrows) stays here for the selection.
            key-pressed(ev) => {
                if (!ev.modifiers.control && !ev.modifiers.meta && !ev.modifiers.alt
                    && ev.text != "") {
                    Logic.type-through(ev.text);
                    return accept;
                }
                reject
            }
        }
        styled-body := StyledText {
            x: 0;
            y: 0;
            width: 100%;
            visible: !root.plain-view && !root.data.deleted;
            text: root.data.body-styled;
            default-color: Theme.text-secondary;
            default-font-size: Theme.font-body;
            link-color: Theme.accent-text;
            link-clicked(url) => { if (!root.held) { Logic.link-clicked(url); } }
        }
        gone := Text {
            x: 0;
            y: 0;
            width: 100%;
            visible: root.data.deleted;
            text: Tr.chat-deleted-placeholder;
            color: Theme.text-muted;
            font-size: Theme.font-body;
            font-italic: true;
        }
    }
    // The mark for a styled body: StyledText is pre-parsed, so it
    // sits beside the cell rather than inside the text.
    mark := Text {
        x: cell.x + cell.width + Theme.gap-sm;
        y: cell.y;
        visible: root.data.edited && !root.plain-view && !root.data.deleted;
        text: Tr.chat-edited-mark;
        color: Theme.text-muted;
        font-size: Theme.font-sm;
    }
}

component SystemRow inherits Rectangle {
    in property <ChatRow> data;
    height: body.preferred-height + 6px;
    // Read-only input rather than Text: an invite code or a server
    // notice is something people select and copy.
    HorizontalLayout {
        padding-left: Theme.gap-sm;
        padding-right: Theme.gap-sm;
        padding-top: 3px;
        body := TextInput {
            text: data.body;
            read-only: true;
            single-line: false;
            color: Theme.text-muted;
            font-size: Theme.font-sm;
            font-italic: true;
            wrap: word-wrap;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-accent;
            // A key on a read-only row: printable characters go
            // to the composer (see Logic.type-through); the
            // rest (⌘C, arrows) stays here for the selection.
            key-pressed(ev) => {
                if (!ev.modifiers.control && !ev.modifiers.meta && !ev.modifiers.alt
                    && ev.text != "") {
                    Logic.type-through(ev.text);
                    return accept;
                }
                reject
            }
        }
    }
}

/// "Thursday, August 27th" between two days, on a rule.
// ── File card (spec §7) ─────────────────────────────────────────────────
// A bordered card under the usual header: a type glyph, the name, the
// size, and Save. Nothing is previewed or opened; Save fetches the
// bytes into the Downloads folder.
component FileRow inherits RowFrame {
    top: root.cozy && root.head ? Theme.gap-xs : 2px;
    height: root.top + (root.cozy && root.head ? 20px : 0px) + 60px + Theme.gap-xs;
    header-margin: Theme.gap-md;

    card := Rectangle {
        x: root.cozy ? Theme.chat-gutter : Theme.gap-sm;
        y: root.top + (root.cozy && root.head ? 20px : 0px);
        width: Math.min(360px, parent.width - self.x - Theme.gap-md);
        height: 60px;
        border-radius: Theme.radius-md;
        background: Theme.bg-secondary;
        border-width: 1px;
        border-color: Theme.border;
        opacity: root.data.pending ? 0.6 : 1.0;
        HorizontalLayout {
            padding: Theme.gap-sm;
            spacing: Theme.gap-sm;
            // The type word in a tile, where an image would be.
            Rectangle {
                width: 44px;
                border-radius: Theme.radius-sm;
                background: Theme.bg-tertiary;
                Text {
                    text: root.data.file-kind;
                    color: Theme.text-secondary;
                    font-size: Theme.font-xs;
                    font-weight: 700;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.data.body;
                    color: Theme.text-primary;
                    font-size: Theme.font-body;
                    font-weight: 500;
                    overflow: elide;
                }
                // The size — or, while bytes move, what is
                // happening and how far along.
                Text {
                    text: root.data.transfer-kind == 1
                        ? Tr.file-uploading-pct + " " + root.data.transfer-pct + "%"
                        : root.data.transfer-kind == 2
                        ? Tr.file-downloading-pct + " " + root.data.transfer-pct + "%"
                        : root.data.file-meta;
                    color: root.data.transfer-kind != 0 ? Theme.accent-text : Theme.text-muted;
                    font-size: Theme.font-xs;
                    overflow: elide;
                }
            }
            // Already saved: a check and Open, with a small
            // re-download beside them.
            if root.data.transfer-kind == 0 && root.data.file-saved : HorizontalLayout {
                spacing: Theme.gap-xs;
                Rectangle {
                    width: 16px;
                    IconDisplay {
                        icon: IconSet.Check;
                        size: 16px;
                        stroke: Theme.success;
                    }
                }
                Rectangle {
                    width: open-lbl.preferred-width + 2 * Theme.gap-sm;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 28px;
                        border-radius: Theme.radius-sm;
                        background: open-t.has-hover ? Theme.hover : Theme.bg-tertiary;
                        animate background { duration: 150ms; }
                        open-lbl := Text {
                            text: Tr.file-open;
                            color: Theme.text-primary;
                            font-size: Theme.font-sm;
                            font-weight: 500;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        open-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { if (!root.held) { Logic.file-open(root.data.row-id); } }
                        }
                    }
                }
                Rectangle {
                    width: 28px;
                    IconBtn {
                        y: (parent.height - self.height) / 2;
                        size: 28px;
                        icon-size: 14px;
                        icon: IconSet.Download;
                        tooltip: Tr.file-save-again;
                        clicked => { if (!root.held) { Logic.file-save(root.data.row-id); } }
                    }
                }
            }
            Rectangle {
                width: root.data.file-saved && root.data.transfer-kind == 0 ? 0px
                    : root.data.transfer-kind != 0 ? 28px + Theme.gap-xs + 28px
                    : save-lbl.preferred-width + 2 * Theme.gap-sm;
                // Save — or a turning ring while a transfer runs.
                if root.data.transfer-kind == 0 && !root.data.file-saved : Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: save-t.has-hover ? Theme.hover : Theme.bg-tertiary;
                    animate background { duration: 150ms; }
                    Text {
                        text: Tr.file-save;
                        color: Theme.text-primary;
                        font-size: Theme.font-sm;
                        font-weight: 500;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    save-t := TouchArea {
                        enabled: !root.data.pending;
                        mouse-cursor: pointer;
                        clicked => { if (!root.held) { Logic.file-save(root.data.row-id); } }
                    }
                }
                // A ring that fills with the percent: determinate,
                // so it says how far, not just that something moves.
                // The ✕ beside it stops the transfer.
                if root.data.transfer-kind != 0 : ProgressRing {
                    y: (parent.height - self.height) / 2;
                    percent: root.data.transfer-pct;
                }
                if root.data.transfer-kind != 0 : IconBtn {
                    x: 28px + Theme.gap-xs;
                    y: (parent.height - self.height) / 2;
                    size: 28px;
                    icon-size: 14px;
                    icon: IconSet.X;
                    tooltip: Tr.file-cancel;
                    clicked => { if (!root.held) { Logic.file-cancel(root.data.row-id); } }
                }
                // Measured off-screen so the slot keeps its width
                // whichever face shows.
                save-lbl := Text {
                    text: Tr.file-save;
                    font-size: Theme.font-sm;
                    font-weight: 500;
                    visible: false;
                }
            }
        }
        // A progress rail along the bottom edge.
        if root.data.transfer-kind != 0 : Rectangle {
            x: 0;
            y: parent.height - 3px;
            height: 3px;
            width: parent.width * Math.clamp(root.data.transfer-pct, 0, 100) / 100;
            background: Theme.accent-text;
            animate width { duration: 150ms; }
        }
    }
}

component DayMarkerRow inherits Rectangle {
    in property <ChatRow> data;
    height: 34px;
    HorizontalLayout {
        padding-left: Theme.gap-sm;
        padding-right: Theme.gap-sm;
        spacing: Theme.gap-md;
        Rectangle {
            height: 1px;
            y: (parent.height - 1px) / 2;
            background: Theme.border;
            horizontal-stretch: 1;
        }
        Rectangle {
            // Never wider than the row: an unwrapped label's width is
            // a *minimum* the ListView adopts as its viewport width,
            // and that is a horizontal scrollbar.
            width: Math.min(label.preferred-width + 2 * Theme.gap-md, root.width * 0.8);
            height: 24px;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: Theme.bg-secondary;
            border-width: 1px;
            border-color: Theme.border;
            label := Text {
                width: parent.width - 2 * Theme.gap-sm;
                text: data.body;
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
        Rectangle {
            height: 1px;
            y: (parent.height - 1px) / 2;
            background: Theme.border;
            horizontal-stretch: 1;
        }
    }
}

component CodeRow inherits RowFrame {
    top: root.head ? (root.cozy ? Theme.gap-sm : 4px) : 2px;
    property <length> header-h: root.head ? Theme.chat-header : 0px;
    property <length> left: root.cozy ? Theme.chat-gutter : Theme.gap-sm;
    height: root.top + root.header-h + panel.height + 6px;
    header-shown: root.head;
    header-x: root.left;

    VerticalLayout {
        x: root.left;
        y: root.top + root.header-h;
        width: parent.width - root.left - Theme.gap-sm;
        panel := Rectangle {
            height: code.preferred-height + 2 * Theme.gap-sm;
            background: Theme.surface;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            // Manually positioned (no layout) so long lines can't
            // inflate ancestors; read-only TextInput keeps code
            // selectable — the thing people copy most.
            code := TextInput {
                x: Theme.gap-sm;
                y: Theme.gap-sm;
                width: parent.width - 2 * Theme.gap-sm;
                text: root.data.body;
                read-only: true;
                single-line: false;
                wrap: word-wrap;
                color: Theme.mono-text;
                font-family: "monospace";
                font-size: Theme.font-sm;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.on-accent;
                // A key on a read-only row: printable characters go
                // to the composer (see Logic.type-through); the
                // rest (⌘C, arrows) stays here for the selection.
                key-pressed(ev) => {
                    if (!ev.modifiers.control && !ev.modifiers.meta && !ev.modifiers.alt
                        && ev.text != "") {
                        Logic.type-through(ev.text);
                        return accept;
                    }
                    reject
                }
            }
        }
    }
}

component ImageRow inherits RowFrame {

    // Fit within 360×280 like before, and never wider than the view.
    property <length> avail: root.width - root.left - Theme.gap-sm;
    property <float> maxw: Math.min(360.0, avail / 1px);
    property <float> scale: Math.min(1.0, Math.min(
        maxw / Math.max(1.0, root.data.img-w),
        280.0 / Math.max(1.0, root.data.img-h)));
    property <length> disp-w: Math.max(1.0, root.data.img-w * scale) * 1px;
    property <length> disp-h: Math.max(1.0, root.data.img-h * scale) * 1px;

    top: root.head ? (root.cozy ? Theme.gap-sm : 4px) : 2px;
    property <length> header-h: root.head ? Theme.chat-header : 0px;
    property <length> left: root.cozy ? Theme.chat-gutter : Theme.gap-sm;
    height: root.top + root.header-h + disp-h + 6px;
    header-shown: root.head;
    header-x: root.left;

    VerticalLayout {
        x: root.left;
        y: root.top + root.header-h;
        width: parent.width - root.left - Theme.gap-sm;
        HorizontalLayout {
            frame := Rectangle {
                width: root.disp-w;
                height: root.disp-h;
                border-radius: Theme.radius-md;
                background: Theme.surface;
                clip: true;
                // A playing GIF's frame, or the picture as the host
                // decoded it for this row (only rows on screen are
                // built, so only they hold pixels). One decoded while
                // the row shows fades in over its empty frame; one
                // already decoded is simply there.
                Image {
                    width: 100%;
                    height: 100%;
                    source: root.data.image.width > 0 ? root.data.image
                        : Logic.chat-picture(root.data.row-id, root.data.image-rev);
                    image-fit: contain;
                    opacity: self.source.width > 0 ? 1 : 0;
                    animate opacity { duration: 120ms; }
                }
                // On its way up: muted, with the ring, the percent
                // and a ✕ over the picture (the file card's look).
                if root.data.transfer-kind != 0 : Rectangle {
                    background: #00000088;
                    border-radius: Theme.radius-md;
                    HorizontalLayout {
                        alignment: center;
                        spacing: Theme.gap-sm;
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: Theme.gap-sm;
                                ProgressRing {
                                    percent: root.data.transfer-pct;
                                    track-color: #FFFFFF55;
                                    ring-color: white;
                                }
                                Text {
                                    text: Tr.file-uploading-pct + " " + root.data.transfer-pct + "%";
                                    color: white;
                                    font-size: Theme.font-sm;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                IconBtn {
                                    size: 28px;
                                    icon-size: 14px;
                                    icon: IconSet.X;
                                    tooltip: Tr.file-cancel;
                                    clicked => { if (!root.held) { Logic.file-cancel(root.data.row-id); } }
                                }
                            }
                        }
                    }
                }
                it := TouchArea {
                    enabled: root.data.transfer-kind == 0;
                    mouse-cursor: pointer;
                    // Not the release of a long press (its menu is open).
                    clicked => { if (!root.held) { Logic.row-open-image(root.data.row-id); } }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                            root.context-menu(self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
                        }
                    }
                    changed has-hover => {
                        if (root.data.is-gif) { Logic.gif-hover(root.data.row-id, self.has-hover); }
                    }
                }
            }
            Rectangle { }   // left-align the image
        }
    }
}

// ── Composer + history ──────────────────────────────────────────────────

component ComposerField inherits Rectangle {
    in-out property <string> text <=> input.text;
    /// A right-click anywhere on the field (the input ignores the
    /// button; the Flickable only intercepts the left one).
    callback context(x: length, y: length);
    // UTF-8 byte offsets, the unit set-selection-offsets consumes —
    // forwarded to the host for cursor-relative edits.
    out property <int> cursor-offset <=> input.cursor-position-byte-offset;
    out property <int> anchor-offset <=> input.anchor-position-byte-offset;
    callback edited;
    out property <bool> input-focused: input.has-focus;
    public function focus-input() { input.focus(); }
    public function set-cursor(pos: int) { input.set-selection-offsets(pos, pos); }
    public function select-all() { input.select-all(); }
    /// Android: the word the keyboard is still composing is shown in
    /// the field but is not in `text` until the keyboard commits it —
    /// on a space or punctuation, not on Enter or the send button, so a
    /// message sent mid-word went out without it and the word stayed
    /// behind (users: "it won't send until I type a space"). Slint
    /// commits the composition when the field loses focus; losing it
    /// and taking it straight back does that and keeps the keyboard.
    /// Elsewhere a composition is the IME's to finish (desktop IMEs
    /// commit before Enter reaches us).
    public function commit-composition() {
        if (Platform.os == OperatingSystemType.android && input.preedit-text != "") {
            input.clear-focus();
            input.focus();
        }
    }

    // Grows with the draft like Discord: one line at rest, up to ~5
    // lines, then scrolls internally with the caret kept visible.
    // Wrapping means content pressure is vertical only, and the
    // explicit clamp caps it — nothing can inflate the composer row
    // sideways (Enter/Shift+Enter routing lives in the enclosing
    // FocusScope's capture handler).
    height: clamp(input.preferred-height + 16px, 40px, 124px);
    min-width: 120px;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    animate border-color { duration: 150ms; }

    in property <string> placeholder;
    TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.context(self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }
    // The hint for an empty draft: the room, or the person.
    // (Not over a first word the keyboard is still composing.)
    if root.placeholder != "" && input.text == "" && input.preedit-text == "" : Text {
        x: Theme.gap-md;
        y: 0;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-muted;
        font-size: Theme.font-body;
        vertical-alignment: center;
    }

    fl := Flickable {
        x: Theme.gap-md;
        y: 8px;
        width: parent.width - 2 * Theme.gap-md;
        height: parent.height - 16px;
        content-height: max(self.height, input.preferred-height);
        input := TextInput {
            width: fl.width;
            // Fill the field when the draft fits so a single line
            // centers vertically; taller drafts take their natural
            // height and scroll.
            height: max(fl.height, self.preferred-height);
            vertical-alignment: center;
            single-line: false;
            wrap: word-wrap;
            font-size: Theme.font-body;
            color: Theme.text-primary;
            // Slint draws a composing word with the selection colours,
            // so on Android every word looked selected while typed;
            // plain text instead until the keyboard commits it.
            selection-background-color: self.preedit-text != "" ? transparent : Theme.accent;
            selection-foreground-color: self.preedit-text != "" ? Theme.text-primary : Theme.on-accent;
            edited => { root.edited(); }
            cursor-position-changed(pos) => {
                if (pos.y + fl.content-y < 0px) {
                    fl.content-y = -pos.y;
                } else if (pos.y + fl.content-y + 20px > fl.height) {
                    fl.content-y = fl.height - pos.y - 20px;
                }
            }
        }
    }
}

// The narrow layout's way back to the list (ANDROID-SPEC.md D26): an
// arrow, and how many unread messages wait in the other conversations
// (every DM's, plus General's while a DM is open) — the list is where
// they are, and from here nothing else would say so.
component NavBack inherits Rectangle {
    callback clicked;
    property <int> elsewhere: State.dm-unread-total
        + (State.active-dm >= 0 ? State.general-unread : 0);
    // Finger-sized on a touch host (review 2026-10, P3-18).
    width: State.touch-host ? 40px : 32px;
    height: self.width;
    IconBtn {
        size: parent.width;
        icon-size: 20px;
        icon: IconSet.ArrowLeft;
        idle-color: Theme.text-primary;
        clicked => { root.clicked(); }
    }
    // Centred on the arrow's top-right corner.
    if root.elsewhere > 0 : Rectangle {
        x: 26px - self.width / 2;
        y: 6px - self.height / 2;
        width: Math.max(self.height, count.preferred-width + 10px);
        height: 18px;
        border-radius: 9px;
        background: Theme.accent;
        border-width: 2px;
        border-color: Theme.bg-secondary;
        count := Text {
            text: root.elsewhere > 99 ? "99+" : "\{root.elsewhere}";
            color: Theme.on-accent;
            font-size: Theme.font-xs;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// A header's trailing icon button (clear the view; General's
// activity toggle), centered in the header's height.
component HeaderBtn inherits Rectangle {
    in property <Icon> icon;
    in property <string> tooltip;
    callback clicked;
    width: State.touch-host ? 40px : 32px;
    IconBtn {
        y: (parent.height - self.height) / 2;
        size: parent.width;
        icon-size: 18px;
        icon: root.icon;
        tooltip: root.tooltip;
        tooltip-below: true;
        clicked => { root.clicked(); }
    }
}

export component ChatPane inherits Rectangle {
    /// The narrow layout's chat page (ANDROID-SPEC.md D26): the header
    /// leads with the way back to the list.
    in property <bool> narrow: false;
    /// The pane is on screen. Off (a page over it, the window in the
    /// tray or minimized, a phone app in the background) a follow owed
    /// waits, and is done when the pane is back: it ran 8 to 90 frames
    /// a message whether or not anyone saw it (review 2026-10, P1-3).
    in property <bool> drawn: true;
    background: Theme.bg-primary;

    public function scroll-to-end() {
        list.content-y = -Math.max(0px, list.content-height - list.visible-height);
    }
    /// Stick to the newest row and go there: after sending, a
    /// conversation switch, the jump button, the new-messages pill.
    public function pin-to-bottom() {
        root.hold-bottom();
        root.follow-pending = true;
        root.scroll-to-end();
    }
    /// Whether new rows are followed (the reader is at the newest).
    public pure function following() -> bool { return root.stick-to-bottom; }
    /// How far the view is from the newest row (0 at the bottom).
    public pure function bottom-gap() -> length { return list.gap(); }
    public function focus-composer() { input.focus-input(); }
    public pure function composer-focused() -> bool { return input.input-focused; }
    public function composer-set-cursor(pos: int) { input.set-cursor(pos); }
    /// The host appended rows to the conversation on screen. A reader
    /// stuck to the bottom follows them (on the layout pass that
    /// measures them: a scroll-to-end right after a push reads the old
    /// height); `false` means they are scrolled up, and the host counts
    /// what they have not seen (`State.chat-new-count`).
    public function follow-appended() -> bool {
        if (root.stick-to-bottom) { root.follow-pending = true; }
        return root.stick-to-bottom;
    }

    // How the list stays at the newest row, and lets go of it.
    //
    // Slint's ListView only estimates the height of rows it has not
    // laid out (the average of the ones on screen, times the row
    // count), and it rewrites `content-y` itself whenever that
    // estimate moves: a picture laid out, a row added, the last rows
    // reached after a jump. Those rewrites go up as often as down, so
    // the position alone cannot tell the reader's hand from the list's
    // bookkeeping. Reading "content-y went up" as "the reader scrolled
    // up" is what let go of the bottom right after the jump button,
    // and on new messages, with nobody touching anything.
    //
    // So the reader is known by input, not by position: the list's
    // `scrolled` fires only for a wheel, a drag or a fling, and the
    // pane draws its own scrollbar, which says so too (the stock one
    // moved the list on a wheel over it without a word). While
    // the reader's hand is on the list (`user-scrolling`, until the
    // position has been still for 200 ms) moving away from the bottom
    // lets go and coming within 48px of it holds; nothing follows
    // against them. Otherwise only one thing changes the state: being
    // at the very bottom holds it. While held, any change in height —
    // new rows, a picture decoded, a page put in front, an estimate
    // settling, the keyboard opening — is followed down.
    private property <bool> stick-to-bottom: true;
    private property <bool> user-scrolling: false;
    private property <length> user-last-y;
    private property <int> user-still-ticks: 0;
    // A follow is owed: the list is to be taken to its end until the
    // end stops moving.
    private property <bool> follow-pending: false;
    // Nudge to the end once a frame until it lands — a timer, not
    // scrolling from a `changed` handler, which chained with the
    // ListView's own updates into the runtime's "long callback chain"
    // warning. The last rows' heights are estimates until they are
    // laid out, so the follow is not done at the first exact bottom:
    // it holds there for 8 frames. Bounded, so a follow that can never
    // land does not tick forever.
    private property <int> follow-ticks: 0;
    private property <int> follow-settled: 0;

    // The reader moved the list: whatever follow was owed is theirs to
    // decide now.
    function reader-moves() {
        root.user-scrolling = true;
        root.user-still-ticks = 0;
        root.user-last-y = list.content-y;
        root.follow-pending = false;
    }
    function hold-bottom() {
        root.stick-to-bottom = true;
        State.chat-new-count = 0;
    }
    function let-go() {
        root.stick-to-bottom = false;
        root.follow-pending = false;
        root.follow-ticks = 0;
        root.follow-settled = 0;
    }

    Timer {
        interval: 16ms;
        running: root.follow-pending && !root.user-scrolling && root.drawn;
        triggered => {
            root.scroll-to-end();
            root.follow-ticks += 1;
            root.follow-settled = list.gap() <= 2px ? root.follow-settled + 1 : 0;
            if (root.follow-settled >= 8 || root.follow-ticks > 90) {
                root.follow-pending = false;
                root.follow-ticks = 0;
                root.follow-settled = 0;
            }
        }
    }
    // The reader's hand left the list once the position has been still
    // for 200 ms (a wheel step animates for 180 ms, a fling longer).
    // Ending at the bottom holds it; held, the end is followed again.
    Timer {
        interval: 50ms;
        running: root.user-scrolling;
        triggered => {
            root.user-still-ticks = Math.abs(list.content-y - root.user-last-y) < 0.5px
                ? root.user-still-ticks + 1 : 0;
            root.user-last-y = list.content-y;
            if (root.user-still-ticks >= 4) {
                root.user-scrolling = false;
                root.user-still-ticks = 0;
                if (list.gap() <= 2px) { root.hold-bottom(); }
                if (root.stick-to-bottom) { root.follow-pending = true; }
            }
        }
    }

    col := VerticalLayout {
        padding: Theme.gap-md;
        spacing: Theme.gap-sm;

        // ── Conversation header (spec §6): where you are. General
        // says so too (the `#`, and how many are here); a DM has the
        // person, a way back, and on a memory-mode server the fact
        // that nothing is kept.
        if State.active-dm < 0 : Rectangle {
            height: general-head.preferred-height + 2 * Theme.gap-sm;
            border-radius: Theme.radius-sm;
            background: Theme.bg-secondary;
            general-head := HorizontalLayout {
                padding-left: Theme.gap-sm;
                padding-right: Theme.gap-sm;
                spacing: Theme.gap-sm;
                // The same slot the DM header's back button takes, so
                // the title sits at one x in both. Narrow: the way back
                // to the list instead.
                if root.narrow : NavBack {
                    clicked => { State.narrow-chat-open = false; }
                }
                if !root.narrow : Rectangle {
                    width: 28px;
                    IconDisplay {
                        icon: IconSet.Hash;
                        size: 18px;
                        stroke: Theme.accent-text;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 1;
                    Text {
                        text: Tr.dm-general;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        font-weight: 600;
                        overflow: elide;
                    }
                    // The server's greeting (it used to be a chat line
                    // on every login), then who is here.
                    if State.greeting != "" : Text {
                        text: State.greeting;
                        color: Theme.text-secondary;
                        font-size: Theme.font-sm;
                        overflow: elide;
                    }
                    Text {
                        text: State.users-count-label;
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                        overflow: elide;
                    }
                }
                // Clear the view, then flip between what was said and
                // who came and went (the page; the bubble to go back).
                HorizontalLayout {
                    spacing: 2px;
                    HeaderBtn {
                        icon: IconSet.BrushCleaning;
                        tooltip: Tr.chat-clear-tooltip;
                        clicked => { Logic.clear-chat(); }
                    }
                    HeaderBtn {
                        icon: State.activity-open ? IconSet.MessageCircle : IconSet.FileText;
                        tooltip: State.activity-open ? Tr.activity-hide : Tr.activity-show;
                        clicked => { Logic.general-view(!State.activity-open); }
                    }
                }
            }
        }
        if State.active-dm >= 0 : Rectangle {
            height: dm-head.preferred-height + 2 * Theme.gap-sm;
            border-radius: Theme.radius-sm;
            background: Theme.bg-secondary;
            dm-head := HorizontalLayout {
                padding-left: Theme.gap-sm;
                padding-right: Theme.gap-xs;
                spacing: Theme.gap-sm;
                // Wide: back to General. Narrow: back to the list
                // (General is a row there, like this DM).
                if root.narrow : NavBack {
                    clicked => { State.narrow-chat-open = false; }
                }
                if !root.narrow : IconBtn {
                    size: 28px;
                    icon-size: 16px;
                    icon: IconSet.ArrowLeft;
                    tooltip: Tr.dm-back;
                    tooltip-below: true;
                    clicked => { Logic.general-clicked(); }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 1;
                    Text {
                        text: State.conv-name;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: State.server-persistent ? Tr.dm-direct-message : Tr.dm-note-memory;
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                        overflow: elide;
                    }
                }
                HeaderBtn {
                    icon: IconSet.BrushCleaning;
                    tooltip: Tr.chat-clear-tooltip;
                    clicked => { Logic.clear-chat(); }
                }
            }
        }

        // Standing notice on a memory-mode server (spec §1.1): what
        // is decided here lasts until the server restarts.
        if !State.server-persistent : Rectangle {
            height: banner.preferred-height + 2 * Theme.gap-sm;
            border-radius: Theme.radius-sm;
            background: Theme.warning.with-alpha(0.12);
            border-width: 1px;
            border-color: Theme.warning.with-alpha(0.5);
            HorizontalLayout {
                padding-left: Theme.gap-md;
                padding-right: Theme.gap-md;
                spacing: Theme.gap-sm;
                Rectangle {
                    width: 14px;
                    IconDisplay {
                        icon: IconSet.TriangleAlert;
                        size: 14px;
                        stroke: Theme.warning;
                    }
                }
                banner := Text {
                    text: Tr.banner-not-persistent;
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }

        // "Load earlier": appears once the reader reaches the top and
        // the server said older pages exist; the page is put in front.
        if State.history-more && !State.activity-open && list.content-y >= -2px : Rectangle {
            height: 28px;
            border-radius: Theme.radius-sm;
            background: le.has-hover && !State.history-loading ? Theme.hover : transparent;
            animate background { duration: 150ms; }
            HorizontalLayout {
                alignment: center;
                spacing: Theme.gap-xs;
                Rectangle {
                    width: 14px;
                    IconDisplay {
                        icon: State.history-loading ? IconSet.LoaderCircle : IconSet.History;
                        size: 14px;
                        stroke: Theme.text-secondary;
                    }
                }
                Text {
                    text: State.history-loading ? Tr.chat-loading : Tr.chat-load-earlier;
                    color: State.history-loading ? Theme.text-muted : Theme.text-secondary;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                }
            }
            le := TouchArea {
                enabled: !State.history-loading;
                mouse-cursor: pointer;
                clicked => { Logic.load-earlier(); }
            }
        }

        // The history, and over an empty one a word on what this place
        // is and what to do (the composer is right below).
        list-box := Rectangle {
            vertical-stretch: 1;
            list := ListView {
                width: 100%;
                height: 100%;
                // The app compiles with Slint's default widget style, fluent, on
                // every target — and fluent's ScrollView never pans on a drag
                // (a mouse drag selects). A finger has nothing else to scroll
                // with, so a touch host turns panning on (ANDROID-SPEC.md D27).
                mouse-drag-pan-enabled: State.touch-host;
                // Stick and let go: see the notes at the top of
                // ChatPane. `gap` is how far the viewport's bottom is
                // from the end of the content (0 at the bottom; real
                // pixels near it, where the last rows are laid out).
                private property <length> last-content-y;
                pure function gap() -> length {
                    self.content-height - self.visible-height + self.content-y
                }
                // The stock scrollbar moves the list on a wheel or its
                // arrows without reporting `scrolled`; ours (below)
                // does.
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                scrolled => { root.reader-moves(); }
                changed content-y => {
                    if (self.gap() <= 2px) {
                        root.hold-bottom();
                    } else if (root.user-scrolling) {
                        if (self.content-y > self.last-content-y + 0.25px) {
                            root.let-go();
                        } else if (self.content-y < self.last-content-y - 0.25px
                            && self.gap() <= 48px) {
                            // Wheeled down to within a step of the end:
                            // the last rows' estimate can leave it a few
                            // px short. Hold; the follow closes the gap.
                            root.hold-bottom();
                        }
                    }
                    // Anything else is the list re-estimating, or our
                    // own follow: never a reason to let go.
                    self.last-content-y = self.content-y;
                }
                changed content-height => {
                    if (root.stick-to-bottom && !root.user-scrolling) { root.follow-pending = true; }
                }
                changed visible-height => {
                    if (root.stick-to-bottom && !root.user-scrolling) {
                        root.scroll-to-end();
                        root.follow-pending = true;
                    }
                }
                for row[i] in State.chat : Rectangle {
                    // One delegate per row, hosting only the matching kind.
                    // `if`, not `visible`: an invisible instance still
                    // hands the ListView its minimum width, and a day
                    // marker's pill sized to a message body was a
                    // horizontal scrollbar. ListView virtualizes, so only
                    // on-screen rows exist.
                    height: cell.preferred-height;
                    cell := VerticalLayout {
                        if row.kind == 0 : MessageRow {
                            data: row;
                            select-mode: State.selecting-row == row.row-id;
                            select-requested(on) => { State.selecting-row = on ? row.row-id : -1; }
                        }
                        if row.kind == 1 : SystemRow { data: row; }
                        if row.kind == 2 : ImageRow { data: row; }
                        if row.kind == 3 : CodeRow { data: row; }
                        if row.kind == 4 : DayMarkerRow { data: row; }
                        if row.kind == 5 : FileRow { data: row; }
                    }
                }
            }
            // The list's scrollbar, in place of the ListView's own:
            // the stock one's look (a thin thumb that widens under the
            // pointer), but every move it makes is the reader's. A
            // wheel over it is not taken here: it falls through to the
            // list, which scrolls and says so.
            if list.content-height > list.visible-height + 1px : bar := Rectangle {
                x: list.x + list.width - self.width;
                y: list.y;
                width: 14px;
                height: list.height;
                property <length> range: list.content-height - list.visible-height;
                property <length> track: self.height - 8px;
                property <length> thumb-h: Math.min(self.track,
                    Math.max(24px, self.track * (list.visible-height / list.content-height)));
                property <bool> hot: bar-touch.has-hover || bar-touch.pressed;
                Rectangle {
                    width: bar.hot ? 6px : 3px;
                    height: bar.thumb-h;
                    x: parent.width - self.width - 4px;
                    y: 4px + (bar.track - self.height)
                        * Math.clamp(-list.content-y / Math.max(1px, bar.range), 0, 1);
                    border-radius: self.width / 2;
                    background: bar.hot ? Theme.text-muted : Theme.border;
                    animate width { duration: 150ms; easing: ease-out; }
                    animate background { duration: 150ms; }
                }
                bar-touch := TouchArea {
                    mouse-cursor: default;
                    // Where the drag started, re-based when the range
                    // moves under it (the list re-estimating as rows
                    // are laid out), like the stock one.
                    property <length> start-y;
                    property <length> start-value;
                    property <length> start-range;
                    function rebase() {
                        self.start-y = self.mouse-y;
                        self.start-value = -list.content-y;
                        self.start-range = bar.range;
                    }
                    pointer-event(e) => {
                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                            self.rebase();
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            if (self.start-range != bar.range) { self.rebase(); }
                            root.reader-moves();
                            list.content-y = -Math.clamp(self.start-value
                                + (self.mouse-y - self.start-y)
                                    * (bar.range / Math.max(1px, bar.track - bar.thumb-h)),
                                0px, bar.range);
                        }
                    }
                }
            }
            if State.chat.length == 0
                && (State.activity-open || (!State.history-more && !State.history-loading)) : VerticalLayout {
                alignment: center;
                padding: Theme.gap-xl;
                spacing: Theme.gap-xs;
                Text {
                    text: State.activity-open ? Tr.activity-empty-title : Tr.chat-empty-title;
                    color: Theme.text-primary;
                    font-size: Theme.font-md;
                    font-weight: 600;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: State.activity-open ? Tr.activity-empty
                        : State.active-dm >= 0 ? Tr.chat-empty-dm : Tr.chat-empty-general;
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        // Editing one of our messages: say so, and give Escape a
        // visible way out.
        if State.editing : Rectangle {
            height: State.touch-host ? 44px : 26px;
            border-radius: Theme.radius-sm;
            background: Theme.bg-secondary;
            HorizontalLayout {
                padding-left: Theme.gap-sm;
                padding-right: 2px;
                spacing: Theme.gap-xs;
                Rectangle {
                    width: 14px;
                    IconDisplay {
                        icon: IconSet.Pencil;
                        size: 14px;
                        stroke: Theme.accent;
                    }
                }
                Text {
                    text: Tr.chat-editing;
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                IconBtn {
                    // Finger-sized on a touch host (review 2026-10,
                    // P3-18); the bar grows with it.
                    size: State.touch-host ? 40px : 22px;
                    icon-size: 14px;
                    icon: IconSet.X;
                    clicked => { Logic.edit-cancel(); }
                }
            }
        }

        // Composer. The extra top padding keeps the newest message
        // clear of the field.
        HorizontalLayout {
            padding-top: Theme.gap-sm;
            spacing: Theme.gap-sm;
            emoji-btn := IconBtn {
                icon: IconSet.Smile;
                tooltip: Tr.chat-emoji-tooltip;
                clicked => { emoji-pop.show(); }
            }
            IconBtn {
                icon: IconSet.Paperclip;
                tooltip: Tr.chat-attach-tooltip;
                clicked => { Logic.attach-image(); }
            }
            // capture-key-pressed runs BEFORE the focused TextInput:
            // Enter sends (Shift+Enter falls through and inserts the
            // newline — the input is multi-line now), and Ctrl/Cmd+V
            // reaches the host's paste chain (copied file → native
            // PNG → toolkit image → text) instead of the plain
            // text-only default. Everything else falls through.
            paste-scope := FocusScope {
                horizontal-stretch: 1;
                // A FocusScope is not a layout, so it doesn't report
                // the field's grown height to the row —
                // without this the row stays 40px and the field spills
                // past the window bottom. With it, the row grows and
                // the history shrinks: the composer expands upward.
                height: input.height;
                capture-key-pressed(ev) => {
                    if (ev.text == Key.Return && !ev.modifiers.shift) {
                        input.commit-composition();
                        Logic.send-message();
                        return accept;
                    }
                    if (ev.text == Key.Escape && State.editing) {
                        Logic.edit-cancel();
                        return accept;
                    }
                    // Deterministic Shift+Enter: splice the newline
                    // ourselves (platforms disagree on whether a
                    // shifted Return reaches the TextInput's insert
                    // path).
                    if (ev.text == Key.Return && ev.modifiers.shift) {
                        Logic.composer-newline(input.cursor-offset, input.anchor-offset);
                        return accept;
                    }
                    // Select all, explicitly: ⌘A on macOS (Slint reports
                    // ⌘ as `control` there) and Ctrl+A elsewhere. Handled
                    // here rather than left to the input so it cannot
                    // depend on which shortcut table the input consults.
                    if (ev.modifiers.control && !ev.modifiers.meta && !ev.modifiers.alt
                        && (ev.text == "a" || ev.text == "A")) {
                        input.select-all();
                        return accept;
                    }
                    // macOS line navigation (Ctrl+A / Ctrl+E, like
                    // every NSTextView). Slint swaps Apple modifiers —
                    // Cmd arrives as `control`, the physical Ctrl key
                    // as `meta` — so the physical-Ctrl test is `meta`.
                    // The key's text under Ctrl may be the control
                    // character rather than the letter, hence both.
                    if (Platform.os == OperatingSystemType.macos
                        && ev.modifiers.meta && !ev.modifiers.control
                        && (ev.text == "a" || ev.text == "A" || ev.text == "\u{1}")) {
                        Logic.composer-line-edge(input.cursor-offset, false);
                        return accept;
                    }
                    if (Platform.os == OperatingSystemType.macos
                        && ev.modifiers.meta && !ev.modifiers.control
                        && (ev.text == "e" || ev.text == "E" || ev.text == "\u{5}")) {
                        Logic.composer-line-edge(input.cursor-offset, true);
                        return accept;
                    }
                    // ⌘← / ⌘→ to the line edges, ⌘↑ / ⌘↓ to the start
                    // and end of the draft, as in every macOS text view.
                    if (Platform.os == OperatingSystemType.macos
                        && ev.modifiers.control && !ev.modifiers.meta) {
                        if (ev.text == Key.LeftArrow) {
                            Logic.composer-line-edge(input.cursor-offset, false);
                            return accept;
                        }
                        if (ev.text == Key.RightArrow) {
                            Logic.composer-line-edge(input.cursor-offset, true);
                            return accept;
                        }
                        if (ev.text == Key.UpArrow) {
                            input.set-cursor(0);
                            return accept;
                        }
                        if (ev.text == Key.DownArrow) {
                            Logic.composer-doc-end();
                            return accept;
                        }
                    }
                    if ((ev.modifiers.control || ev.modifiers.meta) && (ev.text == "v" || ev.text == "V")) {
                        Logic.paste-rich();
                        return accept;
                    }
                    reject
                }
                input := ComposerField {
                    placeholder: State.active-dm >= 0
                        ? Tr.chat-placeholder-dm + " " + State.conv-name
                        : "";
                    text <=> State.draft;
                    edited => { Logic.draft-edited(); }
                    context(x, y) => {
                        Logic.composer-context(x, y, input.cursor-offset, input.anchor-offset);
                    }
                }
            }
            // Narrow: only once the limit is near — on a phone the
            // field needs the room more.
            if !root.narrow || State.draft.character-count > State.max-chars - 50 : Text {
                width: 52px;
                text: "\{State.draft.character-count}/\{State.max-chars}";
                color: State.draft.character-count > State.max-chars - 20
                    ? Theme.warning : Theme.text-muted;
                font-size: Theme.font-sm;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            send-btn := Rectangle {
                width: 44px;
                height: 40px;
                border-radius: Theme.radius-md;
                background: st.has-hover ? Theme.accent-hover : Theme.accent;
                animate background { duration: 150ms; }
                IconDisplay {
                    icon: IconSet.Send;
                    size: 18px;
                    stroke: Theme.on-accent;
                }
                st := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        input.commit-composition();
                        Logic.send-message();
                    }
                }
            }
        }
    }

    // ── Unseen messages, and the way to them ───────────────────────
    // Scrolled up while messages arrived: how many, centered at the
    // jump button's height, just above the composer (the host counts them, `State.chat-new-*`;
    // being back at the bottom zeroes it). Either goes to the newest.
    if State.chat-new-count > 0 && !root.stick-to-bottom : Rectangle {
        height: 28px;
        width: new-row.preferred-width + 2 * Theme.gap-md;
        x: col.x + list-box.x + (list-box.width - self.width) / 2;
        y: col.y + list-box.y + list-box.height - Theme.gap-xs - 18px - self.height / 2;
        border-radius: 14px;
        background: nt.has-hover ? Theme.accent.brighter(10%) : Theme.accent;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000055;
        animate background { duration: 150ms; }
        new-row := HorizontalLayout {
            alignment: center;
            spacing: Theme.gap-xs;
            Rectangle {
                width: 14px;
                IconDisplay {
                    icon: IconSet.ArrowDown;
                    size: 14px;
                    stroke: Theme.on-accent;
                }
            }
            Text {
                text: State.chat-new-label;
                color: Theme.on-accent;
                font-size: Theme.font-sm;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        nt := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pin-to-bottom(); }
        }
    }

    if !root.stick-to-bottom : jump-btn := Rectangle {
        width: 36px;
        height: 36px;
        border-radius: 18px;
        // Over the list's last few px, just above the composer. The
        // list's own x/y are inside its frame: the frame places it.
        x: col.x + list-box.x + list-box.width - self.width - Theme.gap-sm;
        y: col.y + list-box.y + list-box.height - self.height - Theme.gap-xs;
        background: jt.has-hover ? Theme.subtle : Theme.bg-tertiary;
        border-width: 1px;
        border-color: Theme.border;
        animate background { duration: 150ms; }
        IconDisplay {
            icon: IconSet.ChevronDown;
            size: 18px;
            stroke: Theme.text-secondary;
        }
        jt := TouchArea {
            mouse-cursor: pointer;
            // Stuck from here on, and followed until the end stops
            // moving: one scroll-to-end lands on an estimate.
            clicked => { root.pin-to-bottom(); }
        }
    }

    // ── Emoji palette (in-window popover) ──────────────────────────
    emoji-pop := PopupWindow {
        x: Theme.gap-md;
        y: root.height - 400px;
        width: Math.min(392px, root.width - 2 * Theme.gap-md);
        height: 340px;
        // Shortcode of the hovered cell, shown in the footer bar
        // (Slack-style): ":heart:" while the heart is under the mouse.
        property <string> hovered-code;
        Rectangle {
            background: Theme.bg-tertiary;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            // A ListView, so only the rows in view exist: as one
            // layout the palette built all 344 cells — about a thousand
            // items — every time it opened (review P3-38).
            emoji-list := ListView {
                // As many 40 px cells as the width holds (8 at the full
                // 392 px), gap-xs between: a fixed 8 lost its last
                // column under 388 px, a phone's width (review 2026-10,
                // P2-21). A finger pans it (ANDROID-SPEC.md D27).
                property <int> cols: Math.max(1, Math.floor((self.width + Theme.gap-xs) / (40px + Theme.gap-xs)));
                mouse-drag-pan-enabled: State.touch-host;
                x: Theme.gap-sm; y: Theme.gap-sm;
                width: parent.width - 2 * Theme.gap-sm;
                height: parent.height - 2 * Theme.gap-sm - 26px;
                for r in Math.ceil(State.emoji.length / self.cols) : Rectangle {
                    // The row and the gap under it: a ListView has no
                    // spacing of its own.
                    height: 40px + Theme.gap-xs;
                    HorizontalLayout {
                        y: 0px;
                        height: 40px;
                        alignment: start;
                        spacing: Theme.gap-xs;
                        for c in emoji-list.cols : Rectangle {
                            width: 40px;
                            property <int> idx: r * emoji-list.cols + c;
                            border-radius: Theme.radius-sm;
                            background: et.has-hover ? Theme.hover : transparent;
                            if idx < State.emoji.length : Text {
                                text: State.emoji[idx].glyph;
                                font-size: 24px;
                                // Ask the platform's color-emoji face
                                // directly: generic fallback mishandles
                                // VS16 sequences on the Skia raster
                                // path (the palette's tofu boxes).
                                font-family: Platform.os == OperatingSystemType.macos
                                    || Platform.os == OperatingSystemType.ios
                                    ? "Apple Color Emoji"
                                    : Platform.os == OperatingSystemType.windows
                                        ? "Segoe UI Emoji"
                                        : "Noto Color Emoji";
                            }
                            et := TouchArea {
                                mouse-cursor: pointer;
                                changed has-hover => {
                                    if (self.has-hover && idx < State.emoji.length) {
                                        emoji-pop.hovered-code = ":\{State.emoji[idx].code}:";
                                    } else if (!self.has-hover && idx < State.emoji.length
                                        && emoji-pop.hovered-code == ":\{State.emoji[idx].code}:") {
                                        emoji-pop.hovered-code = "";
                                    }
                                }
                                clicked => {
                                    if (idx < State.emoji.length) {
                                        Logic.emoji-picked(State.emoji[idx].glyph);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // Footer bar: hovered shortcode.
            Rectangle {
                x: 1px;
                y: parent.height - 25px;
                width: parent.width - 2px;
                height: 24px;
                background: Theme.surface;
                Text {
                    x: Theme.gap-sm;
                    height: 100%;
                    vertical-alignment: center;
                    text: emoji-pop.hovered-code;
                    color: Theme.text-muted;
                    font-size: Theme.font-sm;
                }
            }
        }
    }
}
