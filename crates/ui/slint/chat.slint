// chat.slint — rich chat history + composer.
//
// The FLTK build's 1,500-line custom-drawn ChatView collapses into a
// ListView over a row model. Row kinds:
//   0 message  — [12:34] name  body (wraps)
//   1 system   — muted italic notice
//   2 image    — header + rounded inline image; GIFs animate (the shell
//                swaps frames into `image` on a slint::Timer, autoplay
//                ~3 loops → freeze → hover replay), click opens the
//                gallery viewer, right-click offers save/open
//   3 code     — ```-fenced block as a monospace panel (links stay
//                inline in message rows: the markdown translator
//                linkifies them for StyledText)
//
// Context menus are the window's own overlay (main.slint), filled by
// the host from app-core's `menu`: copy / select / edit / delete for
// messages, open / save for images, cut / copy / paste in the
// composer. A right-click reaches a row's TouchArea because the
// read-only TextInputs ignore every button but the left one; a
// StyledText accepts them all, so on a formatted body the menu opens
// from the header, the gutter or the margin.
//
// The composer: emoji + attach icon buttons, the input, live counter
// (amber past 380), send. The emoji palette is an in-window popover —
// the entire FLTK focus-churn saga (Unfocus debounce, generation
// guards, deferred teardown) is retired by construction.

import { ListView } from "std-widgets.slint";
import { IconSet, IconDisplay } from "@lucide";
import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { State, Logic, ChatRow } from "globals.slint";
import { IconBtn, AvatarTile } from "widgets.slint";

// ── Rows ────────────────────────────────────────────────────────────────
//
// Two densities (Settings → General → Chat). Cozy, the default, is
// Slack's shape: a gutter with the author's picture, a header (name,
// time) on the first message of a run, bodies below; a continuation
// (same author within five minutes) shows only its body, aligned.
// Compact is one line per message: name, time, body.

/// The author's picture in the gutter, on the first row of a run.
/// Hovering it summons the profile card (the host maps the name to
/// the roster row; someone who left gets none).
component Gutter inherits Rectangle {
    in property <ChatRow> data;
    in property <bool> head;
    /// A right-click on the picture: the row opens its menu there
    /// (the tile's own TouchArea would otherwise swallow it).
    callback context(x: length, y: length);
    width: Theme.chat-gutter;
    if head : tile := Rectangle {
        x: Theme.gap-sm;
        y: 0px;
        width: 36px;
        height: 36px;
        AvatarTile {
            source: data.avatar;
            has-image: data.has-avatar;
            initial: data.initial;
            tint: data.tile-tint;
            side: 36px;
            corner: 8px;
            ring-room: false;
        }
        TouchArea {
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                    root.context(self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
            }
            changed has-hover => {
                if (self.has-hover) {
                    State.card-x = tile.absolute-position.x;
                    State.card-y = tile.absolute-position.y;
                    State.card-anchor-h = tile.height;
                }
                Logic.author-hovered(data.user, self.has-hover);
            }
        }
    }
}

/// Name and time, on the first row of a run.
component RowHeader inherits HorizontalLayout {
    in property <ChatRow> data;
    spacing: Theme.gap-sm;
    height: Theme.chat-header;
    Text {
        text: data.user;
        color: data.has-name-color ? data.name-color : Theme.accent-text;
        font-size: Theme.font-body;
        font-weight: data.name-style == 2 ? 600 : 700;
        font-italic: data.name-style == 2;
        vertical-alignment: center;
    }
    if State.show-timestamps : Text {
        text: data.ts;
        color: Theme.text-muted;
        font-size: Theme.font-sm;
        vertical-alignment: center;
    }
    Rectangle { }
}

component MessageRow inherits Rectangle {
    in property <ChatRow> data;
    /// StyledText cannot be selected with the mouse, so a styled row
    /// can be switched to its selectable plain view (menu, or a
    /// double-click on the text) and back.
    in property <bool> select-mode: false;
    callback select-requested(bool);

    property <bool> cozy: !State.compact-rows;
    property <bool> head: !data.continuation;
    // Which view is up: the selectable input for plain rows and for
    // styled rows in select mode, the StyledText otherwise.
    property <bool> plain-view: !data.styled || root.select-mode;
    property <length> top: root.cozy ? (root.head ? Theme.gap-sm : 2px) : (root.head ? 4px : 1px);
    property <length> header-h: root.cozy && root.head ? Theme.chat-header : 0px;
    height: root.top + root.header-h + cell.height + (root.cozy ? 4px : 3px);
    // The roster's hover, here too: the TouchArea wraps the content,
    // so its hover holds over the text bodies as well.
    border-radius: Theme.radius-sm;
    background: ctx.has-hover ? Theme.hover : transparent;
    animate background { duration: 100ms; }

    // Under everything: the read-only body ignores right-clicks, so
    // they land here and open the row's menu.
    ctx := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                Logic.row-context(data, root.select-mode,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
        Rectangle {
        if root.cozy : Gutter {
            x: 0px;
            y: root.top;
            height: 36px;
            data: data;
            head: root.head;
            context(x, y) => { Logic.row-context(data, root.select-mode, x, y); }
        }
        if root.cozy && root.head : RowHeader {
            x: Theme.chat-gutter;
            y: root.top;
            width: parent.width - Theme.chat-gutter - Theme.gap-sm;
            data: data;
        }
        // Compact: name and time inline, in front of the body. Always
        // instantiated (hidden in cozy) so the cell can read its width.
        compact-head := HorizontalLayout {
            x: Theme.gap-sm;
            y: root.top;
            height: cell.height;
            visible: !root.cozy && root.head;
            spacing: Theme.gap-sm;
            Text {
                text: data.user;
                color: data.has-name-color ? data.name-color : Theme.accent-text;
                font-size: Theme.font-body;
                font-weight: data.name-style == 2 ? 600 : 700;
                font-italic: data.name-style == 2;
            }
            if State.show-timestamps : Text {
                text: data.ts;
                color: Theme.text-muted;
                font-size: Theme.font-sm;
                vertical-alignment: center;
            }
        }

        // Plain messages render in a read-only TextInput (mouse
        // selection + Ctrl/Cmd+C); styled ones in a StyledText
        // (inline bold/italic/code — not selectable, but the
        // right-click Copy still grabs the raw text). Both live in
        // one cell; `visible` picks the active one and the cell
        // tracks its height. A deleted message keeps its header and
        // shows a muted placeholder instead.
        cell := Rectangle {
            x: root.cozy ? Theme.chat-gutter
                : root.head ? Theme.gap-sm + compact-head.preferred-width + Theme.gap-sm
                : Theme.gap-sm + 20px;
            y: root.top + root.header-h;
            width: parent.width - self.x - Theme.gap-sm
                - (data.edited && !root.plain-view && !data.deleted ? mark.preferred-width + Theme.gap-sm : 0px);
            height: data.deleted ? gone.preferred-height
                : root.plain-view ? body.preferred-height
                : styled-body.preferred-height;
            // Under the StyledText: a double-click on the text
            // (off a link) switches to the selectable view.
            if data.styled && !root.select-mode : TouchArea {
                double-clicked => { root.select-requested(true); }
            }
            body := TextInput {
                x: 0;
                y: 0;
                width: 100%;
                visible: root.plain-view && !data.deleted;
                text: data.edited ? "\{data.body} \{Tr.chat-edited-mark}" : data.body;
                read-only: true;
                single-line: false;
                // Sent and waiting for the server: muted until acked.
                color: data.pending ? Theme.text-muted : Theme.text-secondary;
                font-size: Theme.font-body;
                wrap: word-wrap;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.on-accent;
                // A key on a read-only row: printable characters go
                // to the composer (see Logic.type-through); the
                // rest (⌘C, arrows) stays here for the selection.
                key-pressed(ev) => {
                    if (!ev.modifiers.control && !ev.modifiers.meta && !ev.modifiers.alt
                        && ev.text != "") {
                        Logic.type-through(ev.text);
                        return accept;
                    }
                    reject
                }
            }
            styled-body := StyledText {
                x: 0;
                y: 0;
                width: 100%;
                visible: !root.plain-view && !data.deleted;
                text: data.body-styled;
                default-color: Theme.text-secondary;
                default-font-size: Theme.font-body;
                link-color: Theme.accent-text;
                link-clicked(url) => { Logic.link-clicked(url); }
            }
            gone := Text {
                x: 0;
                y: 0;
                width: 100%;
                visible: data.deleted;
                text: Tr.chat-deleted-placeholder;
                color: Theme.text-muted;
                font-size: Theme.font-body;
                font-italic: true;
            }
        }
        // The mark for a styled body: StyledText is pre-parsed, so it
        // sits beside the cell rather than inside the text.
        mark := Text {
            x: cell.x + cell.width + Theme.gap-sm;
            y: cell.y;
            visible: data.edited && !root.plain-view && !data.deleted;
            text: Tr.chat-edited-mark;
            color: Theme.text-muted;
            font-size: Theme.font-sm;
        }
        }
    }
}

component SystemRow inherits Rectangle {
    in property <ChatRow> data;
    height: body.preferred-height + 6px;
    // Read-only input rather than Text: an invite code or a server
    // notice is something people select and copy.
    HorizontalLayout {
        padding-left: Theme.gap-sm;
        padding-right: Theme.gap-sm;
        padding-top: 3px;
        body := TextInput {
            text: data.body;
            read-only: true;
            single-line: false;
            color: Theme.text-muted;
            font-size: Theme.font-sm;
            font-italic: true;
            wrap: word-wrap;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-accent;
            // A key on a read-only row: printable characters go
            // to the composer (see Logic.type-through); the
            // rest (⌘C, arrows) stays here for the selection.
            key-pressed(ev) => {
                if (!ev.modifiers.control && !ev.modifiers.meta && !ev.modifiers.alt
                    && ev.text != "") {
                    Logic.type-through(ev.text);
                    return accept;
                }
                reject
            }
        }
    }
}

/// "Thursday, August 27th" between two days, on a rule.
// ── File card (spec §7) ─────────────────────────────────────────────────
// A bordered card under the usual header: a type glyph, the name, the
// size, and Save. Nothing is previewed or opened; Save fetches the
// bytes into the Downloads folder.
component FileRow inherits Rectangle {
    in property <ChatRow> data;
    in property <bool> cozy: !State.compact-rows;
    in property <bool> head: !data.continuation;
    in property <length> top: root.cozy && root.head ? Theme.gap-xs : 2px;
    height: root.top + (root.cozy && root.head ? 20px : 0px) + 60px + Theme.gap-xs;
    // The roster's hover, here too: the TouchArea wraps the content,
    // so its hover holds over the text bodies as well.
    border-radius: Theme.radius-sm;
    background: ctx.has-hover ? Theme.hover : transparent;
    animate background { duration: 100ms; }

    ctx := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                Logic.row-context(data, false,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
        Rectangle {
        if root.cozy : Gutter {
            x: 0px;
            y: root.top;
            height: 36px;
            data: data;
            head: root.head;
            context(x, y) => { Logic.row-context(data, false, x, y); }
        }
        if root.cozy && root.head : RowHeader {
            x: Theme.chat-gutter;
            y: root.top;
            width: parent.width - Theme.chat-gutter - Theme.gap-md;
            data: data;
        }
        card := Rectangle {
            x: root.cozy ? Theme.chat-gutter : Theme.gap-sm;
            y: root.top + (root.cozy && root.head ? 20px : 0px);
            width: Math.min(360px, parent.width - self.x - Theme.gap-md);
            height: 60px;
            border-radius: Theme.radius-md;
            background: Theme.bg-secondary;
            border-width: 1px;
            border-color: Theme.border;
            opacity: data.pending ? 0.6 : 1.0;
            HorizontalLayout {
                padding: Theme.gap-sm;
                spacing: Theme.gap-sm;
                // The type word in a tile, where an image would be.
                Rectangle {
                    width: 44px;
                    border-radius: Theme.radius-sm;
                    background: Theme.bg-tertiary;
                    Text {
                        text: data.file-kind;
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        font-weight: 700;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: data.body;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        font-weight: 500;
                        overflow: elide;
                    }
                    // The size — or, while bytes move, what is
                    // happening and how far along.
                    Text {
                        text: data.transfer-kind == 1
                            ? Tr.file-uploading-pct + " " + data.transfer-pct + "%"
                            : data.transfer-kind == 2
                            ? Tr.file-downloading-pct + " " + data.transfer-pct + "%"
                            : data.file-meta;
                        color: data.transfer-kind != 0 ? Theme.accent-text : Theme.text-muted;
                        font-size: Theme.font-xs;
                        overflow: elide;
                    }
                }
                // Already saved: a check and Open, with a small
                // re-download beside them.
                if data.transfer-kind == 0 && data.file-saved : HorizontalLayout {
                    spacing: Theme.gap-xs;
                    Rectangle {
                        width: 16px;
                        IconDisplay {
                            icon: IconSet.Check;
                            size: 16px;
                            stroke: Theme.success;
                        }
                    }
                    Rectangle {
                        width: open-lbl.preferred-width + 2 * Theme.gap-sm;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 28px;
                            border-radius: Theme.radius-sm;
                            background: open-t.has-hover ? Theme.hover : Theme.bg-tertiary;
                            animate background { duration: 150ms; }
                            open-lbl := Text {
                                text: Tr.file-open;
                                color: Theme.text-primary;
                                font-size: Theme.font-sm;
                                font-weight: 500;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            open-t := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { Logic.file-open(data.row-id); }
                            }
                        }
                    }
                    Rectangle {
                        width: 28px;
                        IconBtn {
                            y: (parent.height - self.height) / 2;
                            size: 28px;
                            icon-size: 14px;
                            icon: IconSet.Download;
                            tooltip: Tr.file-save-again;
                            clicked => { Logic.file-save(data.row-id); }
                        }
                    }
                }
                Rectangle {
                    width: data.file-saved && data.transfer-kind == 0 ? 0px
                        : data.transfer-kind != 0 ? 28px + Theme.gap-xs + 28px
                        : save-lbl.preferred-width + 2 * Theme.gap-sm;
                    // Save — or a turning ring while a transfer runs.
                    if data.transfer-kind == 0 && !data.file-saved : Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 28px;
                        border-radius: Theme.radius-sm;
                        background: save-t.has-hover ? Theme.hover : Theme.bg-tertiary;
                        animate background { duration: 150ms; }
                        Text {
                            text: Tr.file-save;
                            color: Theme.text-primary;
                            font-size: Theme.font-sm;
                            font-weight: 500;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        save-t := TouchArea {
                            enabled: !data.pending;
                            mouse-cursor: pointer;
                            clicked => { Logic.file-save(data.row-id); }
                        }
                    }
                    // A ring that fills with the percent: determinate,
                    // so it says how far, not just that something moves.
                    // The ✕ beside it stops the transfer.
                    if data.transfer-kind != 0 : Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 28px;
                        height: 28px;
                        property <float> frac: Math.clamp(data.transfer-pct, 0, 100) / 100;
                        property <angle> sweep: frac * 360deg;
                        property <float> ex: 9 + 8 * Math.sin(sweep);
                        property <float> ey: 9 - 8 * Math.cos(sweep);
                        Path {
                            x: 5px;
                            y: 5px;
                            width: 18px;
                            height: 18px;
                            viewbox-width: 18;
                            viewbox-height: 18;
                            commands: "M 9 1 A 8 8 0 1 1 8.99 1";
                            stroke: Theme.subtle;
                            stroke-width: 2px;
                        }
                        Path {
                            x: 5px;
                            y: 5px;
                            width: 18px;
                            height: 18px;
                            viewbox-width: 18;
                            viewbox-height: 18;
                            commands: parent.frac >= 0.999
                                ? "M 9 1 A 8 8 0 1 1 8.99 1"
                                : "M 9 1 A 8 8 0 \{parent.frac > 0.5 ? 1 : 0} 1 \{parent.ex} \{parent.ey}";
                            stroke: Theme.accent-text;
                            stroke-width: 2px;
                            stroke-line-cap: round;
                        }
                    }
                    if data.transfer-kind != 0 : IconBtn {
                        x: 28px + Theme.gap-xs;
                        y: (parent.height - self.height) / 2;
                        size: 28px;
                        icon-size: 14px;
                        icon: IconSet.X;
                        tooltip: Tr.file-cancel;
                        clicked => { Logic.file-cancel(data.row-id); }
                    }
                    // Measured off-screen so the slot keeps its width
                    // whichever face shows.
                    save-lbl := Text {
                        text: Tr.file-save;
                        font-size: Theme.font-sm;
                        font-weight: 500;
                        visible: false;
                    }
                }
            }
            // A progress rail along the bottom edge.
            if data.transfer-kind != 0 : Rectangle {
                x: 0;
                y: parent.height - 3px;
                height: 3px;
                width: parent.width * Math.clamp(data.transfer-pct, 0, 100) / 100;
                background: Theme.accent-text;
                animate width { duration: 150ms; }
            }
        }
        }
    }
}

component DayMarkerRow inherits Rectangle {
    in property <ChatRow> data;
    height: 34px;
    HorizontalLayout {
        padding-left: Theme.gap-sm;
        padding-right: Theme.gap-sm;
        spacing: Theme.gap-md;
        Rectangle {
            height: 1px;
            y: (parent.height - 1px) / 2;
            background: Theme.border;
            horizontal-stretch: 1;
        }
        Rectangle {
            // Never wider than the row: an unwrapped label's width is
            // a *minimum* the ListView adopts as its viewport width,
            // and that is a horizontal scrollbar.
            width: Math.min(label.preferred-width + 2 * Theme.gap-md, root.width * 0.8);
            height: 24px;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: Theme.bg-secondary;
            border-width: 1px;
            border-color: Theme.border;
            label := Text {
                width: parent.width - 2 * Theme.gap-sm;
                text: data.body;
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
        Rectangle {
            height: 1px;
            y: (parent.height - 1px) / 2;
            background: Theme.border;
            horizontal-stretch: 1;
        }
    }
}

component CodeRow inherits Rectangle {
    in property <ChatRow> data;
    property <bool> cozy: !State.compact-rows;
    property <bool> head: !data.continuation;
    property <length> top: root.head ? (root.cozy ? Theme.gap-sm : 4px) : 2px;
    property <length> header-h: root.head ? Theme.chat-header : 0px;
    property <length> left: root.cozy ? Theme.chat-gutter : Theme.gap-sm;
    height: root.top + root.header-h + panel.height + 6px;
    // The roster's hover, here too: the TouchArea wraps the content,
    // so its hover holds over the text bodies as well.
    border-radius: Theme.radius-sm;
    background: ctx.has-hover ? Theme.hover : transparent;
    animate background { duration: 100ms; }
    ctx := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                Logic.row-context(data, false,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
        Rectangle {
        if root.cozy : Gutter {
            x: 0px;
            y: root.top;
            height: 36px;
            data: data;
            head: root.head;
            context(x, y) => { Logic.row-context(data, false, x, y); }
        }
        if root.head : RowHeader {
            x: root.left;
            y: root.top;
            width: parent.width - root.left - Theme.gap-sm;
            data: data;
        }
        VerticalLayout {
            x: root.left;
            y: root.top + root.header-h;
            width: parent.width - root.left - Theme.gap-sm;
            panel := Rectangle {
                height: code.preferred-height + 2 * Theme.gap-sm;
                background: Theme.surface;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;
                // Manually positioned (no layout) so long lines can't
                // inflate ancestors; read-only TextInput keeps code
                // selectable — the thing people copy most.
                code := TextInput {
                    x: Theme.gap-sm;
                    y: Theme.gap-sm;
                    width: parent.width - 2 * Theme.gap-sm;
                    text: data.body;
                    read-only: true;
                    single-line: false;
                    wrap: word-wrap;
                    color: Theme.mono-text;
                    font-family: "monospace";
                    font-size: Theme.font-sm;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.on-accent;
                    // A key on a read-only row: printable characters go
                    // to the composer (see Logic.type-through); the
                    // rest (⌘C, arrows) stays here for the selection.
                    key-pressed(ev) => {
                        if (!ev.modifiers.control && !ev.modifiers.meta && !ev.modifiers.alt
                            && ev.text != "") {
                            Logic.type-through(ev.text);
                            return accept;
                        }
                        reject
                    }
                }
            }
        }
        }
    }
}

component ImageRow inherits Rectangle {
    in property <ChatRow> data;

    // Fit within 360×280 like before, and never wider than the view.
    property <length> avail: root.width - root.left - Theme.gap-sm;
    property <float> maxw: Math.min(360.0, avail / 1px);
    property <float> scale: Math.min(1.0, Math.min(
        maxw / Math.max(1.0, data.img-w),
        280.0 / Math.max(1.0, data.img-h)));
    property <length> disp-w: Math.max(1.0, data.img-w * scale) * 1px;
    property <length> disp-h: Math.max(1.0, data.img-h * scale) * 1px;

    property <bool> cozy: !State.compact-rows;
    property <bool> head: !data.continuation;
    property <length> top: root.head ? (root.cozy ? Theme.gap-sm : 4px) : 2px;
    property <length> header-h: root.head ? Theme.chat-header : 0px;
    property <length> left: root.cozy ? Theme.chat-gutter : Theme.gap-sm;
    height: root.top + root.header-h + disp-h + 6px;
    // The roster's hover, here too: the TouchArea wraps the content,
    // so its hover holds over the text bodies as well.
    border-radius: Theme.radius-sm;
    background: ctx.has-hover ? Theme.hover : transparent;
    animate background { duration: 100ms; }

    ctx := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                Logic.row-context(data, false,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
        Rectangle {
        if root.cozy : Gutter {
            x: 0px;
            y: root.top;
            height: 36px;
            data: data;
            head: root.head;
            context(x, y) => { Logic.row-context(data, false, x, y); }
        }
        if root.head : RowHeader {
            x: root.left;
            y: root.top;
            width: parent.width - root.left - Theme.gap-sm;
            data: data;
        }
        VerticalLayout {
            x: root.left;
            y: root.top + root.header-h;
            width: parent.width - root.left - Theme.gap-sm;
            HorizontalLayout {
                frame := Rectangle {
                    width: root.disp-w;
                    height: root.disp-h;
                    border-radius: Theme.radius-md;
                    background: Theme.surface;
                    clip: true;
                    Image {
                        width: 100%;
                        height: 100%;
                        source: data.image;
                        image-fit: contain;
                    }
                    // On its way up: muted, with the ring, the percent
                    // and a ✕ over the picture (the file card's look).
                    if data.transfer-kind != 0 : Rectangle {
                        background: #00000088;
                        border-radius: Theme.radius-md;
                        HorizontalLayout {
                            alignment: center;
                            spacing: Theme.gap-sm;
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: Theme.gap-sm;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        property <float> frac: Math.clamp(data.transfer-pct, 0, 100) / 100;
                                        property <angle> sweep: frac * 360deg;
                                        property <float> ex: 9 + 8 * Math.sin(sweep);
                                        property <float> ey: 9 - 8 * Math.cos(sweep);
                                        Path {
                                            x: 5px; y: 5px; width: 18px; height: 18px;
                                            viewbox-width: 18; viewbox-height: 18;
                                            commands: "M 9 1 A 8 8 0 1 1 8.99 1";
                                            stroke: #FFFFFF55;
                                            stroke-width: 2px;
                                        }
                                        Path {
                                            x: 5px; y: 5px; width: 18px; height: 18px;
                                            viewbox-width: 18; viewbox-height: 18;
                                            commands: parent.frac >= 0.999
                                                ? "M 9 1 A 8 8 0 1 1 8.99 1"
                                                : "M 9 1 A 8 8 0 \{parent.frac > 0.5 ? 1 : 0} 1 \{parent.ex} \{parent.ey}";
                                            stroke: white;
                                            stroke-width: 2px;
                                            stroke-line-cap: round;
                                        }
                                    }
                                    Text {
                                        text: Tr.file-uploading-pct + " " + data.transfer-pct + "%";
                                        color: white;
                                        font-size: Theme.font-sm;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    IconBtn {
                                        size: 28px;
                                        icon-size: 14px;
                                        icon: IconSet.X;
                                        tooltip: Tr.file-cancel;
                                        clicked => { Logic.file-cancel(data.row-id); }
                                    }
                                }
                            }
                        }
                    }
                    it := TouchArea {
                        enabled: data.transfer-kind == 0;
                        mouse-cursor: pointer;
                        clicked => { Logic.row-open-image(data.row-id); }
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                Logic.row-context(data, false,
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                            }
                        }
                        changed has-hover => {
                            if (data.is-gif) { Logic.gif-hover(data.row-id, self.has-hover); }
                        }
                    }
                }
                Rectangle { }   // left-align the image
            }
        }
        }
    }
}

// ── Composer + history ──────────────────────────────────────────────────

component ComposerField inherits Rectangle {
    in-out property <string> text <=> input.text;
    /// A right-click anywhere on the field (the input ignores the
    /// button; the Flickable only intercepts the left one).
    callback context(x: length, y: length);
    // UTF-8 byte offsets, the unit set-selection-offsets consumes —
    // forwarded to the host for cursor-relative edits.
    out property <int> cursor-offset <=> input.cursor-position-byte-offset;
    out property <int> anchor-offset <=> input.anchor-position-byte-offset;
    callback edited;
    public function focus-input() { input.focus(); }
    public function set-cursor(pos: int) { input.set-selection-offsets(pos, pos); }
    public function select-all() { input.select-all(); }
    public function do-cut() { input.cut(); }
    public function do-copy() { input.copy(); }
    public function do-paste() { input.paste(); }

    // Grows with the draft like Discord: one line at rest, up to ~5
    // lines, then scrolls internally with the caret kept visible.
    // Wrapping means content pressure is vertical only, and the
    // explicit clamp caps it — nothing can inflate the composer row
    // sideways (Enter/Shift+Enter routing lives in the enclosing
    // FocusScope's capture handler).
    height: clamp(input.preferred-height + 16px, 40px, 124px);
    min-width: 120px;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    animate border-color { duration: 150ms; }

    in property <string> placeholder;
    TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.context(self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }
    // The hint for an empty draft: the room, or the person.
    if root.placeholder != "" && input.text == "" : Text {
        x: Theme.gap-md;
        y: 0;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-muted;
        font-size: Theme.font-body;
        vertical-alignment: center;
    }

    fl := Flickable {
        x: Theme.gap-md;
        y: 8px;
        width: parent.width - 2 * Theme.gap-md;
        height: parent.height - 16px;
        viewport-height: max(self.height, input.preferred-height);
        input := TextInput {
            width: fl.width;
            // Fill the field when the draft fits so a single line
            // centers vertically; taller drafts take their natural
            // height and scroll.
            height: max(fl.height, self.preferred-height);
            vertical-alignment: center;
            single-line: false;
            wrap: word-wrap;
            font-size: Theme.font-body;
            color: Theme.text-primary;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-accent;
            edited => { root.edited(); }
            cursor-position-changed(pos) => {
                if (pos.y + fl.viewport-y < 0px) {
                    fl.viewport-y = -pos.y;
                } else if (pos.y + fl.viewport-y + 20px > fl.height) {
                    fl.viewport-y = fl.height - pos.y - 20px;
                }
            }
        }
    }
}

export component ChatPane inherits Rectangle {
    background: Theme.bg-primary;

    public function scroll-to-end() {
        list.viewport-y = -Math.max(0px, list.viewport-height - list.visible-height);
    }
    /// Pin and go to the newest row: after sending, and after a
    /// conversation switch.
    public function pin-to-bottom() {
        root.stick-to-bottom = true;
        root.follow-pending = true;
        root.scroll-to-end();
    }
    /// True when the user is at (or within ~40px of) the bottom — the
    /// shell asks before appending, to preserve read position.
    public pure function at-bottom() -> bool {
        return list.viewport-height <= list.visible-height
            || list.viewport-y <= -(list.viewport-height - list.visible-height - 40px);
    }
    public function focus-composer() { input.focus-input(); }
    public function composer-set-cursor(pos: int) { input.set-cursor(pos); }
    public function composer-cut() { input.do-cut(); }
    public function composer-copy() { input.do-copy(); }
    /// The host appended rows: if the reader was at the bottom, follow
    /// them — on the layout pass that measures them, not now (a
    /// scroll-to-end right after a push reads the old height).
    public function follow-appended() {
        if (root.stick-to-bottom) { root.follow-pending = true; }
    }

    // Maintained by the ListView's changed-handlers below; also drives
    // the jump-to-latest button.
    private property <bool> stick-to-bottom: true;
    // A follow is owed: appended rows (or a pin) are waiting for the
    // ListView to measure them. Cleared once the exact bottom is
    // reached, or the moment the reader scrolls up.
    private property <bool> follow-pending: false;
    // Nudge to the end once a frame until it lands — a timer, not a
    // `changed viewport-height` handler: that one ran on every
    // virtualization refinement while scrolling and stacked into the
    // runtime's "long callback/instantiation chain" warning. Bounded,
    // so a follow that can never land does not tick forever.
    private property <int> follow-ticks: 0;
    Timer {
        interval: 16ms;
        running: root.follow-pending;
        triggered => {
            root.scroll-to-end();
            root.follow-ticks += 1;
            if (list.at-exact-bottom() || root.follow-ticks > 60) {
                root.follow-pending = false;
                root.follow-ticks = 0;
            }
        }
    }

    col := VerticalLayout {
        padding: Theme.gap-md;
        spacing: Theme.gap-sm;

        // ── Conversation header (spec §6): where you are. General
        // says so too (the `#`, and how many are here); a DM has the
        // person, a way back, and on a memory-mode server the fact
        // that nothing is kept.
        if State.active-dm < 0 : Rectangle {
            height: general-head.preferred-height + 2 * Theme.gap-sm;
            border-radius: Theme.radius-sm;
            background: Theme.bg-secondary;
            general-head := HorizontalLayout {
                padding-left: Theme.gap-sm;
                padding-right: Theme.gap-sm;
                spacing: Theme.gap-sm;
                // The same slot the DM header's back button takes, so
                // the title sits at one x in both.
                Rectangle {
                    width: 28px;
                    IconDisplay {
                        icon: IconSet.Hash;
                        size: 18px;
                        stroke: Theme.accent-text;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 1;
                    Text {
                        text: Tr.dm-general;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        font-weight: 600;
                        overflow: elide;
                    }
                    // The server's greeting (it used to be a chat line
                    // on every login), then who is here.
                    if State.greeting != "" : Text {
                        text: State.greeting;
                        color: Theme.text-secondary;
                        font-size: Theme.font-sm;
                        overflow: elide;
                    }
                    Text {
                        text: State.users-count-label;
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                        overflow: elide;
                    }
                }
            }
        }
        if State.active-dm >= 0 : Rectangle {
            height: dm-head.preferred-height + 2 * Theme.gap-sm;
            border-radius: Theme.radius-sm;
            background: Theme.bg-secondary;
            dm-head := HorizontalLayout {
                padding-left: Theme.gap-sm;
                padding-right: Theme.gap-xs;
                spacing: Theme.gap-sm;
                IconBtn {
                    size: 28px;
                    icon-size: 16px;
                    icon: IconSet.ArrowLeft;
                    tooltip: Tr.dm-back;
                    tooltip-below: true;
                    clicked => { Logic.general-clicked(); }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 1;
                    Text {
                        text: State.conv-name;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: State.server-persistent ? Tr.dm-direct-message : Tr.dm-note-memory;
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                        overflow: elide;
                    }
                }
            }
        }

        // Standing notice on a memory-mode server (spec §1.1): what
        // is decided here lasts until the server restarts.
        if !State.server-persistent : Rectangle {
            height: banner.preferred-height + 2 * Theme.gap-sm;
            border-radius: Theme.radius-sm;
            background: Theme.warning.with-alpha(0.12);
            border-width: 1px;
            border-color: Theme.warning.with-alpha(0.5);
            HorizontalLayout {
                padding-left: Theme.gap-md;
                padding-right: Theme.gap-md;
                spacing: Theme.gap-sm;
                Rectangle {
                    width: 14px;
                    IconDisplay {
                        icon: IconSet.TriangleAlert;
                        size: 14px;
                        stroke: Theme.warning;
                    }
                }
                banner := Text {
                    text: Tr.banner-not-persistent;
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }

        // "Load earlier": appears once the reader reaches the top and
        // the server said older pages exist; the page is put in front.
        if State.history-more && list.viewport-y >= -2px : Rectangle {
            height: 28px;
            border-radius: Theme.radius-sm;
            background: le.has-hover && !State.history-loading ? Theme.hover : transparent;
            animate background { duration: 150ms; }
            HorizontalLayout {
                alignment: center;
                spacing: Theme.gap-xs;
                Rectangle {
                    width: 14px;
                    IconDisplay {
                        icon: State.history-loading ? IconSet.LoaderCircle : IconSet.History;
                        size: 14px;
                        stroke: Theme.text-secondary;
                    }
                }
                Text {
                    text: State.history-loading ? Tr.chat-loading : Tr.chat-load-earlier;
                    color: State.history-loading ? Theme.text-muted : Theme.text-secondary;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                }
            }
            le := TouchArea {
                enabled: !State.history-loading;
                mouse-cursor: pointer;
                clicked => { Logic.load-earlier(); }
            }
        }

        list := ListView {
            vertical-stretch: 1;
            // Follow the tail reactively: while the user sits at the
            // bottom, content growth (new rows, GIF reflow) and window
            // resizes keep the newest message in view; scrolling up
            // unpins, scrolling back to within 40px re-pins. These fire
            // AFTER the layout recomputes, unlike a host-side
            // scroll-after-push, which reads stale viewport-height and
            // lands short (permanently, once an image row overshoots
            // the 40px slack).
            // Pin/unpin rules, in priority order:
            //   1. Landing EXACTLY at the bottom pins — regardless of
            //      direction, so programmatic scroll-to-end (including
            //      the upward correction after history-cap shrinks)
            //      keeps following.
            //   2. Any other upward movement unpins immediately. The
            //      slack must NOT keep the pin on the way *up*: a
            //      virtualized ListView refines its estimated
            //      viewport-height while older rows instantiate, and a
            //      still-pinned state snap-scrolls the user back on
            //      every wheel notch ("impossible to scroll up").
            //   3. Arriving *downward* within the slack of the bottom
            //      pins too. The same estimate refinement means a
            //      wheel-down that visibly reaches the end can leave the
            //      viewport a few px short of the exact bottom; without
            //      this rule nothing pinned and new rows landed out of
            //      view. The one-time snap the pin causes is what the
            //      person just asked for.
            //   4. Anything else keeps the current state, so mid-layout
            //      geometry never unpins spuriously.
            //   5. A follow — appended rows, a pin — is owed only until
            //      the exact bottom is reached, and never against a
            //      reader who scrolls up. Following on *every* height
            //      change fought a scrollbar drag: dragging near the
            //      bottom instantiates rows, the estimate refines, and
            //      the snap-back held the thumb there.
            private property <length> last-viewport-y;
            pure function at-exact-bottom() -> bool {
                self.viewport-y <= -(self.viewport-height - self.visible-height) + 2px
            }
            pure function near-bottom() -> bool {
                self.viewport-y <= -(self.viewport-height - self.visible-height) + 48px
            }
            changed viewport-y => {
                if (self.at-exact-bottom()) {
                    root.stick-to-bottom = true;
                    root.follow-pending = false;
                    root.follow-ticks = 0;
                } else if (self.viewport-y > self.last-viewport-y + 0.25px) {
                    root.stick-to-bottom = false;
                    root.follow-pending = false;
                    root.follow-ticks = 0;
                } else if (self.viewport-y < self.last-viewport-y - 0.25px && self.near-bottom()) {
                    root.stick-to-bottom = true;
                }
                self.last-viewport-y = self.viewport-y;
            }
            // A resize cannot coincide with a drag: keep the tail in view.
            changed visible-height => { if (root.stick-to-bottom) { root.scroll-to-end(); } }
            for row[i] in State.chat : Rectangle {
                // One delegate per row, hosting only the matching kind.
                // `if`, not `visible`: an invisible instance still
                // hands the ListView its minimum width, and a day
                // marker's pill sized to a message body was a
                // horizontal scrollbar. ListView virtualizes, so only
                // on-screen rows exist.
                height: cell.preferred-height;
                cell := VerticalLayout {
                    if row.kind == 0 : MessageRow {
                        data: row;
                        select-mode: State.selecting-row == row.row-id;
                        select-requested(on) => { State.selecting-row = on ? row.row-id : -1; }
                    }
                    if row.kind == 1 : SystemRow { data: row; }
                    if row.kind == 2 : ImageRow { data: row; }
                    if row.kind == 3 : CodeRow { data: row; }
                    if row.kind == 4 : DayMarkerRow { data: row; }
                    if row.kind == 5 : FileRow { data: row; }
                }
            }
        }

        // Editing one of our messages: say so, and give Escape a
        // visible way out.
        if State.editing : Rectangle {
            height: 26px;
            border-radius: Theme.radius-sm;
            background: Theme.bg-secondary;
            HorizontalLayout {
                padding-left: Theme.gap-sm;
                padding-right: 2px;
                spacing: Theme.gap-xs;
                Rectangle {
                    width: 14px;
                    IconDisplay {
                        icon: IconSet.Pencil;
                        size: 14px;
                        stroke: Theme.accent;
                    }
                }
                Text {
                    text: Tr.chat-editing;
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                IconBtn {
                    size: 22px;
                    icon-size: 14px;
                    icon: IconSet.X;
                    clicked => { Logic.edit-cancel(); }
                }
            }
        }

        // Composer. The extra top padding keeps the newest message
        // clear of the field.
        HorizontalLayout {
            padding-top: Theme.gap-sm;
            spacing: Theme.gap-sm;
            emoji-btn := IconBtn {
                icon: IconSet.Smile;
                tooltip: Tr.chat-emoji-tooltip;
                clicked => { emoji-pop.show(); }
            }
            IconBtn {
                icon: IconSet.Paperclip;
                tooltip: Tr.chat-attach-tooltip;
                clicked => { Logic.attach-image(); }
            }
            IconBtn {
                icon: IconSet.BrushCleaning;
                tooltip: Tr.chat-clear-tooltip;
                clicked => { Logic.clear-chat(); }
            }
            // capture-key-pressed runs BEFORE the focused TextInput:
            // Enter sends (Shift+Enter falls through and inserts the
            // newline — the input is multi-line now), and Ctrl/Cmd+V
            // reaches the host's paste chain (copied file → native
            // PNG → toolkit image → text) instead of the plain
            // text-only default. Everything else falls through.
            paste-scope := FocusScope {
                horizontal-stretch: 1;
                // A FocusScope is not a layout, so it doesn't report
                // the field's grown height to the row —
                // without this the row stays 40px and the field spills
                // past the window bottom. With it, the row grows and
                // the history shrinks: the composer expands upward.
                height: input.height;
                capture-key-pressed(ev) => {
                    if (ev.text == Key.Return && !ev.modifiers.shift) {
                        Logic.send-message();
                        return accept;
                    }
                    if (ev.text == Key.Escape && State.editing) {
                        Logic.edit-cancel();
                        return accept;
                    }
                    // Deterministic Shift+Enter: splice the newline
                    // ourselves (platforms disagree on whether a
                    // shifted Return reaches the TextInput's insert
                    // path).
                    if (ev.text == Key.Return && ev.modifiers.shift) {
                        Logic.composer-newline(input.cursor-offset, input.anchor-offset);
                        return accept;
                    }
                    // Select all, explicitly: ⌘A on macOS (Slint reports
                    // ⌘ as `control` there) and Ctrl+A elsewhere. Handled
                    // here rather than left to the input so it cannot
                    // depend on which shortcut table the input consults.
                    if (ev.modifiers.control && !ev.modifiers.meta && !ev.modifiers.alt
                        && (ev.text == "a" || ev.text == "A")) {
                        input.select-all();
                        return accept;
                    }
                    // macOS line navigation (Ctrl+A / Ctrl+E, like
                    // every NSTextView). Slint swaps Apple modifiers —
                    // Cmd arrives as `control`, the physical Ctrl key
                    // as `meta` — so the physical-Ctrl test is `meta`.
                    // The key's text under Ctrl may be the control
                    // character rather than the letter, hence both.
                    if (Platform.os == OperatingSystemType.macos
                        && ev.modifiers.meta && !ev.modifiers.control
                        && (ev.text == "a" || ev.text == "A" || ev.text == "\u{1}")) {
                        Logic.composer-line-edge(input.cursor-offset, false);
                        return accept;
                    }
                    if (Platform.os == OperatingSystemType.macos
                        && ev.modifiers.meta && !ev.modifiers.control
                        && (ev.text == "e" || ev.text == "E" || ev.text == "\u{5}")) {
                        Logic.composer-line-edge(input.cursor-offset, true);
                        return accept;
                    }
                    // ⌘← / ⌘→ to the line edges, ⌘↑ / ⌘↓ to the start
                    // and end of the draft, as in every macOS text view.
                    if (Platform.os == OperatingSystemType.macos
                        && ev.modifiers.control && !ev.modifiers.meta) {
                        if (ev.text == Key.LeftArrow) {
                            Logic.composer-line-edge(input.cursor-offset, false);
                            return accept;
                        }
                        if (ev.text == Key.RightArrow) {
                            Logic.composer-line-edge(input.cursor-offset, true);
                            return accept;
                        }
                        if (ev.text == Key.UpArrow) {
                            input.set-cursor(0);
                            return accept;
                        }
                        if (ev.text == Key.DownArrow) {
                            Logic.composer-doc-end();
                            return accept;
                        }
                    }
                    if ((ev.modifiers.control || ev.modifiers.meta) && (ev.text == "v" || ev.text == "V")) {
                        Logic.paste-rich();
                        return accept;
                    }
                    reject
                }
                input := ComposerField {
                    placeholder: State.active-dm >= 0
                        ? Tr.chat-placeholder-dm + " " + State.conv-name
                        : "";
                    text <=> State.draft;
                    edited => { Logic.draft-edited(); }
                    context(x, y) => { Logic.composer-context(x, y); }
                }
            }
            counter := Text {
                width: 52px;
                text: "\{State.draft.character-count}/\{State.max-chars}";
                color: State.draft.character-count > State.max-chars - 20
                    ? Theme.warning : Theme.text-muted;
                font-size: Theme.font-sm;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            send-btn := Rectangle {
                width: 44px;
                height: 40px;
                border-radius: Theme.radius-md;
                background: st.has-hover ? Theme.accent-hover : Theme.accent;
                animate background { duration: 150ms; }
                IconDisplay {
                    icon: IconSet.Send;
                    size: 18px;
                    stroke: Theme.on-accent;
                }
                st := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Logic.send-message(); }
                }
            }
        }
    }

    // ── Jump to latest (WhatsApp-style) ────────────────────────────
    if !root.stick-to-bottom : jump-btn := Rectangle {
        width: 36px;
        height: 36px;
        border-radius: 18px;
        x: col.x + list.x + list.width - self.width - Theme.gap-sm;
        y: col.y + list.y + list.height - self.height - Theme.gap-sm;
        background: jt.has-hover ? Theme.subtle : Theme.bg-tertiary;
        border-width: 1px;
        border-color: Theme.border;
        animate background { duration: 150ms; }
        IconDisplay {
            icon: IconSet.ChevronDown;
            size: 18px;
            stroke: Theme.text-secondary;
        }
        jt := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.scroll-to-end(); }
        }
    }

    // ── Emoji palette (in-window popover) ──────────────────────────
    emoji-pop := PopupWindow {
        x: Theme.gap-md;
        y: root.height - 400px;
        width: Math.min(392px, root.width - 2 * Theme.gap-md);
        height: 340px;
        // Shortcode of the hovered cell, shown in the footer bar
        // (Slack-style): ":heart:" while the heart is under the mouse.
        property <string> hovered-code;
        Rectangle {
            background: Theme.bg-tertiary;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            Flickable {
                x: Theme.gap-sm; y: Theme.gap-sm;
                width: parent.width - 2 * Theme.gap-sm;
                height: parent.height - 2 * Theme.gap-sm - 26px;
                viewport-height: grid.preferred-height;
                grid := VerticalLayout {
                    // 8 columns of 40px cells, gap-xs breathing room
                    property <int> cols: 8;
                    spacing: Theme.gap-xs;
                    for r in Math.ceil(State.emoji.length / self.cols) : HorizontalLayout {
                        height: 40px;
                        spacing: Theme.gap-xs;
                        for c in grid.cols : Rectangle {
                            width: 40px;
                            property <int> idx: r * grid.cols + c;
                            border-radius: Theme.radius-sm;
                            background: et.has-hover ? Theme.hover : transparent;
                            if idx < State.emoji.length : Text {
                                text: State.emoji[idx].glyph;
                                font-size: 24px;
                                // Ask the platform's color-emoji face
                                // directly: generic fallback mishandles
                                // VS16 sequences on the Skia raster
                                // path (the palette's tofu boxes).
                                font-family: Platform.os == OperatingSystemType.macos
                                    ? "Apple Color Emoji"
                                    : Platform.os == OperatingSystemType.windows
                                        ? "Segoe UI Emoji"
                                        : "Noto Color Emoji";
                            }
                            et := TouchArea {
                                mouse-cursor: pointer;
                                changed has-hover => {
                                    if (self.has-hover && idx < State.emoji.length) {
                                        emoji-pop.hovered-code = ":\{State.emoji[idx].code}:";
                                    } else if (!self.has-hover && idx < State.emoji.length
                                        && emoji-pop.hovered-code == ":\{State.emoji[idx].code}:") {
                                        emoji-pop.hovered-code = "";
                                    }
                                }
                                clicked => {
                                    if (idx < State.emoji.length) {
                                        Logic.emoji-picked(State.emoji[idx].glyph);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // Footer bar: hovered shortcode.
            Rectangle {
                x: 1px;
                y: parent.height - 25px;
                width: parent.width - 2px;
                height: 24px;
                background: Theme.surface;
                Text {
                    x: Theme.gap-sm;
                    height: 100%;
                    vertical-alignment: center;
                    text: emoji-pop.hovered-code;
                    color: Theme.text-muted;
                    font-size: Theme.font-sm;
                }
            }
        }
    }
}
