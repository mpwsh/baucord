// settings.slint — the settings window.
//
// Left nav (Profile / General / Audio / Keyboard / Servers / Debug /
// About),
// scrollable content, Save & close + Reset row. Narrow (the Android
// page on a phone held upright): the nav is a page of its own and a
// section opens over it, with a back arrow (ANDROID-SPEC.md D28).
//
// Live semantics carry over: every control applies immediately through
// a callback (per keystroke / per tick), persistence happens when the
// window closes. Meters read levels the shell pushes at 8 Hz while the
// window is open (the shell stops the timer on close).
//
// Layout grammar, the same on every tab: a `PanelHeader` (what this
// tab is about, one line), then `Setting` groups — label, control,
// optional hint — with one spacing token between groups and a smaller
// one inside them, so the eye reads label→control→hint as one unit.

import { ScrollView, ListView, AboutSlint, Palette } from "std-widgets.slint";
import { Icon, IconSet, IconDisplay } from "@lucide";
import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { State, KeybindRow, ServerRow, LicenseRow } from "globals.slint";
import { Btn, IconBtn, Field, FieldLabel, Hint, SectionHeader, Sep, HSlider, VuMeter, GateMeter, Dropdown, CheckRow } from "widgets.slint";

/// Someone this account blocked on the connected server (1.2).
export struct BlockedRow {
    user-id: string,        // hex, for Unblock
    name: string,
}

export global SettingsState {
    // ── Profile (spec §7.1: kept here, sent to servers in 1.1.2) ──
    in-out property <string> nickname;
    /// "On <server>: Member · Level 3", or a not-connected line.
    in property <string> role-line;
    in property <bool> connected: false;
    /// The palette (all pass 3:1 on the chat background; none in the
    /// gold band, which the server reserves for admins).
    in property <[color]> name-colors;
    in-out property <int> name-color-index: -1;  // -1 = theme default
    in property <[string]> name-styles;          // Normal / Bold / Italic
    in-out property <int> name-style-index: 0;
    in property <image> avatar;
    in property <bool> has-avatar: false;
    /// The nickname's first letter, for the avatar fallback (.slint
    /// has no substring).
    in property <string> initial: "?";
    /// Identity: this device's user id (the key's hash, shortened),
    /// where the key file lives, and the result of the last action.
    in property <string> identity-id;
    in property <string> identity-path;
    in property <string> identity-status;
    /// Regenerate asks twice: the first click arms, the second acts.
    in property <bool> identity-regenerate-armed: false;
    // ── This server (1.2, a server that takes them): who this account
    // blocked there, and deleting the account there for good.
    in property <bool> safety: false;
    in property <[BlockedRow]> blocked;
    /// The connected server's name, for the delete button's line.
    in property <string> account-server;
    /// Delete asks twice, like Regenerate.
    in property <bool> account-delete-armed: false;
    in property <string> account-status;    // "" hides the line

    // ── General ──
    in property <[string]> languages;         // ["System", "English", …]
    in-out property <int> language-index: 0;
    in property <[string]> text-sizes;        // Small / Default / Large / Larger
    in-out property <int> text-size-index: 1;
    in property <[string]> log-levels;        // Errors only … Trace
    in-out property <int> log-level-index: 2;
    in property <string> config-path;
    // Startup
    in-out property <bool> auto-connect: false;
    in-out property <bool> start-minimized: false;
    in property <bool> tray-available: false; // start-minimized needs the tray
    in-out property <bool> check-updates: true;
    // Sounds (their own tab): a master switch, then each one. Ordinary
    // chat messages never make a sound.
    in-out property <bool> sounds-enabled: true;
    in-out property <bool> join-leave-sounds: true;
    in-out property <bool> mention-sound: false;
    in-out property <bool> dm-sound: true;
    in-out property <bool> share-started-sound: true;
    in-out property <bool> viewer-joined-sound: true;
    // Notifications (phones only: ANDROID-SPEC.md D52, IOS-SPEC.md D50)
    in property <bool> notifications-available: false;
    in-out property <bool> notify-messages: true;
    in-out property <bool> notify-first-join: true;
    // Chat
    in-out property <bool> show-timestamps: true;
    in-out property <bool> compact-rows: false;
    in property <[string]> image-sizes;       // 512 KB … Max
    in-out property <int> image-size-index: 0;

    // ── Servers — the list plus the editor for the selected entry ──
    in property <[ServerRow]> servers;
    in-out property <int> server-index: 0;    // selected for editing
    in-out property <string> server-name;
    in-out property <string> server-ip;
    in-out property <string> server-port;
    in-out property <string> server-fingerprint;
    /// The code to present on the first visit, if any (a pasted link
    /// is accepted; only its code is kept).
    in-out property <string> server-invite-code;

    // ── Audio ──
    in property <[string]> input-devices;     // index 0 = "System default"
    in property <[string]> output-devices;
    in-out property <int> input-index: 0;
    in-out property <int> output-index: 0;
    in property <float> mic-level: 0.0;       // denoised, gate-scaled
    in property <float> out-level: 0.0;
    in-out property <float> gate-threshold: 0.02;
    in-out property <float> input-gain: 1.0;
    in-out property <float> output-gain: 1.0;
    in property <string> sensitivity-line;    // localized, host-formatted
    in property <bool> testing-mic: false;
    in property <string> test-hint;
    /// Voice activity / push to talk, and the PTT key as bound.
    in property <[string]> transmission-modes;
    in-out property <int> transmission-index: 0;
    in property <string> ptt-bind;
    /// Echo cancellation (AEC-SPEC.md §5): Automatic / Always / Off
    /// (audio::AecMode::ALL order), and what the open streams got,
    /// localized by the host ("" hides the line).
    in property <[string]> aec-modes;
    in-out property <int> aec-index: 0;
    in property <string> aec-status;
    /// Windows is lowering the user's other apps because of our call
    /// streams and would not be asked not to (AEC-SPEC.md E15).
    in property <bool> aec-lowering;

    // ── Keyboard ──
    in property <[KeybindRow]> keybinds;
    /// macOS without the Accessibility permission: a bound key works
    /// but is taken from every other program.
    in property <bool> keybinds-need-access;
    /// True while some row is recording — arms the window's key capture.
    in property <bool> capturing: false;

    // ── Debug ──
    /// This build writes a log file (a release desktop build, the
    /// phones); a debug desktop build logs to its terminal only.
    in property <bool> log-file-available: false;
    /// Where the file is and how big ("Log file: … (1.2 MB)").
    in property <string> log-file-line;
    /// The log's last 100 lines, oldest first ("" = empty).
    in property <string> log-tail;
    /// What the last send or clear did ("" hides the line).
    in property <string> debug-status;

    // ── About — host-formatted blocks ──
    in property <string> credits-super-heading;
    in property <[string]> credits-super;     // gold-highlighted honors
    in property <string> credits-beta-heading;
    in property <[string]> credits-testers;
    in property <string> about-head;      // version, url, paths
    in property <string> about-tech;      // "built with" roster

    // ── Licenses (1.2): the rows, opened ones expanded ──
    in property <[LicenseRow]> licenses;
}

export global SettingsLogic {
    // Profile
    callback nickname-edited(string);
    callback name-color-selected(int);        // -1 = default
    callback name-style-selected(int);
    callback avatar-pick();
    callback avatar-clear();
    // Identity (spec §3.3): the key file is the login.
    callback identity-export();
    callback identity-import();
    callback identity-regenerate();
    callback identity-regenerate-disarm();
    // This server (1.2)
    callback unblock(user-id: string);
    callback account-delete();
    callback account-delete-disarm();

    // General
    callback language-selected(int);
    callback text-size-selected(int);
    callback log-level-selected(int);
    callback open-config-folder();
    callback auto-connect-changed(bool);
    callback start-minimized-changed(bool);
    callback check-updates-changed(bool);
    callback sounds-enabled-changed(bool);
    callback join-leave-sounds-changed(bool);
    callback mention-sound-changed(bool);
    callback dm-sound-changed(bool);
    callback share-started-sound-changed(bool);
    callback viewer-joined-sound-changed(bool);
    callback notify-messages-changed(bool);
    callback notify-first-join-changed(bool);
    callback show-timestamps-changed(bool);
    callback compact-rows-changed(bool);
    callback image-size-selected(int);

    // Servers tab
    callback server-selected(int);
    callback server-set-default(int);
    callback server-add();
    callback server-remove();
    callback server-name-edited(string);
    callback server-ip-edited(string);
    callback server-port-edited(string);
    callback server-fingerprint-edited(string);
    callback server-invite-edited(string);

    // Audio
    callback input-device-selected(int);
    callback output-device-selected(int);
    callback gate-threshold-changed(float);
    callback input-gain-changed(float);
    callback output-gain-changed(float);
    callback toggle-test-mic();
    callback transmission-selected(int);
    callback aec-selected(int);
    /// Open the system's sound settings (Windows: Communications tab).
    callback open-sound-settings();

    // Keyboard
    callback record-keybind(int);
    /// Put up the system's prompt for watching keys (macOS).
    callback ask-keybind-access();
    /// A key landed while recording: (key-text, ctrl, alt, shift).
    /// The host filters bare modifiers and maps text → key codes.
    callback capture-key(string, bool, bool, bool);
    callback capture-cancel();
    callback capture-clear();

    // Debug: read the log again (the panel just opened), send its end
    // to the connected server, empty it.
    callback refresh-log();
    callback send-log();
    callback copy-log();
    callback clear-log();

    callback save-and-close();
    callback reset-defaults();
    callback closed();
    // Another tab is showing: the meters run on Audio only.
    callback tab-shown();
    /// Licenses: a component or license group opened or
    /// closed (`LicenseRow.entry`).
    callback license-toggled(int);
}

// ── Building blocks ────────────────────────────────────────────────────

component NavItem inherits Rectangle {
    in property <string> text;
    in property <Icon> icon;
    in property <bool> active;
    /// The narrow layout's list: a finger-sized row with a chevron
    /// (the row opens a page there rather than selecting a tab).
    in property <bool> tall: false;
    callback clicked;
    height: root.tall ? 48px : 36px;
    border-radius: Theme.radius-md;
    background: active ? Theme.accent : t.has-hover ? Theme.hover : transparent;
    animate background { duration: 150ms; }
    HorizontalLayout {
        padding-left: Theme.gap-md;
        padding-right: Theme.gap-md;
        spacing: Theme.gap-sm;
        Rectangle {
            width: 16px;
            IconDisplay {
                icon: root.icon;
                size: 16px;
                stroke: root.active ? Theme.on-accent : Theme.text-muted;
            }
        }
        Text {
            vertical-alignment: center;
            text: root.text;
            color: root.active ? Theme.on-accent : Theme.text-secondary;
            font-size: Theme.font-body;
            font-weight: root.active ? 600 : 400;
            horizontal-stretch: 1;
        }
        if root.tall : Rectangle {
            width: 16px;
            IconDisplay {
                icon: IconSet.ChevronRight;
                size: 16px;
                stroke: Theme.text-muted;
            }
        }
    }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// The first thing on a tab: what it is about, in one line.
component PanelHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> lead;
    spacing: 2px;
    padding-bottom: Theme.gap-xs;
    Text {
        text: root.title;
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 600;
    }
    if root.lead != "" : Text {
        text: root.lead;
        color: Theme.text-muted;
        font-size: Theme.font-sm;
        wrap: word-wrap;
    }
}

/// Label, control, optional hint — one unit.
/// A standing warning inside a panel: the icon and a text that wraps.
/// The same box as the chat's standing notice — its height follows the
/// wrapped text, which a layout alone gets wrong.
component WarningNote inherits Rectangle {
    in property <string> text;
    height: note.preferred-height + 2 * Theme.gap-sm;
    border-radius: Theme.radius-sm;
    background: Theme.warning.with-alpha(0.12);
    border-width: 1px;
    border-color: Theme.warning.with-alpha(0.5);
    HorizontalLayout {
        padding-left: Theme.gap-md;
        padding-right: Theme.gap-md;
        spacing: Theme.gap-sm;
        Rectangle {
            width: 14px;
            IconDisplay {
                icon: IconSet.TriangleAlert;
                size: 14px;
                stroke: Theme.warning;
            }
        }
        note := Text {
            text: root.text;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

component Setting inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: Theme.gap-xs;
    FieldLabel { text: root.label; }
    @children
    if root.hint != "" : Hint { text: root.hint; }
}

/// A round avatar with an initial as the fallback.
component AvatarView inherits Rectangle {
    in property <image> source;
    in property <bool> has-image: false;
    in property <string> initial;
    in property <length> diameter: 64px;
    width: diameter;
    height: diameter;
    border-radius: diameter / 2;
    background: has-image ? transparent : Theme.bg-tertiary;
    border-width: has-image ? 0px : 1px;
    border-color: Theme.border;
    clip: true;
    if has-image : Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: cover;
    }
    if !has-image : Text {
        text: root.initial;
        color: Theme.text-secondary;
        font-size: root.diameter * 0.4;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// One color in the palette; index -1 is "theme default".
component Swatch inherits Rectangle {
    in property <color> tint;
    in property <bool> is-default: false;
    in property <bool> selected: false;
    callback clicked;
    width: 28px;
    height: 28px;
    Rectangle {
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: root.is-default ? transparent : root.tint;
        border-width: root.is-default ? 2px : 0px;
        border-color: Theme.text-muted;
        if root.is-default : Rectangle {
            width: 2px;
            height: 22px;
            background: Theme.text-muted;
            transform-rotation: 45deg;
        }
    }
    // Selection ring, outside the dot so the color stays whole.
    if root.selected : Rectangle {
        width: 28px;
        height: 28px;
        border-radius: 14px;
        border-width: 2px;
        border-color: Theme.text-primary;
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── Panels ──────────────────────────────────────────────────────────────

component ProfilePanel inherits VerticalLayout {
    spacing: Theme.gap-lg;
    PanelHeader { title: Tr.tab-profile; lead: Tr.profile-lead; }

    // Who you are, as the roster would show it: the picture (with its
    // own change and remove controls) and the name preview.
    HorizontalLayout {
        spacing: Theme.gap-md;
        VerticalLayout {
            spacing: Theme.gap-xs;
            Rectangle {
                width: 64px;
                height: 64px;
                AvatarView {
                    source: SettingsState.avatar;
                    has-image: SettingsState.has-avatar;
                    initial: SettingsState.initial;
                }
                // Remove: a small ✕ on the picture's corner.
                if SettingsState.has-avatar : IconBtn {
                    x: 64px - 14px;
                    y: -6px;
                    size: 20px;
                    icon-size: 12px;
                    icon: IconSet.X;
                    tooltip: Tr.profile-avatar-remove;
                    tooltip-below: true;
                    clicked => { SettingsLogic.avatar-clear(); }
                }
            }
            Btn {
                text: Tr.profile-avatar-choose;
                clicked => { SettingsLogic.avatar-pick(); }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: SettingsState.nickname == "" ? Tr.profile-no-name : SettingsState.nickname;
                color: SettingsState.name-color-index >= 0
                    && SettingsState.name-color-index < SettingsState.name-colors.length
                    ? SettingsState.name-colors[SettingsState.name-color-index]
                    : Theme.text-primary;
                font-size: Theme.font-md;
                font-weight: SettingsState.name-style-index == 1 ? 700 : 500;
                font-italic: SettingsState.name-style-index == 2;
                overflow: elide;
            }
            Text {
                text: SettingsState.role-line;
                color: Theme.text-muted;
                font-size: Theme.font-sm;
                overflow: elide;
            }
        }
    }

    Setting {
        label: Tr.nickname;
        hint: Tr.profile-nickname-hint;
        Field {
            text <=> SettingsState.nickname;
            edited => { SettingsLogic.nickname-edited(self.text); }
        }
    }

    Setting {
        label: Tr.profile-name-color;
        VerticalLayout {
            spacing: Theme.gap-xs;
            HorizontalLayout {
                spacing: Theme.gap-xs;
                Swatch {
                    is-default: true;
                    selected: SettingsState.name-color-index < 0;
                    clicked => { SettingsState.name-color-index = -1; SettingsLogic.name-color-selected(-1); }
                }
                for i in 8 : Swatch {
                    tint: i < SettingsState.name-colors.length ? SettingsState.name-colors[i] : transparent;
                    selected: SettingsState.name-color-index == i;
                    clicked => { SettingsState.name-color-index = i; SettingsLogic.name-color-selected(i); }
                }
                Rectangle { }
            }
            HorizontalLayout {
                spacing: Theme.gap-xs;
                Rectangle { width: 28px; }
                // Nine slots: the 17th color is gold, on the palette
                // only for admins (the server refuses it otherwise).
                for i in 9 : Rectangle {
                    width: 28px;
                    height: 28px;
                    if i + 8 < SettingsState.name-colors.length : Swatch {
                        tint: SettingsState.name-colors[i + 8];
                        selected: SettingsState.name-color-index == i + 8;
                        clicked => { SettingsState.name-color-index = i + 8; SettingsLogic.name-color-selected(i + 8); }
                    }
                }
                Rectangle { }
            }
        }
    }

    Setting {
        label: Tr.profile-name-style;
        Dropdown {
            options: SettingsState.name-styles;
            current <=> SettingsState.name-style-index;
            selected(i) => { SettingsLogic.name-style-selected(i); }
        }
    }

    Sep { }

    // Identity: the device key is who you are on every server.
    SectionHeader { text: Tr.identity-header; }
    HorizontalLayout {
        spacing: Theme.gap-sm;
        Rectangle {
            width: 16px;
            IconDisplay { icon: IconSet.KeyRound; size: 16px; stroke: Theme.text-muted; }
        }
        Text {
            text: SettingsState.identity-id;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            font-family: "monospace";
            vertical-alignment: center;
        }
    }
    Hint { text: SettingsState.identity-path; }
    HorizontalLayout {
        spacing: Theme.gap-sm;
        Btn { text: Tr.identity-export; clicked => { SettingsLogic.identity-export(); } }
        Btn { text: Tr.identity-import; clicked => { SettingsLogic.identity-import(); } }
        // Armed on the first click, done on the second: a new key is a
        // new user, and the old one is gone for good.
        Btn {
            text: SettingsState.identity-regenerate-armed ? Tr.identity-regenerate-confirm : Tr.identity-regenerate;
            danger: SettingsState.identity-regenerate-armed;
            clicked => { SettingsLogic.identity-regenerate(); }
        }
        if SettingsState.identity-regenerate-armed : Btn {
            text: Tr.cancel;
            clicked => { SettingsLogic.identity-regenerate-disarm(); }
        }
        Rectangle { }   // keep the buttons their natural width
    }
    Hint { text: Tr.identity-note; }
    if SettingsState.identity-status != "" : Text {
        text: SettingsState.identity-status;
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        wrap: word-wrap;
    }

    // Blocked people, on the server this session is on: what you see
    // of them comes back the moment you unblock.
    Sep { }
    SectionHeader { text: Tr.blocked-header; }
    if !SettingsState.safety : Hint { text: Tr.blocked-not-connected; }
    if SettingsState.safety : VerticalLayout {
        spacing: Theme.gap-xs;
        Hint { text: Tr.blocked-lead; }
        if SettingsState.blocked.length == 0 : Text {
            text: Tr.blocked-none;
            color: Theme.text-muted;
            font-size: Theme.font-sm;
        }
        for b in SettingsState.blocked : HorizontalLayout {
            spacing: Theme.gap-sm;
            height: 36px;
            Text {
                text: b.name;
                color: Theme.text-primary;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Btn {
                text: Tr.unblock;
                clicked => { SettingsLogic.unblock(b.user-id); }
            }
        }
    }

    // Leaving a server for good: the account there and everything it
    // posted. Armed on the first click, done on the second.
    if SettingsState.safety : VerticalLayout {
        spacing: Theme.gap-sm;
        Sep { }
        SectionHeader { text: Tr.account-delete-header; }
        Hint { text: SettingsState.account-server; }
        Hint { text: Tr.account-delete-note; }
        HorizontalLayout {
            spacing: Theme.gap-sm;
            Btn {
                text: SettingsState.account-delete-armed ? Tr.account-delete-confirm : Tr.account-delete;
                danger: true;
                clicked => { SettingsLogic.account-delete(); }
            }
            if SettingsState.account-delete-armed : Btn {
                text: Tr.cancel;
                clicked => { SettingsLogic.account-delete-disarm(); }
            }
            Rectangle { }
        }
        if SettingsState.account-status != "" : Text {
            text: SettingsState.account-status;
            color: Theme.danger-text;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
    }
    Rectangle { }
}

component GeneralPanel inherits VerticalLayout {
    spacing: Theme.gap-lg;
    PanelHeader { title: Tr.tab-general; lead: Tr.general-lead; }
    Setting {
        label: Tr.language;
        hint: Tr.language-note;
        Dropdown {
            options: SettingsState.languages;
            current <=> SettingsState.language-index;
            selected(i) => { SettingsLogic.language-selected(i); }
        }
    }
    Setting {
        label: Tr.text-size;
        hint: Tr.text-size-hint;
        Dropdown {
            options: SettingsState.text-sizes;
            current <=> SettingsState.text-size-index;
            selected(i) => { SettingsLogic.text-size-selected(i); }
        }
    }

    Sep { }
    SectionHeader { text: Tr.startup-header; }
    VerticalLayout {
        spacing: 2px;
        CheckRow {
            text: Tr.startup-auto-connect;
            hint: Tr.startup-auto-connect-hint;
            checked <=> SettingsState.auto-connect;
            toggled(on) => { SettingsLogic.auto-connect-changed(on); }
        }
        if SettingsState.tray-available : CheckRow {
            text: Tr.startup-minimized;
            hint: Tr.startup-minimized-hint;
            checked <=> SettingsState.start-minimized;
            toggled(on) => { SettingsLogic.start-minimized-changed(on); }
        }
        CheckRow {
            text: Tr.startup-check-updates;
            hint: Tr.startup-check-updates-hint;
            checked <=> SettingsState.check-updates;
            toggled(on) => { SettingsLogic.check-updates-changed(on); }
        }
    }

    Sep { }
    SectionHeader { text: Tr.chat-header; }
    VerticalLayout {
        spacing: 2px;
        CheckRow {
            text: Tr.chat-show-timestamps;
            checked <=> SettingsState.show-timestamps;
            toggled(on) => { SettingsLogic.show-timestamps-changed(on); }
        }
        CheckRow {
            text: Tr.chat-compact-rows;
            checked <=> SettingsState.compact-rows;
            toggled(on) => { SettingsLogic.compact-rows-changed(on); }
        }
    }
    Setting {
        label: Tr.chat-image-size;
        hint: Tr.chat-image-size-hint;
        Dropdown {
            options: SettingsState.image-sizes;
            current <=> SettingsState.image-size-index;
            selected(i) => { SettingsLogic.image-size-selected(i); }
        }
    }

    Sep { }
    SectionHeader { text: Tr.files-header; }
    Hint { text: Tr.about-config-file + " " + SettingsState.config-path; }
    // A phone has no file manager that opens an app's private folder
    // (on iOS the share sheet would even offer the device key); the
    // path above says where it is.
    if !State.touch-host : HorizontalLayout {
        spacing: Theme.gap-sm;
        Btn {
            text: Tr.about-open-config;
            clicked => { SettingsLogic.open-config-folder(); }
        }
        Rectangle { }   // keep the button its natural width
    }
    Hint { text: Tr.files-note; }

    Sep { }
    SectionHeader { text: Tr.privacy-header; }
    Text {
        text: Tr.privacy-note;
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        wrap: word-wrap;
    }
    Rectangle { }
}

component ServersPanel inherits VerticalLayout {
    spacing: Theme.gap-lg;
    PanelHeader { title: Tr.tab-servers; lead: Tr.servers-lead; }

    // Saved servers. Clicking a row selects it for the editor below;
    // the radio dot on the left marks/sets the default (the entry the
    // connect screen preselects at startup).
    VerticalLayout {
        spacing: 2px;
        for srv[i] in SettingsState.servers : Rectangle {
            height: 48px;
            border-radius: Theme.radius-md;
            background: i == SettingsState.server-index ? Theme.bg-tertiary
                : row-t.has-hover ? Theme.hover : transparent;
            animate background { duration: 150ms; }
            row-t := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    SettingsState.server-index = i;
                    SettingsLogic.server-selected(i);
                }
            }
            HorizontalLayout {
                padding-left: Theme.gap-md;
                padding-right: Theme.gap-md;
                spacing: Theme.gap-md;
                // Default radio dot: sits above the row's TouchArea, so
                // a click both selects and sets the default.
                Rectangle {
                    width: 18px;
                    ring := Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        border-width: 2px;
                        border-color: srv.is-default ? Theme.accent
                            : dot-t.has-hover ? Theme.text-secondary : Theme.border;
                        if srv.is-default : Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.accent;
                        }
                        dot-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                SettingsState.server-index = i;
                                SettingsLogic.server-set-default(i);
                            }
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: srv.name;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: srv.address;
                        color: Theme.text-muted;
                        font-size: Theme.font-sm;
                        overflow: elide;
                    }
                }
                if srv.is-default : Text {
                    text: Tr.server-default;
                    color: Theme.accent-text;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                }
            }
        }
    }

    HorizontalLayout {
        spacing: Theme.gap-sm;
        Btn {
            width: Math.max(120px, self.preferred-width + 2 * Theme.gap-lg);
            text: Tr.server-add;
            clicked => { SettingsLogic.server-add(); }
        }
        Btn {
            width: Math.max(100px, self.preferred-width + 2 * Theme.gap-lg);
            text: Tr.server-remove;
            danger: true;
            enabled: SettingsState.servers.length > 1;
            clicked => { SettingsLogic.server-remove(); }
        }
        Rectangle { }
    }

    Sep { }

    // Editor for the selected entry — live like every other settings
    // control; the host mirrors keystrokes into the settings model.
    Setting {
        label: Tr.server-name;
        Field {
            text <=> SettingsState.server-name;
            edited => { SettingsLogic.server-name-edited(self.text); }
        }
    }
    HorizontalLayout {
        spacing: Theme.gap-sm;
        Setting {
            horizontal-stretch: 1;
            label: Tr.server-ip;
            Field {
                text <=> SettingsState.server-ip;
                edited => { SettingsLogic.server-ip-edited(self.text); }
            }
        }
        Setting {
            width: 110px;
            label: Tr.server-port;
            Field {
                // Under Field's 120 px floor: Slint 1.18 enforces a
                // child's min-width over this column's fixed width
                // (1.17 let the column win), which pushed the field
                // 10 px past the form's right edge.
                min-width: 80px;
                text <=> SettingsState.server-port;
                edited => { SettingsLogic.server-port-edited(self.text); }
            }
        }
    }
    Setting {
        label: Tr.invite-code;
        hint: Tr.server-invite-note;
        Field {
            text <=> SettingsState.server-invite-code;
            placeholder: Tr.invite-code-placeholder;
            edited => { SettingsLogic.server-invite-edited(self.text); }
        }
    }
    Setting {
        label: Tr.server-fingerprint;
        hint: Tr.server-config-note;
        Field {
            text <=> SettingsState.server-fingerprint;
            edited => { SettingsLogic.server-fingerprint-edited(self.text); }
        }
    }
    Rectangle { }
}

// ── Sounds ─────────────────────────────────────────────────────────────
// A master switch, then each sound: the picks are indented under it
// and greyed while it is off. Ordinary chat messages never sound.
component SoundsPanel inherits VerticalLayout {
    spacing: Theme.gap-lg;
    // Short panel: stack at the top instead of spreading over the
    // column's full height.
    alignment: start;
    PanelHeader { title: Tr.sounds-header; lead: Tr.sounds-lead; }

    // The global switch on its own, then every sound at one level,
    // greyed and inert while the switch is off.
    CheckRow {
        text: Tr.sounds-enabled;
        hint: Tr.sounds-enabled-hint;
        checked <=> SettingsState.sounds-enabled;
        toggled(on) => { SettingsLogic.sounds-enabled-changed(on); }
    }
    Sep { }
    VerticalLayout {
        spacing: 2px;
        CheckRow {
            text: Tr.sounds-join-leave;
            enabled: SettingsState.sounds-enabled;
            checked <=> SettingsState.join-leave-sounds;
            toggled(on) => { SettingsLogic.join-leave-sounds-changed(on); }
        }
        CheckRow {
            text: Tr.sounds-share-started;
            enabled: SettingsState.sounds-enabled;
            checked <=> SettingsState.share-started-sound;
            toggled(on) => { SettingsLogic.share-started-sound-changed(on); }
        }
        CheckRow {
            text: Tr.sounds-viewer-joined;
            hint: Tr.sounds-viewer-joined-hint;
            enabled: SettingsState.sounds-enabled;
            checked <=> SettingsState.viewer-joined-sound;
            toggled(on) => { SettingsLogic.viewer-joined-sound-changed(on); }
        }
        CheckRow {
            text: Tr.sounds-dm;
            enabled: SettingsState.sounds-enabled;
            checked <=> SettingsState.dm-sound;
            toggled(on) => { SettingsLogic.dm-sound-changed(on); }
        }
        CheckRow {
            text: Tr.sounds-mention;
            hint: Tr.sounds-mention-hint;
            enabled: SettingsState.sounds-enabled;
            checked <=> SettingsState.mention-sound;
            toggled(on) => { SettingsLogic.mention-sound-changed(on); }
        }
    }

    // A phone: what reaches you while the app is in the background.
    // The system shows these, so its silent and Do Not Disturb modes
    // apply — and to the message chimes above as well.
    if SettingsState.notifications-available : VerticalLayout {
        spacing: Theme.gap-lg;
        padding-top: Theme.gap-md;
        Sep { }
        PanelHeader { title: Tr.notifs-header; lead: Tr.notifs-lead; }
        VerticalLayout {
            spacing: 2px;
            CheckRow {
                text: Tr.notifs-messages;
                hint: Tr.notifs-messages-hint;
                checked <=> SettingsState.notify-messages;
                toggled(on) => { SettingsLogic.notify-messages-changed(on); }
            }
            CheckRow {
                text: Tr.notifs-first-join;
                hint: Tr.notifs-first-join-hint;
                checked <=> SettingsState.notify-first-join;
                toggled(on) => { SettingsLogic.notify-first-join-changed(on); }
            }
        }
    }
}

component AudioPanel inherits VerticalLayout {
    spacing: Theme.gap-lg;
    PanelHeader { title: Tr.tab-audio; lead: Tr.audio-lead; }
    Setting {
        label: Tr.audio-input-device;
        Dropdown {
            options: SettingsState.input-devices;
            current <=> SettingsState.input-index;
            selected(i) => { SettingsLogic.input-device-selected(i); }
        }
    }
    Setting {
        label: Tr.audio-output-device;
        hint: Tr.audio-output-hint;
        Dropdown {
            options: SettingsState.output-devices;
            current <=> SettingsState.output-index;
            selected(i) => { SettingsLogic.output-device-selected(i); }
        }
    }
    Setting {
        label: Tr.audio-aec;
        hint: Tr.audio-aec-hint;
        Dropdown {
            options: SettingsState.aec-modes;
            current <=> SettingsState.aec-index;
            selected(i) => { SettingsLogic.aec-selected(i); }
        }
        if SettingsState.aec-status != "" : Text {
            text: SettingsState.aec-status;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
        // What Windows does to the other apps, and the one place it can
        // be turned off (it goes away by itself once it is).
        if SettingsState.aec-lowering : WarningNote {
            text: Tr.aec-lowering;
        }
        if SettingsState.aec-lowering : HorizontalLayout {
            Btn {
                text: Tr.aec-lowering-fix;
                clicked => { SettingsLogic.open-sound-settings(); }
            }
            Rectangle { }   // keep the button its natural width
        }
    }
    Setting {
        label: Tr.audio-transmission;
        hint: SettingsState.transmission-index == 1
            ? (SettingsState.ptt-bind == "" ? Tr.audio-ptt-unbound : Tr.audio-ptt-hint + " " + SettingsState.ptt-bind)
            : Tr.audio-vad-hint;
        Dropdown {
            options: SettingsState.transmission-modes;
            current <=> SettingsState.transmission-index;
            selected(i) => { SettingsLogic.transmission-selected(i); }
        }
    }
    Sep { }
    SectionHeader { text: Tr.audio-input-header; }
    Setting {
        label: Tr.audio-capture-level;
        GateMeter {
            level: SettingsState.mic-level;
            threshold: SettingsState.gate-threshold;
        }
    }
    Setting {
        label: Tr.audio-input-gain;
        HorizontalLayout {
            spacing: Theme.gap-sm;
            HSlider {
                horizontal-stretch: 1;
                minimum: 0.0; maximum: 2.0;
                value <=> SettingsState.input-gain;
                live-changed(v) => { SettingsLogic.input-gain-changed(v); }
            }
            Text {
                width: 44px;
                text: "\{Math.round(SettingsState.input-gain * 100)}%";
                color: Theme.text-muted; font-size: Theme.font-sm;
                vertical-alignment: center; horizontal-alignment: right;
            }
        }
    }
    Setting {
        label: Tr.audio-input-sensitivity;
        hint: Tr.audio-gate-hint;
        HSlider {
            minimum: 0.005; maximum: 0.10;
            value <=> SettingsState.gate-threshold;
            live-changed(v) => { SettingsLogic.gate-threshold-changed(v); }
        }
        Hint { text: SettingsState.sensitivity-line; }
    }
    HorizontalLayout {
        spacing: Theme.gap-sm;
        Btn {
            text: SettingsState.testing-mic ? Tr.audio-stop-testing : Tr.audio-test-mic;
            engaged: SettingsState.testing-mic;
            clicked => { SettingsLogic.toggle-test-mic(); }
        }
        Hint {
            text: SettingsState.test-hint;
            color: SettingsState.testing-mic ? Theme.warning : Theme.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    Sep { }
    SectionHeader { text: Tr.audio-output-header; }
    VuMeter { level: SettingsState.out-level; }
    Setting {
        label: Tr.audio-master-volume;
        HorizontalLayout {
            spacing: Theme.gap-sm;
            HSlider {
                horizontal-stretch: 1;
                minimum: 0.0; maximum: 2.0;
                value <=> SettingsState.output-gain;
                live-changed(v) => { SettingsLogic.output-gain-changed(v); }
            }
            Text {
                width: 44px;
                text: "\{Math.round(SettingsState.output-gain * 100)}%";
                color: Theme.text-muted; font-size: Theme.font-sm;
                vertical-alignment: center; horizontal-alignment: right;
            }
        }
    }
    Rectangle { }
}

component KeyboardPanel inherits VerticalLayout {
    spacing: Theme.gap-lg;
    PanelHeader { title: Tr.tab-keyboard; lead: Tr.keybinds-hint; }
    // macOS without the Accessibility permission. The prompt comes
    // from this button and from nowhere else.
    if SettingsState.keybinds-need-access : VerticalLayout {
        spacing: Theme.gap-sm;
        WarningNote {
            text: Tr.keybinds-access;
        }
        HorizontalLayout {
            Btn {
                text: Tr.keybinds-access-ask;
                clicked => { SettingsLogic.ask-keybind-access(); }
            }
            Rectangle { }   // keep the button its natural width
        }
    }
    VerticalLayout {
        spacing: Theme.gap-xs;
        for kb[i] in SettingsState.keybinds : Rectangle {
            height: 44px;
            border-radius: Theme.radius-md;
            background: kb.recording ? Theme.bg-tertiary : transparent;
            animate background { duration: 150ms; }
            HorizontalLayout {
                padding-left: Theme.gap-sm;
                padding-right: Theme.gap-xs;
                spacing: Theme.gap-sm;
                Text {
                    text: kb.action-label;
                    color: Theme.text-primary;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Btn {
                    width: 180px;
                    text: kb.recording ? Tr.keybind-press-combo
                        : kb.bind == "" ? Tr.keybind-not-set : kb.bind;
                    engaged: kb.recording;
                    clicked => { SettingsLogic.record-keybind(i); }
                }
            }
        }
    }
    Rectangle { }
}

/// The log's last lines, small and monospace, in a box of its own that
/// scrolls. It follows the end as lines arrive, unless the reader has
/// scrolled up to read; scrolling back to the bottom follows again.
component LogView inherits Rectangle {
    in property <string> text;
    in property <string> empty-text;
    property <bool> follow: true;
    height: 300px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    clip: true;

    function to-end() {
        scroll.content-y = Math.min(0px, scroll.visible-height - scroll.content-height);
    }
    init => { root.to-end(); }
    changed text => {
        if (root.follow) {
            root.to-end();
        }
    }

    scroll := ScrollView {
        width: 100%;
        height: 100%;
        // A finger drags the text, as in the rest of Settings on a
        // phone (ANDROID-SPEC.md D27).
        mouse-drag-pan-enabled: State.touch-host;
        // Wrap at the box's width rather than scroll sideways.
        content-width: self.visible-width;
        scrolled => {
            root.follow = self.content-y <= self.visible-height - self.content-height + 4px;
        }
        VerticalLayout {
            padding: Theme.gap-sm;
            Text {
                text: root.text == "" ? root.empty-text : root.text;
                color: root.text == "" ? Theme.text-muted : Theme.text-secondary;
                font-family: "monospace";
                font-size: Theme.font-xs;
                wrap: word-wrap;
            }
        }
    }
}

/// For reporting a problem: how much is logged, the log's last lines,
/// and a way to get it out — to the server's admin, or onto the
/// clipboard to paste anywhere — or to empty it.
component DebugPanel inherits VerticalLayout {
    spacing: Theme.gap-lg;
    // The panel exists only while its tab shows: read the log now; the
    // settings timer reads it again every 2 s while it stays open.
    init => { SettingsLogic.refresh-log(); }
    PanelHeader { title: Tr.tab-debug; lead: Tr.debug-lead; }
    Setting {
        label: Tr.log-level;
        hint: Tr.log-level-hint;
        Dropdown {
            options: SettingsState.log-levels;
            current <=> SettingsState.log-level-index;
            selected(i) => { SettingsLogic.log-level-selected(i); }
        }
    }

    Sep { }
    SectionHeader { text: Tr.debug-log-header; }
    if !SettingsState.log-file-available : Hint { text: Tr.debug-no-log-file; }
    if SettingsState.log-file-available : VerticalLayout {
        spacing: Theme.gap-sm;
        // One row on a desktop; on a phone Send gets a row of its own,
        // so three buttons never crowd a narrow screen.
        if !State.touch-host : HorizontalLayout {
            spacing: Theme.gap-sm;
            Btn {
                text: Tr.debug-send-log;
                accent: true;
                enabled: SettingsState.connected;
                clicked => { SettingsLogic.send-log(); }
            }
            Btn {
                text: Tr.debug-copy-log;
                clicked => { SettingsLogic.copy-log(); }
            }
            Btn {
                text: Tr.debug-clear-log;
                clicked => { SettingsLogic.clear-log(); }
            }
            Rectangle { }   // keep the buttons their natural width
        }
        if State.touch-host : HorizontalLayout {
            Btn {
                text: Tr.debug-send-log;
                accent: true;
                enabled: SettingsState.connected;
                clicked => { SettingsLogic.send-log(); }
            }
            Rectangle { }
        }
        if State.touch-host : HorizontalLayout {
            spacing: Theme.gap-sm;
            Btn {
                text: Tr.debug-copy-log;
                clicked => { SettingsLogic.copy-log(); }
            }
            Btn {
                text: Tr.debug-clear-log;
                clicked => { SettingsLogic.clear-log(); }
            }
            Rectangle { }
        }
        Hint { text: Tr.debug-send-hint; }
        if SettingsState.debug-status != "" : Text {
            text: SettingsState.debug-status;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
    }
    if SettingsState.log-file-available : Setting {
        label: Tr.debug-tail-label;
        hint: SettingsState.log-file-line;
        LogView {
            text: SettingsState.log-tail;
            empty-text: Tr.debug-tail-empty;
        }
    }
    Rectangle { }
}

component AboutPanel inherits VerticalLayout {
    spacing: Theme.gap-lg;
    PanelHeader { title: Tr.tab-about; }
    Text {
        text: SettingsState.about-head;
        color: Theme.text-secondary;
        font-size: Theme.font-body;
        wrap: word-wrap;
    }
    Text {
        text: SettingsState.about-tech;
        color: Theme.text-secondary;
        font-size: Theme.font-body;
        wrap: word-wrap;
    }
    // Slint's royalty-free license asks for this widget in the About
    // screen (Settings → Licenses has the license). It
    // draws itself from the style's palette: the windows set it dark.
    HorizontalLayout {
        alignment: start;
        AboutSlint {
            width: 260px;
            height: self.min-height;
        }
    }
    Rectangle { }
}

/// A line of the licenses list: text that wraps, and the row exactly as
/// tall as it (sized from the text itself — a layout here reports one
/// line's height inside a ListView, and the rows overlapped).
component LicenseLine inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.text-muted;
    in property <length> indent: 32px;
    in property <length> above: 0px;
    in property <length> below: Theme.gap-sm;
    in property <int> weight: 400;
    height: root.above + body.preferred-height + root.below;
    body := Text {
        x: root.indent;
        y: root.above;
        // Clear of the scrollbar.
        width: parent.width - root.indent - 14px;
        text: root.text;
        color: root.tint;
        font-size: Theme.font-sm;
        font-weight: root.weight;
        wrap: word-wrap;
    }
}

/// A component or a license group: tap to open or close its text.
component LicenseEntry inherits Rectangle {
    in property <LicenseRow> data;
    height: Theme.gap-sm + name.preferred-height + 1px + detail.preferred-height + Theme.gap-sm;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.hover : transparent;
    IconDisplay {
        x: Theme.gap-sm;
        y: Theme.gap-sm + 3px;
        icon: root.data.open ? IconSet.ChevronDown : IconSet.ChevronRight;
        size: 16px;
        stroke: Theme.text-muted;
    }
    name := Text {
        x: 32px;
        y: Theme.gap-sm;
        width: parent.width - 32px - 14px;
        text: root.data.text;
        color: Theme.text-primary;
        font-size: Theme.font-body;
        font-weight: 600;
        wrap: word-wrap;
    }
    detail := Text {
        x: 32px;
        y: name.y + name.preferred-height + 1px;
        width: name.width;
        text: root.data.detail;
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        wrap: word-wrap;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { SettingsLogic.license-toggled(root.data.entry); }
    }
}

/// Licenses (1.2): what baucord is built on, each part with
/// its license; a row opens to the full text. A list of its own, not
/// the scrolling column: an open group is thousands of paragraphs.
component LicensesView inherits VerticalLayout {
    in property <length> pad;
    vertical-stretch: 1;
    padding: root.pad;
    padding-bottom: 0;
    spacing: Theme.gap-md;
    HorizontalLayout {
        VerticalLayout {
            max-width: 560px;
            horizontal-stretch: 100;
            PanelHeader {
                title: Tr.licenses-title;
                lead: Tr.licenses-lead;
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    HorizontalLayout {
        vertical-stretch: 1;
        ListView {
            max-width: 574px;
            horizontal-stretch: 100;
            mouse-drag-pan-enabled: State.touch-host;
            for row in SettingsState.licenses : Rectangle {
                // Each kind is as tall as its own text says (fixed
                // heights, which a layout passes through as they are).
                height: cell.preferred-height;
                cell := VerticalLayout {
                    if row.kind == 0 : LicenseLine {
                        text: row.text;
                        indent: Theme.gap-sm;
                        above: Theme.gap-md;
                        below: Theme.gap-xs;
                        weight: 600;
                    }
                    if row.kind == 1 : LicenseEntry { data: row; }
                    if row.kind == 2 : LicenseLine {
                        text: row.text;
                        tint: Theme.text-secondary;
                        above: Theme.gap-xs;
                    }
                    if row.kind == 3 : LicenseLine { text: row.text; }
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

component CreditsPanel inherits VerticalLayout {
    spacing: Theme.gap-lg;
    PanelHeader { title: Tr.tab-credits; }
    VerticalLayout {
        spacing: 2px;
        Text {
            text: SettingsState.credits-super-heading;
            color: Theme.text-secondary;
            font-size: Theme.font-body;
        }
        for name in SettingsState.credits-super : Text {
            text: name;
            color: Theme.gold;
            font-size: Theme.font-body;
            font-weight: 700;
        }
    }
    VerticalLayout {
        spacing: 2px;
        Text {
            text: SettingsState.credits-beta-heading;
            color: Theme.text-secondary;
            font-size: Theme.font-body;
        }
        for name in SettingsState.credits-testers : Text {
            text: name;
            color: Theme.text-secondary;
            font-size: Theme.font-body;
        }
    }
    Rectangle { }
}

// ── Window ──────────────────────────────────────────────────────────────

// The settings UI itself: nav, the tab panels, the button row. The
// desktop wraps it in `SettingsWindow`; a single-window host (Android,
// ANDROID-SPEC.md D22) shows it as a page inside `MainWindow`
// (`State.settings-open`). Same globals either way, so
// `settingsui.rs` drives both through one `SettingsSurface`.
/// The section list: the wide layout's left column, the narrow
/// layout's first page.
component SettingsNav inherits VerticalLayout {
    in property <int> tab;
    in property <bool> narrow: false;
    callback picked(int);
    padding: Theme.gap-md;
    spacing: Theme.gap-xs;
    // Indices are mirrored by `settingsui::TAB_*`. The narrow list
    // highlights nothing: a row there opens its page.
    NavItem { text: Tr.tab-profile;   icon: IconSet.UserRound;         tall: root.narrow; active: !root.narrow && root.tab == 0; clicked => { root.picked(0); } }
    NavItem { text: Tr.tab-general;   icon: IconSet.SlidersHorizontal; tall: root.narrow; active: !root.narrow && root.tab == 1; clicked => { root.picked(1); } }
    NavItem { text: Tr.tab-audio;     icon: IconSet.Volume2;           tall: root.narrow; active: !root.narrow && root.tab == 2; clicked => { root.picked(2); } }
    NavItem { text: Tr.sounds-header; icon: IconSet.Bell;              tall: root.narrow; active: !root.narrow && root.tab == 3; clicked => { root.picked(3); } }
    // Shortcuts need a keyboard the OS lets us watch: not on a phone.
    if !State.touch-host : NavItem { text: Tr.tab-keyboard;  icon: IconSet.Keyboard; tall: root.narrow; active: !root.narrow && root.tab == 4; clicked => { root.picked(4); } }
    NavItem { text: Tr.tab-servers;   icon: IconSet.Server;            tall: root.narrow; active: !root.narrow && root.tab == 5; clicked => { root.picked(5); } }
    NavItem { text: Tr.tab-debug;     icon: IconSet.Bug;               tall: root.narrow; active: !root.narrow && root.tab == 8; clicked => { root.picked(8); } }
    // Credits and About: their own group. The window's column puts it
    // at the bottom; the phone's list keeps it under the rest, a group
    // gap apart, instead of past a screen of empty space.
    if !root.narrow : Rectangle { }
    if root.narrow : Rectangle { height: Theme.gap-lg; }
    NavItem { text: Tr.tab-credits;   icon: IconSet.Heart;             tall: root.narrow; active: !root.narrow && root.tab == 6; clicked => { root.picked(6); } }
    NavItem { text: Tr.tab-about;     icon: IconSet.Info;              tall: root.narrow; active: !root.narrow && root.tab == 7; clicked => { root.picked(7); } }
    NavItem { text: Tr.tab-licenses;  icon: IconSet.Scale;             tall: root.narrow; active: !root.narrow && root.tab == 9; clicked => { root.picked(9); } }
    if root.narrow : Rectangle { }
}

/// The selected section, scrolling: the wide layout's right column,
/// the narrow layout's second page.
component SettingsContent inherits ScrollView {
    in property <int> tab;
    in property <length> pad: Theme.gap-xl;
    vertical-stretch: 1;
    // Fluent's ScrollView does not pan on a drag; on the Android page
    // a finger needs it to (ANDROID-SPEC.md D27). (The desktop
    // window's own State leaves this false.)
    mouse-drag-pan-enabled: State.touch-host;
    VerticalLayout {
        padding: root.pad;
        // Readable measure: the content column stops growing past
        // ~560px on a wide window.
        HorizontalLayout {
            VerticalLayout {
                max-width: 560px;
                horizontal-stretch: 100;
                if root.tab == 0 : ProfilePanel { }
                if root.tab == 1 : GeneralPanel { }
                if root.tab == 2 : AudioPanel { }
                if root.tab == 3 : SoundsPanel { }
                if root.tab == 4 : KeyboardPanel { }
                if root.tab == 5 : ServersPanel { }
                if root.tab == 6 : CreditsPanel { }
                if root.tab == 7 : AboutPanel { }
                if root.tab == 8 : DebugPanel { }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

/// Reset to defaults · Save & close. Resetting erases the saved
/// servers, the nickname and the picture, so it asks first, right here:
/// the footer turns into the question (one place for the window and
/// the phone page, no dialog on top of a dialog).
component SettingsFooter inherits Rectangle {
    property <bool> confirming: false;
    height: footer.preferred-height;
    background: Theme.bg-primary;
    Rectangle { y: 0; height: 1px; width: 100%; background: Theme.border; }
    footer := VerticalLayout {
        padding: Theme.gap-md;
        spacing: Theme.gap-sm;
        if root.confirming : Text {
            text: Tr.reset-confirm-body;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.gap-sm;
            Rectangle { }
            if !root.confirming : Btn {
                text: Tr.reset-defaults;
                clicked => { root.confirming = true; }
            }
            if !root.confirming : Btn {
                text: Tr.save-and-close;
                accent: true;
                clicked => { SettingsLogic.save-and-close(); }
            }
            if root.confirming : Btn {
                text: Tr.cancel;
                clicked => { root.confirming = false; }
            }
            if root.confirming : Btn {
                text: Tr.reset-confirm;
                danger: true;
                clicked => {
                    root.confirming = false;
                    SettingsLogic.reset-defaults();
                }
            }
        }
    }
}

export component SettingsPanel inherits FocusScope {
    /// 0 profile, 1 general, 2 audio, 3 sounds, 4 keyboard, 5 servers,
    /// 6 credits, 7 about, 8 debug, 9 open-source licenses. Mirrored by
    /// `settingsui::TAB_*`.
    in-out property <int> tab: 0;
    changed tab => { SettingsLogic.tab-shown(); }
    /// The narrow layout (a phone held upright; ANDROID-SPEC.md D28):
    /// the section list and the open section are two pages, as the
    /// sidebar and the chat are in the main window.
    in property <bool> narrow: false;
    /// Narrow only: a section's page is showing, not the list.
    in-out property <bool> section-open: false;
    // The Audio section's meter and microphone run while it shows.
    changed section-open => { SettingsLogic.tab-shown(); }

    public function focus-capture() { root.focus(); }

    /// One step back: from a section to the list (narrow), else out
    /// of Settings — saved, as the button does. The top bar's arrow
    /// and Android's Back.
    public function back() {
        if (root.narrow && root.section-open) {
            root.section-open = false;
        } else {
            SettingsLogic.save-and-close();
        }
    }

    // While a keybind is recording, swallow everything here —
    // Escape cancels, Backspace clears, anything else is the new
    // bind. Outside recording, keys flow normally.
    capture-key-pressed(ev) => {
        if (!SettingsState.capturing) { return reject; }
        if (ev.text == Key.Escape) { SettingsLogic.capture-cancel(); return accept; }
        if (ev.text == Key.Backspace) { SettingsLogic.capture-clear(); return accept; }
        SettingsLogic.capture-key(ev.text, ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
        accept
    }

    if !root.narrow : HorizontalLayout {
        width: 100%;
        height: 100%;
        Rectangle {
            width: 188px;
            background: Theme.surface;
            SettingsNav {
                tab: root.tab;
                picked(i) => { root.tab = i; }
            }
        }
        VerticalLayout {
            if root.tab != 9 : SettingsContent { tab: root.tab; }
            if root.tab == 9 : LicensesView { pad: Theme.gap-xl; }
            SettingsFooter { }
        }
    }

    if root.narrow : VerticalLayout {
        width: 100%;
        height: 100%;
        // The way back, and where you are.
        Rectangle {
            height: 52px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: Theme.gap-sm;
                padding-right: Theme.gap-md;
                spacing: Theme.gap-xs;
                Rectangle {
                    width: 40px;
                    IconBtn {
                        size: 40px;
                        icon-size: 20px;
                        icon: IconSet.ArrowLeft;
                        idle-color: Theme.text-primary;
                        clicked => { root.back(); }
                    }
                }
                Text {
                    text: Tr.settings-title;
                    color: Theme.text-primary;
                    font-size: Theme.font-md;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
        if !root.section-open : SettingsNav {
            vertical-stretch: 1;
            narrow: true;
            tab: root.tab;
            picked(i) => {
                root.tab = i;
                root.section-open = true;
            }
        }
        if root.section-open && root.tab != 9 : SettingsContent {
            tab: root.tab;
            pad: Theme.gap-lg;
        }
        if root.section-open && root.tab == 9 : LicensesView { pad: Theme.gap-lg; }
        SettingsFooter { }
    }
}

export component SettingsWindow inherits Window {
    title: Tr.settings-title;
    background: Theme.bg-primary;
    preferred-width: 800px;
    preferred-height: 740px;
    min-width: 680px;
    min-height: 580px;

    in-out property <int> tab <=> panel.tab;

    // The app is dark whatever the OS is: the stock widgets drawn from
    // the style's palette (scrollbars, Settings → About's AboutSlint)
    // follow.
    init => { Palette.color-scheme = ColorScheme.dark; }

    // Same Windows minimize→restore workaround as MainWindow: the OS
    // clears the surface while damage tracking trusts the back buffer;
    // flipping this dirties the full window for one complete repaint.
    in property <bool> repaint-flip;
    Rectangle {
        width: 100%;
        height: 100%;
        background: root.repaint-flip ? #FFFFFF01 : transparent;
    }

    public function focus-capture() { panel.focus-capture(); }

    panel := SettingsPanel { }
}

// Shared with the admin window (admin.slint).
export { NavItem, PanelHeader }
