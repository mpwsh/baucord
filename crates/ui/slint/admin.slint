// The admin panel (spec §8): a settings-shaped page over the main
// window — tabs on the left, one list per tab on the right; on a phone
// the tab list and one tab are two pages, as Settings' are
// (ANDROID-SPEC.md D71) — over the admin commands the
// slash commands already send. Every row action goes through the
// host (`AdminLogic`), which sends the same `AdminCommand` the
// command line would: one authorization path, three front ends.
// Lists are filled by the host from the matching `AdminOutcome`;
// `AdminState.busy` is the tab's refresh in flight.

import { ScrollView } from "std-widgets.slint";
import { Icon, IconSet, IconDisplay } from "@lucide";
import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { State } from "globals.slint";
import { Btn, IconBtn, Field, FieldLabel, Hint, Sep, Dropdown, CheckRow, RoleGlyph } from "widgets.slint";
import { NavItem, PanelHeader } from "settings.slint";

export struct AdminUserRow {
    user-id: string,        // hex, the target for actions
    name: string,
    roles: string,          // "member, streamer"
    online: bool,
    last-seen: string,
    keys: int,
    role-index: int,        // their highest role's index in role-names; -1 = none
}

export struct AdminRoleRow {
    id: int,
    name: string,
    standing: string,       // "above members"
    builtin: bool,
    permissions: string,    // "join, speak, text, …"
    holders: int,
    icon: string,           // "" = none
    color: color,
    has-color: bool,
}

export struct AdminRestrictionRow {
    id: int,
    kind: string,
    who: string,
    until: string,
    reason: string,
    by: string,
}

export struct AdminInviteRow {
    code: string,
    role: string,
    expiry: string,
    uses: string,
    revoked: bool,
}

export struct AdminChannelRow {
    id: int,
    name: string,
    members: int,
    owner: string,
    config-owned: bool,
}

export struct AdminBlobRow {
    blob-hex: string,
    name: string,
    kind: string,
    size: string,
    by: string,
    when: string,
    refs: int,
}

/// One report (1.2), as the Reports tab lists it.
export struct AdminReportRow {
    id: int,
    when: string,
    reporter: string,       // "" once they deleted their account
    target: string,         // who was reported
    target-id: string,      // hex; "" once their account is gone
    what: string,           // "A message in General" / "A direct message" / "The person"
    reason: string,
    excerpt: string,        // the message as reported; "" for a person
    note: string,
    resolved: bool,
    msg-deletable: bool,    // a General message: Delete is offered
}

export struct AdminAuditRow {
    when: string,           // "14:06", or "Sep 6 14:06" on another day
    actor: string,
    action: string,         // humanized: "kicked", "created an invite"
    target: string,
    detail: string,
}

export global AdminState {
    in property <bool> busy: false;
    /// One line under the header: the last error, or empty.
    in property <string> notice;
    // Users
    in property <[AdminUserRow]> users;
    in property <[string]> role-names;      // the Role dropdown, table order
    // The confirmation the host asks before anything that bites: what
    // it is about, what it does, whether it takes a reason.
    in property <bool> confirm-open: false;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-label;     // the accepting button
    in property <bool> confirm-danger: true;
    in property <bool> confirm-asks-reason: false;
    in-out property <string> confirm-reason;
    // Roles
    in property <[AdminRoleRow]> roles;
    in-out property <int> role-edit-id: -1;   // -1 = new
    in-out property <string> role-edit-name;
    in property <[string]> perm-names;
    in property <[bool]> perm-on;
    in property <bool> role-edit-open: false;
    /// The badge: one of `role-icons` (or "") and one of `role-colors`
    /// (-1 = none).
    in property <[string]> role-icons;
    in property <[color]> role-colors;
    in-out property <string> role-edit-icon;
    in-out property <int> role-edit-color: -1;
    // Restrictions · Invites · Channels · Files · Audit
    in property <[AdminRestrictionRow]> restrictions;
    in property <[AdminInviteRow]> invites;
    in property <[AdminChannelRow]> channels;
    in property <[AdminBlobRow]> blobs;
    in property <string> storage-line;      // "1.2 GB of 20 GB"
    in property <float> storage-frac;
    in property <[AdminAuditRow]> audit;
    in property <bool> audit-more: false;
    // Reports (1.2): open ones, or the handled ones still kept.
    in property <[AdminReportRow]> reports;
    in-out property <bool> reports-resolved: false;
    // Server
    in property <string> stat-version;
    in property <string> stat-uptime;
    in property <string> stat-online;
    in property <string> stat-users;
    in property <string> stat-messages;
    in property <string> stat-blobs;
    in property <string> stat-persistence;
    in property <string> stat-queue;
    in property <string> stat-dropped;
    in property <string> stat-errors;
}

export global AdminLogic {
    /// The tab came into view, or its refresh was clicked.
    callback refresh(tab: int);
    // Users: a person's Actions button, at window coordinates `x`,
    // `y` (under it); the host opens the app's menu there. Each pick
    // asks through the confirmation below.
    callback user-actions(user-id: string, online: bool, x: length, y: length);
    callback user-set-role(user-id: string, role-index: int);
    // Roles
    callback role-select(id: int);
    callback role-new();
    callback role-perm-toggled(index: int, on: bool);
    callback role-save();
    callback role-delete(id: int);
    callback role-edit-cancel();
    // The rest
    callback restriction-lift(id: int);
    callback invite-revoke(code: string);
    callback invite-new();
    callback channel-edit(id: int);
    callback channel-delete(id: int);
    callback blob-delete(blob-hex: string);
    callback audit-more();
    // Reports: handled; the reported message gone; the person banned.
    callback report-resolve(id: int);
    callback report-delete-message(id: int);
    callback report-ban(id: int);
    callback confirm-accept();
    callback confirm-cancel();
    callback close();
}

// ── Small pieces ────────────────────────────────────────────────────────

/// A compact text chip that acts: the panel's row buttons. A finger
/// gets a taller one (a phone has no pointer to aim).
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked;
    width: lbl.preferred-width + 2 * (State.touch-host ? Theme.gap-md : Theme.gap-sm);
    height: State.touch-host ? 32px : 24px;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? transparent
        : t.has-hover ? Theme.hover : Theme.bg-tertiary;
    animate background { duration: 150ms; }
    lbl := Text {
        text: root.text;
        color: !root.enabled ? Theme.text-muted
            : root.danger ? Theme.danger-text : Theme.text-primary;
        font-size: Theme.font-xs;
        font-weight: 500;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// The tab's title row: header, a refresh, the notice line.
component TabHead inherits VerticalLayout {
    in property <string> title;
    in property <string> lead;
    in property <int> tab;
    spacing: Theme.gap-xs;
    HorizontalLayout {
        spacing: Theme.gap-sm;
        PanelHeader { title: root.title; lead: root.lead; horizontal-stretch: 1; }
        // The refresh, or "loading" in its place: the list below never
        // moves while a fetch is out.
        Rectangle {
            width: 80px;
            if !AdminState.busy : IconBtn {
                x: parent.width - self.width;
                y: 4px;
                size: 28px;
                icon-size: 16px;
                icon: IconSet.RefreshCw;
                tooltip: Tr.admin-refresh;
                tooltip-below: true;
                clicked => { AdminLogic.refresh(root.tab); }
            }
            if AdminState.busy : Text {
                x: parent.width - self.width;
                y: 10px;
                text: Tr.admin-loading;
                color: Theme.text-muted;
                font-size: Theme.font-xs;
            }
        }
    }
    if AdminState.notice != "" : Text {
        text: AdminState.notice;
        color: Theme.danger-text;
        font-size: Theme.font-sm;
        wrap: word-wrap;
    }
}

component Empty inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-sm;
}

/// One list row's frame: a hairline between rows, hover tint.
component Row inherits Rectangle {
    in property <length> row-height: 44px;
    height: root.row-height;
    background: t.has-hover ? Theme.hover : transparent;
    animate background { duration: 150ms; }
    border-radius: Theme.radius-sm;
    t := TouchArea { }
    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.border; }
    @children
}

component Cell inherits Text {
    color: Theme.text-primary;
    font-size: Theme.font-sm;
    vertical-alignment: center;
    overflow: elide;
}

component Muted inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-xs;
    vertical-alignment: center;
    overflow: elide;
}

// ── Tabs ────────────────────────────────────────────────────────────────
// Every tab takes `compact`: the page is narrow (a phone, or a window
// made small). Compact rows stack what a wide row lines up, and size
// themselves to what they hold (`body.preferred-height`: a layout alone
// under-reports wrapped text, as WarningNote's comment says).

component OnlineDot inherits Rectangle {
    in property <bool> online;
    width: 10px;
    Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.online ? Theme.success : Theme.subtle;
    }
}

/// Their highest role; picking another one sets it.
component RolePick inherits Rectangle {
    in property <AdminUserRow> u;
    width: 136px;
    Dropdown {
        y: (parent.height - self.height) / 2;
        options: AdminState.role-names;
        current: root.u.role-index;
        placeholder: Tr.admin-set-role;
        selected(i) => {
            if (i != root.u.role-index) { AdminLogic.user-set-role(root.u.user-id, i); }
        }
    }
}

/// A person's actions, in the app's own menu (`menu::admin_user_menu`):
/// Disconnect, Kick, Ban, Reset profile, Purge — each confirmed by the
/// panel first. Drawn like the role picker beside it, a dropdown.
component ActionsButton inherits Rectangle {
    in property <AdminUserRow> u;
    width: label.preferred-width + Theme.gap-md + Theme.gap-sm + Theme.gap-sm + 14px;
    height: 36px;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.border;
    animate border-color { duration: 150ms; }
    accessible-role: button;
    accessible-label: Tr.admin-actions + " " + root.u.name;
    accessible-action-default => { root.open(); }
    function open() {
        AdminLogic.user-actions(root.u.user-id, root.u.online,
            root.absolute-position.x, root.absolute-position.y + root.height + 4px);
    }
    HorizontalLayout {
        padding-left: Theme.gap-md;
        padding-right: Theme.gap-sm;
        spacing: Theme.gap-sm;
        label := Text {
            text: Tr.admin-actions;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
        // The Dropdown's caret (widgets.slint): an icon, not a "▾".
        Rectangle {
            width: 14px;
            IconDisplay {
                icon: IconSet.ChevronDown;
                size: 14px;
                stroke: Theme.text-muted;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
}

/// A person on a wide page: who, then their actions and role.
component UserLine inherits Row {
    in property <AdminUserRow> u;
    row-height: 56px;
    HorizontalLayout {
        padding-left: Theme.gap-xs;
        padding-right: Theme.gap-xs;
        spacing: Theme.gap-sm;
        OnlineDot { online: root.u.online; }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Cell { text: root.u.name; font-weight: 600; }
            Muted { text: root.u.roles + " · " + root.u.last-seen; }
        }
        VerticalLayout {
            alignment: center;
            ActionsButton { u: root.u; }
        }
        RolePick { u: root.u; }
    }
}

/// A person on a narrow page: who they are across the whole width (a
/// long name is not cut for the controls), the controls under it.
component UserCard inherits Row {
    in property <AdminUserRow> u;
    row-height: body.preferred-height;
    body := VerticalLayout {
        padding-left: Theme.gap-xs;
        padding-right: Theme.gap-xs;
        padding-top: Theme.gap-sm;
        padding-bottom: Theme.gap-sm;
        spacing: Theme.gap-sm;
        HorizontalLayout {
            spacing: Theme.gap-sm;
            OnlineDot { online: root.u.online; }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Cell { text: root.u.name; font-weight: 600; }
                Muted { text: root.u.roles + " · " + root.u.last-seen; }
            }
        }
        HorizontalLayout {
            spacing: Theme.gap-sm;
            ActionsButton { u: root.u; }
            RolePick { u: root.u; height: 36px; }
            Rectangle { }
        }
    }
}

component UsersTab inherits VerticalLayout {
    in property <bool> compact;
    spacing: Theme.gap-md;
    TabHead { title: Tr.admin-users; lead: Tr.admin-users-lead; tab: 0; }
    if AdminState.users.length == 0 && !AdminState.busy : Empty { text: Tr.admin-none; }
    VerticalLayout {
        for u in AdminState.users : VerticalLayout {
            if !root.compact : UserLine { u: u; }
            if root.compact : UserCard { u: u; }
        }
    }
}

/// Fixed tiles in rows that wrap at the width there is — a layout
/// Slint does not have: the role badge's glyphs and colors. Tile `i`
/// sits at `x-of(i)`, `y-of(i)`; the box is as tall as its rows.
component TileFlow inherits Rectangle {
    in property <int> count;
    in property <length> tile;
    in property <length> gap: Theme.gap-xs;
    property <int> per-row: Math.max(1, Math.floor((root.width + root.gap) / (root.tile + root.gap)));
    height: Math.ceil(root.count / root.per-row) * (root.tile + root.gap) - root.gap;
    pure public function x-of(i: int) -> length {
        return Math.mod(i, root.per-row) * (root.tile + root.gap);
    }
    pure public function y-of(i: int) -> length {
        return Math.floor(i / root.per-row) * (root.tile + root.gap);
    }
}

component RolesTab inherits VerticalLayout {
    in property <bool> compact;
    spacing: Theme.gap-md;
    TabHead { title: Tr.admin-roles; lead: Tr.admin-roles-lead; tab: 1; }
    VerticalLayout {
        for r in AdminState.roles : Row {
            // Narrow: the standing goes under the name, so the name is
            // never the part that gets cut.
            row-height: root.compact ? role-body.preferred-height : 52px;
            HorizontalLayout {
                padding-left: Theme.gap-xs;
                padding-right: Theme.gap-xs;
                spacing: Theme.gap-sm;
                role-body := VerticalLayout {
                    alignment: center;
                    padding-top: root.compact ? Theme.gap-sm : 0px;
                    padding-bottom: root.compact ? Theme.gap-sm : 0px;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: Theme.gap-xs;
                        if r.icon != "" : RoleGlyph {
                            name: r.icon;
                            size: 14px;
                            stroke: r.has-color ? r.color : Theme.text-secondary;
                        }
                        // The name keeps its width; the rest follows it.
                        Cell { text: r.name; font-weight: 600; horizontal-stretch: 0;
                            color: r.has-color ? r.color : Theme.text-primary; }
                        if !root.compact : Muted {
                            text: "· " + r.standing + " · " + r.holders + " " + Tr.admin-holders;
                            horizontal-stretch: 1;
                        }
                    }
                    if root.compact : Muted { text: r.standing + " · " + r.holders + " " + Tr.admin-holders; }
                    // Narrow: every permission, wrapped (the row grows).
                    Muted {
                        text: r.permissions;
                        wrap: root.compact ? TextWrap.word-wrap : TextWrap.no-wrap;
                    }
                }
                if !r.builtin : Chip { text: Tr.admin-edit; clicked => { AdminLogic.role-select(r.id); } }
                if !r.builtin : Chip { text: Tr.admin-delete; danger: true;
                    clicked => { AdminLogic.role-delete(r.id); } }
                if r.builtin : Muted { text: Tr.admin-builtin; }
            }
        }
    }
    if !AdminState.role-edit-open : HorizontalLayout {
        Btn { text: Tr.admin-role-new; clicked => { AdminLogic.role-new(); } }
        Rectangle { }
    }
    // The editor: a name and every permission as a checkbox. Rank is
    // derived from the set, so there is nothing else to pick.
    if AdminState.role-edit-open : Rectangle {
        border-radius: Theme.radius-md;
        background: Theme.bg-secondary;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: Theme.gap-md;
            spacing: Theme.gap-md;
            Text {
                text: AdminState.role-edit-id < 0 ? Tr.admin-role-new : Tr.admin-role-editing;
                color: Theme.text-primary;
                font-size: Theme.font-body;
                font-weight: 600;
            }
            VerticalLayout {
                spacing: Theme.gap-xs;
                FieldLabel { text: Tr.admin-role-name; }
                Field { text <=> AdminState.role-edit-name; placeholder: "streamer"; }
                Hint { text: Tr.admin-role-name-hint; }
            }
            // The badge: a glyph and a color, both optional. Seventeen of
            // each, so they wrap where the page is narrower than a row.
            // A finger gets bigger tiles.
            VerticalLayout {
                spacing: Theme.gap-xs;
                FieldLabel { text: Tr.admin-role-badge; }
                glyphs := TileFlow {
                    count: AdminState.role-icons.length + 1;
                    tile: State.touch-host ? 40px : 30px;
                    Rectangle {
                        x: glyphs.x-of(0);
                        y: glyphs.y-of(0);
                        width: glyphs.tile;
                        height: glyphs.tile;
                        border-radius: Theme.radius-sm;
                        background: AdminState.role-edit-icon == "" ? Theme.accent : Theme.bg-tertiary;
                        Text { text: "—"; color: Theme.text-secondary; font-size: Theme.font-sm; }
                        TouchArea { mouse-cursor: pointer; clicked => { AdminState.role-edit-icon = ""; } }
                    }
                    for icon[i] in AdminState.role-icons : Rectangle {
                        x: glyphs.x-of(i + 1);
                        y: glyphs.y-of(i + 1);
                        width: glyphs.tile;
                        height: glyphs.tile;
                        border-radius: Theme.radius-sm;
                        background: AdminState.role-edit-icon == icon ? Theme.accent : Theme.bg-tertiary;
                        animate background { duration: 100ms; }
                        RoleGlyph {
                            name: icon;
                            size: 16px;
                            stroke: AdminState.role-edit-icon == icon ? Theme.on-accent : Theme.text-secondary;
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { AdminState.role-edit-icon = icon; } }
                    }
                }
                swatches := TileFlow {
                    count: AdminState.role-colors.length + 1;
                    tile: State.touch-host ? 32px : 22px;
                    Rectangle {
                        x: swatches.x-of(0);
                        y: swatches.y-of(0);
                        width: swatches.tile;
                        height: swatches.tile;
                        border-radius: self.width / 2;
                        border-width: AdminState.role-edit-color < 0 ? 2px : 1px;
                        border-color: AdminState.role-edit-color < 0 ? Theme.text-primary : Theme.border;
                        background: Theme.bg-tertiary;
                        Text { text: "—"; color: Theme.text-muted; font-size: Theme.font-xs; }
                        TouchArea { mouse-cursor: pointer; clicked => { AdminState.role-edit-color = -1; } }
                    }
                    for c[i] in AdminState.role-colors : Rectangle {
                        x: swatches.x-of(i + 1);
                        y: swatches.y-of(i + 1);
                        width: swatches.tile;
                        height: swatches.tile;
                        border-radius: self.width / 2;
                        background: c;
                        border-width: AdminState.role-edit-color == i ? 2px : 0px;
                        border-color: Theme.text-primary;
                        TouchArea { mouse-cursor: pointer; clicked => { AdminState.role-edit-color = i; } }
                    }
                }
            }
            VerticalLayout {
                spacing: 2px;
                for name[i] in AdminState.perm-names : CheckRow {
                    text: name;
                    checked: AdminState.perm-on[i];
                    toggled(on) => { AdminLogic.role-perm-toggled(i, on); }
                }
            }
            Hint { text: Tr.admin-role-rank-hint; }
            HorizontalLayout {
                spacing: Theme.gap-sm;
                Btn { text: Tr.cancel; clicked => { AdminLogic.role-edit-cancel(); } }
                Btn { text: Tr.admin-role-save; accent: true; clicked => { AdminLogic.role-save(); } }
                Rectangle { }
            }
        }
    }
}

component RestrictionsTab inherits VerticalLayout {
    in property <bool> compact;
    spacing: Theme.gap-md;
    TabHead { title: Tr.admin-restrictions; lead: Tr.admin-restrictions-lead; tab: 2; }
    if AdminState.restrictions.length == 0 && !AdminState.busy : Empty { text: Tr.admin-none; }
    VerticalLayout {
        for r in AdminState.restrictions : Row {
            // The reason wraps instead of being cut: it is what the
            // person was told (up to 500 bytes).
            row-height: Math.max(52px, lift-body.preferred-height);
            HorizontalLayout {
                padding-left: Theme.gap-xs;
                padding-right: Theme.gap-xs;
                spacing: Theme.gap-sm;
                lift-body := VerticalLayout {
                    alignment: center;
                    padding-top: Theme.gap-sm;
                    padding-bottom: Theme.gap-sm;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    // What and for how long are never the part that
                    // gets cut; narrow, the person has a line of their
                    // own (a name can be 32 characters).
                    if !root.compact : HorizontalLayout {
                        spacing: Theme.gap-xs;
                        Cell { text: r.kind; font-weight: 600; horizontal-stretch: 0; min-width: self.preferred-width; }
                        Cell { text: r.who; horizontal-stretch: 0; }
                        Muted { text: "· " + r.until; horizontal-stretch: 1; min-width: self.preferred-width; }
                    }
                    if root.compact : HorizontalLayout {
                        spacing: Theme.gap-xs;
                        Cell { text: r.kind; font-weight: 600; horizontal-stretch: 0; }
                        Muted { text: "· " + r.until; horizontal-stretch: 1; }
                    }
                    if root.compact : Cell { text: r.who; wrap: word-wrap; }
                    Muted {
                        text: r.reason + " — " + r.by;
                        wrap: word-wrap;
                    }
                }
                Chip { text: Tr.admin-lift; clicked => { AdminLogic.restriction-lift(r.id); } }
            }
        }
    }
}

component InvitesTab inherits VerticalLayout {
    spacing: Theme.gap-md;
    TabHead { title: Tr.admin-invites; lead: Tr.admin-invites-lead; tab: 3; }
    HorizontalLayout {
        Btn { text: Tr.invite-create; clicked => { AdminLogic.invite-new(); } }
        Rectangle { }
    }
    if AdminState.invites.length == 0 && !AdminState.busy : Empty { text: Tr.admin-none; }
    VerticalLayout {
        for i in AdminState.invites : Row {
            row-height: 48px;
            HorizontalLayout {
                padding-left: Theme.gap-xs;
                padding-right: Theme.gap-xs;
                spacing: Theme.gap-sm;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Cell { text: i.code; font-family: "monospace"; font-weight: 600;
                        color: i.revoked ? Theme.text-muted : Theme.text-primary; }
                    Muted { text: i.role + " · " + i.expiry + " · " + i.uses; }
                }
                if i.revoked : Muted { text: Tr.admin-revoked; }
                if !i.revoked : Chip { text: Tr.admin-revoke; danger: true;
                    clicked => { AdminLogic.invite-revoke(i.code); } }
            }
        }
    }
}

component ChannelsTab inherits VerticalLayout {
    spacing: Theme.gap-md;
    TabHead { title: Tr.admin-channels; lead: Tr.admin-channels-lead; tab: 4; }
    VerticalLayout {
        for c in AdminState.channels : Row {
            row-height: 48px;
            HorizontalLayout {
                padding-left: Theme.gap-xs;
                padding-right: Theme.gap-xs;
                spacing: Theme.gap-sm;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Cell { text: c.name; font-weight: 600; }
                    Muted { text: c.members + " " + Tr.admin-members + (c.owner != "" ? " · " + c.owner : ""); }
                }
                if c.config-owned : Muted { text: Tr.admin-config-owned; }
                if !c.config-owned : Chip { text: Tr.admin-edit; clicked => { AdminLogic.channel-edit(c.id); } }
                if !c.config-owned : Chip { text: Tr.admin-delete; danger: true;
                    clicked => { AdminLogic.channel-delete(c.id); } }
            }
        }
    }
}

component FilesTab inherits VerticalLayout {
    spacing: Theme.gap-md;
    TabHead { title: Tr.admin-files; lead: Tr.admin-files-lead; tab: 5; }
    VerticalLayout {
        spacing: Theme.gap-xs;
        HorizontalLayout {
            Cell { text: AdminState.storage-line; horizontal-stretch: 1; }
        }
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.subtle;
            Rectangle {
                x: 0;
                width: parent.width * Math.clamp(AdminState.storage-frac, 0, 1);
                height: parent.height;
                border-radius: 3px;
                background: AdminState.storage-frac > 0.9 ? Theme.danger : Theme.accent-text;
            }
        }
    }
    if AdminState.blobs.length == 0 && !AdminState.busy : Empty { text: Tr.admin-none; }
    VerticalLayout {
        for b in AdminState.blobs : Row {
            row-height: 48px;
            HorizontalLayout {
                padding-left: Theme.gap-xs;
                padding-right: Theme.gap-xs;
                spacing: Theme.gap-sm;
                Rectangle {
                    width: 40px;
                    Rectangle {
                        width: 36px;
                        height: 24px;
                        border-radius: Theme.radius-sm;
                        background: Theme.bg-tertiary;
                        Text { text: b.kind; color: Theme.text-secondary; font-size: Theme.font-xs; font-weight: 700; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Cell { text: b.name; font-weight: 600; }
                    Muted { text: b.size + " · " + b.by + " · " + b.when + " · " + b.refs + " " + Tr.admin-refs; }
                }
                Chip { text: Tr.admin-delete; danger: true;
                    clicked => { AdminLogic.blob-delete(b.blob-hex); } }
            }
        }
    }
}

/// A column header cell for the audit table.
component ColHead inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-xs;
    font-weight: 600;
    letter-spacing: 0.4px;
    vertical-alignment: center;
    overflow: elide;
}

/// One audit entry on a narrow page: who did what to whom, then when
/// and the details, wrapped — the table's five columns do not fit.
component AuditCard inherits Row {
    in property <AdminAuditRow> e;
    row-height: body.preferred-height;
    body := VerticalLayout {
        padding-left: Theme.gap-xs;
        padding-right: Theme.gap-xs;
        padding-top: Theme.gap-sm;
        padding-bottom: Theme.gap-sm;
        spacing: 2px;
        HorizontalLayout {
            spacing: Theme.gap-xs;
            Cell { text: root.e.actor; font-weight: 600; horizontal-stretch: 0; }
            Cell { text: root.e.action; color: Theme.accent-text; horizontal-stretch: 0; }
            Cell { text: root.e.target; color: Theme.text-secondary; horizontal-stretch: 1; }
        }
        Text {
            text: root.e.detail == "" ? root.e.when : root.e.when + " · " + root.e.detail;
            color: Theme.text-muted;
            font-size: Theme.font-xs;
            wrap: word-wrap;
        }
    }
}

component AuditTab inherits VerticalLayout {
    in property <bool> compact;
    spacing: Theme.gap-md;
    TabHead { title: Tr.admin-audit; lead: Tr.admin-audit-lead; tab: 6; }
    if AdminState.audit.length == 0 && !AdminState.busy : Empty { text: Tr.admin-none; }
    if root.compact && AdminState.audit.length > 0 : VerticalLayout {
        for e in AdminState.audit : AuditCard { e: e; }
    }
    // A table: fixed columns for when, who and what; the target and
    // the details share the rest. Headers say what each is.
    if !root.compact && AdminState.audit.length > 0 : VerticalLayout {
        HorizontalLayout {
            height: 28px;
            padding-left: Theme.gap-xs;
            padding-right: Theme.gap-xs;
            spacing: Theme.gap-sm;
            ColHead { text: Tr.admin-col-when; width: 84px; }
            ColHead { text: Tr.admin-col-who; width: 96px; }
            ColHead { text: Tr.admin-col-what; width: 132px; }
            ColHead { text: Tr.admin-col-target; width: 116px; }
            ColHead { text: Tr.admin-col-detail; horizontal-stretch: 1; }
        }
        Rectangle { height: 1px; background: Theme.border; }
        for e in AdminState.audit : Row {
            row-height: 44px;
            HorizontalLayout {
                padding-left: Theme.gap-xs;
                padding-right: Theme.gap-xs;
                spacing: Theme.gap-sm;
                Muted { text: e.when; width: 84px; }
                Cell { text: e.actor; font-weight: 600; width: 96px; }
                Cell { text: e.action; color: Theme.accent-text; width: 132px; }
                Cell { text: e.target; color: Theme.text-secondary; width: 116px; }
                // Two lines when it needs them, elided past that.
                Text {
                    text: e.detail;
                    color: Theme.text-secondary;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
    }
    if AdminState.audit-more : HorizontalLayout {
        Btn { text: Tr.admin-audit-more; clicked => { AdminLogic.audit-more(); } }
        Rectangle { }
    }
}

component ReportsTab inherits VerticalLayout {
    in property <bool> compact;
    spacing: Theme.gap-md;
    TabHead { title: Tr.admin-reports; lead: Tr.admin-reports-lead; tab: 8; }
    CheckRow {
        text: Tr.admin-reports-show-resolved;
        checked <=> AdminState.reports-resolved;
        toggled(on) => { AdminLogic.refresh(8); }
    }
    if AdminState.reports.length == 0 && !AdminState.busy : Empty {
        text: AdminState.reports-resolved ? Tr.admin-none : Tr.admin-reports-none;
    }
    VerticalLayout {
        for r in AdminState.reports : Row {
            // Narrow: who and when on one line, why and what on the
            // next, and the reported message in full.
            row-height: root.compact ? report-body.preferred-height
                : r.excerpt != "" ? 118px : 84px;
            report-body := VerticalLayout {
                padding-left: Theme.gap-xs;
                padding-right: Theme.gap-xs;
                padding-top: root.compact ? Theme.gap-sm : Theme.gap-xs;
                padding-bottom: root.compact ? Theme.gap-sm : Theme.gap-xs;
                spacing: root.compact ? Theme.gap-xs : 2px;
                if !root.compact : HorizontalLayout {
                    spacing: Theme.gap-sm;
                    Cell { text: r.target; font-weight: 600; horizontal-stretch: 0; }
                    Cell { text: r.reason; color: Theme.danger-text; horizontal-stretch: 0; }
                    Muted { text: r.what; horizontal-stretch: 1; }
                    Muted { text: r.when; horizontal-stretch: 0; }
                }
                if root.compact : HorizontalLayout {
                    spacing: Theme.gap-sm;
                    Cell { text: r.target; font-weight: 600; horizontal-stretch: 1; }
                    Muted { text: r.when; horizontal-stretch: 0; }
                }
                if root.compact : HorizontalLayout {
                    spacing: Theme.gap-sm;
                    Cell { text: r.reason; color: Theme.danger-text; horizontal-stretch: 0; }
                    Muted { text: r.what; horizontal-stretch: 1; }
                }
                if r.excerpt != "" && !root.compact : Text {
                    text: "“" + r.excerpt + "”";
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    wrap: word-wrap;
                    overflow: elide;
                    height: 36px;
                }
                if r.excerpt != "" && root.compact : Text {
                    text: "“" + r.excerpt + "”";
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    wrap: word-wrap;
                }
                Muted {
                    text: (r.reporter == "" ? Tr.admin-reports-by-gone : Tr.admin-reports-by + " " + r.reporter)
                        + (r.note == "" ? "" : " — " + r.note);
                    wrap: root.compact ? TextWrap.word-wrap : TextWrap.no-wrap;
                }
                HorizontalLayout {
                    spacing: Theme.gap-xs;
                    if !r.resolved : Chip { text: Tr.admin-reports-resolve;
                        clicked => { AdminLogic.report-resolve(r.id); } }
                    if r.msg-deletable : Chip { text: Tr.admin-reports-delete-message; danger: true;
                        clicked => { AdminLogic.report-delete-message(r.id); } }
                    if r.target-id != "" : Chip { text: Tr.admin-ban; danger: true;
                        clicked => { AdminLogic.report-ban(r.id); } }
                    Rectangle { }
                }
            }
        }
    }
}

component StatLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <length> label-width: 140px;
    spacing: Theme.gap-md;
    Muted { text: root.label; width: root.label-width; }
    Cell { text: root.value; horizontal-stretch: 1; }
}

component ServerTab inherits VerticalLayout {
    in property <bool> compact;
    spacing: Theme.gap-md;
    TabHead { title: Tr.admin-server; lead: Tr.admin-server-lead; tab: 7; }
    VerticalLayout {
        spacing: Theme.gap-xs;
        StatLine { label: Tr.admin-stat-version;     value: AdminState.stat-version; label-width: root.compact ? 112px : 140px; }
        StatLine { label: Tr.admin-stat-uptime;      value: AdminState.stat-uptime; label-width: root.compact ? 112px : 140px; }
        StatLine { label: Tr.admin-stat-online;      value: AdminState.stat-online; label-width: root.compact ? 112px : 140px; }
        StatLine { label: Tr.admin-stat-users;       value: AdminState.stat-users; label-width: root.compact ? 112px : 140px; }
        StatLine { label: Tr.admin-stat-messages;    value: AdminState.stat-messages; label-width: root.compact ? 112px : 140px; }
        StatLine { label: Tr.admin-stat-blobs;       value: AdminState.stat-blobs; label-width: root.compact ? 112px : 140px; }
        Sep { }
        StatLine { label: Tr.admin-stat-persistence; value: AdminState.stat-persistence; label-width: root.compact ? 112px : 140px; }
        StatLine { label: Tr.admin-stat-queue;       value: AdminState.stat-queue; label-width: root.compact ? 112px : 140px; }
        StatLine { label: Tr.admin-stat-dropped;     value: AdminState.stat-dropped; label-width: root.compact ? 112px : 140px; }
        StatLine { label: Tr.admin-stat-errors;      value: AdminState.stat-errors; label-width: root.compact ? 112px : 140px; }
    }
}

// ── The panel ───────────────────────────────────────────────────────────

/// The tabs: the wide panel's left column, the narrow page's first
/// list (which highlights nothing — a row there opens its tab).
component AdminNav inherits VerticalLayout {
    in property <int> tab;
    in property <bool> narrow: false;
    callback picked(int);
    padding: Theme.gap-md;
    spacing: Theme.gap-xs;
    NavItem { text: Tr.admin-users;        icon: IconSet.Users;      tall: root.narrow; active: !root.narrow && root.tab == 0; clicked => { root.picked(0); } }
    NavItem { text: Tr.admin-reports;      icon: IconSet.Flag;       tall: root.narrow; active: !root.narrow && root.tab == 8; clicked => { root.picked(8); } }
    NavItem { text: Tr.admin-roles;        icon: IconSet.Shield;     tall: root.narrow; active: !root.narrow && root.tab == 1; clicked => { root.picked(1); } }
    NavItem { text: Tr.admin-restrictions; icon: IconSet.Ban;        tall: root.narrow; active: !root.narrow && root.tab == 2; clicked => { root.picked(2); } }
    NavItem { text: Tr.admin-invites;      icon: IconSet.Ticket;     tall: root.narrow; active: !root.narrow && root.tab == 3; clicked => { root.picked(3); } }
    NavItem { text: Tr.admin-channels;     icon: IconSet.Hash;       tall: root.narrow; active: !root.narrow && root.tab == 4; clicked => { root.picked(4); } }
    NavItem { text: Tr.admin-files;        icon: IconSet.Paperclip;  tall: root.narrow; active: !root.narrow && root.tab == 5; clicked => { root.picked(5); } }
    NavItem { text: Tr.admin-audit;        icon: IconSet.ScrollText; tall: root.narrow; active: !root.narrow && root.tab == 6; clicked => { root.picked(6); } }
    // The server's own figures: their own group, at the bottom of the
    // column, a group gap under the rest in the phone's list.
    if !root.narrow : Rectangle { }
    if root.narrow : Rectangle { height: Theme.gap-lg; }
    NavItem { text: Tr.admin-server;       icon: IconSet.Server;     tall: root.narrow; active: !root.narrow && root.tab == 7; clicked => { root.picked(7); } }
    if root.narrow : Rectangle { }
}

/// The selected tab, scrolling: the wide panel's right column, the
/// narrow page's second page.
component AdminContent inherits ScrollView {
    in property <int> tab;
    in property <bool> compact;
    in property <length> pad: Theme.gap-xl;
    vertical-stretch: 1;
    // Fluent's ScrollView does not pan on a drag; a finger needs it to
    // (ANDROID-SPEC.md D27).
    mouse-drag-pan-enabled: State.touch-host;
    VerticalLayout {
        padding: root.pad;
        alignment: start;
        if root.tab == 0 : UsersTab { compact: root.compact; }
        if root.tab == 1 : RolesTab { compact: root.compact; }
        if root.tab == 2 : RestrictionsTab { compact: root.compact; }
        if root.tab == 3 : InvitesTab { }
        if root.tab == 4 : ChannelsTab { }
        if root.tab == 5 : FilesTab { }
        if root.tab == 6 : AuditTab { compact: root.compact; }
        if root.tab == 7 : ServerTab { compact: root.compact; }
        if root.tab == 8 : ReportsTab { compact: root.compact; }
    }
}

/// The admin panel as a page of the main window (`State.admin-open`):
/// wide, the tabs where the sidebar was and the tab beside them; narrow
/// (a phone), the tab list and one tab as two pages, as Settings.
export component AdminPanel inherits Rectangle {
    /// 0 users, 1 roles, 2 restrictions, 3 invites, 4 channels,
    /// 5 files, 6 audit, 7 server, 8 reports (`adminui::TAB_*`).
    in-out property <int> tab: 0;
    in property <bool> narrow: false;
    /// Narrow only: a tab's page is showing, not the list.
    in-out property <bool> section-open: false;
    // The tab and its Close button share one column beside the tabs,
    // at most 840 px wide: on a maximized window a row's controls stay
    // near its name and the button under the list, not at the far edge.
    property <length> column: Math.min(root.width - 188px, 840px);
    // The column is narrower than a wide row needs (the Users row's
    // Actions and role pickers beside the name; the audit table's
    // columns): rows stack instead.
    property <bool> compact: root.narrow || root.column - 2 * Theme.gap-xl < 600px;

    function open-tab(t: int) {
        root.tab = t;
        AdminLogic.refresh(t);
    }

    /// One step back: from a tab to the list (narrow), else out of the
    /// panel. The top bar's arrow, Escape and Android's Back.
    public function back() {
        if (root.narrow && root.section-open) {
            root.section-open = false;
        } else {
            AdminLogic.close();
        }
    }

    if !root.narrow : HorizontalLayout {
        Rectangle {
            width: 188px;
            background: Theme.surface;
            AdminNav {
                tab: root.tab;
                picked(t) => { root.open-tab(t); }
            }
        }
        VerticalLayout {
            width: root.column;
            AdminContent { tab: root.tab; compact: root.compact; }
            Rectangle {
                height: 64px;
                background: Theme.bg-primary;
                Rectangle { y: 0; height: 1px; width: 100%; background: Theme.border; }
                HorizontalLayout {
                    padding: Theme.gap-md;
                    spacing: Theme.gap-sm;
                    Rectangle { }
                    Btn { text: Tr.invite-close; clicked => { AdminLogic.close(); } }
                }
            }
        }
        // The rest of a wide window.
        Rectangle { }
    }

    if root.narrow : VerticalLayout {
        // The way back, and where you are.
        Rectangle {
            height: 52px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: Theme.gap-sm;
                padding-right: Theme.gap-md;
                spacing: Theme.gap-xs;
                Rectangle {
                    width: 40px;
                    IconBtn {
                        size: 40px;
                        icon-size: 20px;
                        icon: IconSet.ArrowLeft;
                        idle-color: Theme.text-primary;
                        clicked => { root.back(); }
                    }
                }
                Text {
                    text: Tr.admin-title;
                    color: Theme.text-primary;
                    font-size: Theme.font-md;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
        if !root.section-open : AdminNav {
            vertical-stretch: 1;
            narrow: true;
            tab: root.tab;
            picked(t) => {
                root.open-tab(t);
                root.section-open = true;
            }
        }
        if root.section-open : AdminContent {
            tab: root.tab;
            compact: true;
            pad: Theme.gap-lg;
        }
    }

    // ── Confirmation (every action that bites goes through it) ─────
    // What it is about, what it does, a reason when the action takes
    // one (kept in the audit and shown to the person), Escape, Back or
    // Cancel to back out (the page's key handler hands Back here).
    if AdminState.confirm-open : Rectangle {
        background: Theme.scrim;
        TouchArea { clicked => { AdminLogic.confirm-cancel(); } }
        confirm-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape) { AdminLogic.confirm-cancel(); return accept; }
                reject
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(420px, root.width - 48px);
                height: confirm-col.preferred-height;
                border-radius: Theme.radius-md;
                background: Theme.bg-secondary;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-color: #00000088;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 6px;
                TouchArea { }
                confirm-col := VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    Text {
                        text: AdminState.confirm-title;
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Text {
                        text: AdminState.confirm-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-sm;
                        wrap: word-wrap;
                    }
                    if AdminState.confirm-asks-reason : VerticalLayout {
                        spacing: Theme.gap-xs;
                        FieldLabel { text: Tr.admin-reason; }
                        Field {
                            text <=> AdminState.confirm-reason;
                            placeholder: Tr.admin-reason-placeholder;
                            accepted => { AdminLogic.confirm-accept(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        Rectangle { }
                        Btn { text: Tr.cancel; clicked => { AdminLogic.confirm-cancel(); } }
                        Btn {
                            text: AdminState.confirm-label;
                            danger: AdminState.confirm-danger;
                            accent: !AdminState.confirm-danger;
                            clicked => { AdminLogic.confirm-accept(); }
                        }
                    }
                }
            }
        }
    }
}
