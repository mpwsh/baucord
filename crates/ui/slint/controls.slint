// controls.slint — the call's controls, one button each (1.5).
//
// The channel list's control bar, the bar at the bottom of Channel
// view and the inbox's call bar are made of these.

import { IconSet, IconDisplay } from "@lucide";
import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { State, Logic } from "globals.slint";
import { IconBtn } from "widgets.slint";

export component MicBtn inherits IconBtn {
    icon: State.muted ? IconSet.MicOff : IconSet.Mic;
    // In push-to-talk mode the mic lights up while the key is held; a
    // click still toggles the hard mute.
    active: State.muted || (State.ptt-mode && State.ptt-held);
    active-danger: State.muted;
    // In the lobby the mic goes nowhere: greyed, and the tooltip says
    // why (the toggle still sets the preference for the room to come).
    idle-color: State.in-lobby ? Theme.text-muted : Theme.text-secondary;
    tooltip: State.in-lobby ? Tr.lobby-mic-hint
        : State.muted ? Tr.unmute
        : State.ptt-mode ? State.ptt-tooltip : Tr.mute;
    clicked => { Logic.toggle-mute(); }
}

export component DeafenBtn inherits IconBtn {
    icon: State.deafened ? IconSet.HeadphoneOff : IconSet.Headphones;
    active: State.deafened;
    active-danger: true;
    tooltip: State.deafened ? Tr.undeafen : Tr.deafen;
    clicked => { Logic.toggle-deafen(); }
}

/// A phone cannot share its screen (ANDROID-SPEC.md §9.4): put it
/// behind `!State.touch-host`.
export component ShareBtn inherits IconBtn {
    icon: State.sharing ? IconSet.MonitorOff : IconSet.Monitor;
    active: State.sharing;
    active-danger: true;
    tooltip: State.sharing ? Tr.stop-sharing : Tr.share-screen;
    clicked => { Logic.toggle-share(); }
}

/// Put it behind `State.camera-available`.
export component CameraBtn inherits IconBtn {
    icon: State.camera-on ? IconSet.VideoOff : IconSet.Video;
    active: State.camera-on;
    active-danger: true;
    tooltip: State.camera-on ? Tr.camera-off : Tr.camera-on;
    clicked => { Logic.toggle-camera(); }
}

export component SettingsBtn inherits IconBtn {
    icon: IconSet.Settings;
    tooltip: Tr.settings;
    clicked => { Logic.open-settings(); }
}

/// Put it behind `State.perm-panel`.
export component AdminBtn inherits IconBtn {
    icon: IconSet.Shield;
    idle-color: Theme.admin;
    tooltip: Tr.admin-button;
    clicked => { Logic.admin-open(); }
}

/// Leave call (back to the lobby, still connected) or, from the lobby,
/// Disconnect. Red and not filled, so it does not read as a toggle
/// that is on (muted and deafened are filled red).
export component HangUpBtn inherits IconBtn {
    icon: State.in-call ? IconSet.PhoneOff : IconSet.LogOut;
    idle-color: Theme.danger;
    tooltip: State.in-call ? Tr.leave-call : Tr.disconnect;
    clicked => { Logic.hang-up(); }
}

/// Leave call, with its words: the end of Channel view's bar.
export component LeaveCallBtn inherits Rectangle {
    in property <length> size: 44px;
    height: root.size;
    width: row.preferred-width;
    border-radius: Theme.radius-md;
    background: t.has-hover ? Theme.danger.darker(15%) : Theme.danger;
    animate background { duration: 120ms; }
    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: Theme.gap-sm;
        alignment: center;
        Rectangle {
            width: 18px;
            IconDisplay {
                icon: IconSet.PhoneOff;
                size: 18px;
                stroke: Theme.on-accent;
            }
        }
        Text {
            text: Tr.leave-call;
            color: Theme.on-accent;
            font-size: Theme.font-md;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { Logic.hang-up(); }
    }
}

/// The bar at the bottom of Channel view: the call's controls and
/// Leave call. Settings and the admin panel are on the rail (a phone:
/// on the channel list).
export component StageControls inherits Rectangle {
    property <length> btn: State.touch-host ? 48px : 44px;
    height: self.btn + 12px;
    width: row.preferred-width;
    border-radius: Theme.radius-lg;
    background: Theme.bg-secondary;
    row := HorizontalLayout {
        padding: 6px;
        spacing: 6px;
        MicBtn { size: root.btn; }
        DeafenBtn { size: root.btn; }
        if !State.touch-host : ShareBtn { size: root.btn; }
        if State.camera-available : CameraBtn { size: root.btn; }
        LeaveCallBtn { size: root.btn; }
    }
}
