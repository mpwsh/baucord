// connect.slint — the connect view.
//
// Nickname + the saved-server dropdown (which server to join, shown by
// name; the pencil jumps to Settings → Servers), Connect,
// Settings/Quit, error + device-warning lines — as a centered rounded
// card. Values live in State so they survive failed attempts and
// reconnects.
//
// When the token issuer answers 403, the host flips
// `State.password-prompt` and an inline box appears: type the server
// password, Save stores it on the selected server, Connect retries.

import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { State, Logic } from "globals.slint";
import { Btn, Field, FieldLabel, IconBtn, Dropdown } from "widgets.slint";

export component ConnectView inherits Rectangle {
    background: Theme.bg-primary;

    card := Rectangle {
        width: 400px;
        height: layout.preferred-height;
        border-radius: Theme.radius-lg;
        background: Theme.bg-secondary;

        layout := VerticalLayout {
            padding: Theme.gap-xl;
            spacing: Theme.gap-md;

            Text {
                text: "baucord";
                color: Theme.text-primary;
                font-size: Theme.font-title;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: Tr.app-tagline;
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                horizontal-alignment: center;
            }

            // Error line — reserved height so the form never jumps.
            Text {
                text: State.error-text;
                color: Theme.danger;
                font-size: Theme.font-sm;
                horizontal-alignment: center;
                wrap: word-wrap;
                min-height: 18px;
            }

            FieldLabel { text: Tr.nickname; }
            nick := Field {
                text <=> State.nickname;
                accepted => { Logic.connect-clicked(); }
            }

            FieldLabel { text: Tr.settings-server; }
            HorizontalLayout {
                spacing: Theme.gap-sm;
                Dropdown {
                    horizontal-stretch: 1;
                    options: State.server-names;
                    current <=> State.server-index;
                    selected(i) => { Logic.connect-server-selected(i); }
                }
                IconBtn {
                    size: 36px;
                    icon: @image-url("icons/pencil.svg");
                    tooltip: Tr.server-manage;
                    clicked => { Logic.edit-servers(); }
                }
            }

            // Token issuer said 403: ask for the server password and
            // save it on the selected entry, then Connect retries.
            if State.password-prompt : VerticalLayout {
                spacing: Theme.gap-sm;
                Text {
                    text: Tr.connect-access-denied;
                    color: Theme.danger;
                    font-size: Theme.font-sm;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Theme.gap-sm;
                    Field {
                        horizontal-stretch: 1;
                        text <=> State.password;
                        secret: true;
                        accepted => { Logic.save-password(); }
                    }
                    Btn {
                        width: 84px;
                        height: 40px;
                        text: Tr.save;
                        accent: true;
                        clicked => { Logic.save-password(); }
                    }
                }
            }

            Btn {
                text: Tr.connect;
                accent: true;
                height: 42px;
                clicked => { Logic.connect-clicked(); }
            }

            HorizontalLayout {
                spacing: Theme.gap-sm;
                Btn { text: Tr.settings; clicked => { Logic.open-settings(); } }
                Btn { text: Tr.quit; clicked => { Logic.quit(); } }
            }

            // "Saved device isn't connected" — the fix (Settings) sits
            // right above it, same as before.
            Text {
                text: State.device-warning;
                color: Theme.warning;
                font-size: Theme.font-sm;
                horizontal-alignment: center;
                wrap: word-wrap;
                min-height: 16px;
            }
        }
    }
}
