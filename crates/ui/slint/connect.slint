// connect.slint — the connect view.
//
// Nickname + the saved-server dropdown (which server to join, shown by
// name; the pencil jumps to Settings → Servers), Connect,
// Settings/Quit, the terms line, error + device-warning lines — as a centered rounded
// card. Values live in State so they survive failed attempts and
// reconnects.
//
// The device key is the login; an invite code is only needed on the
// first visit. When the server asks for one (unknown device, or a code
// that did not admit), the host flips `State.invite-prompt` and an
// inline box appears: type the code and Connect retries. Verdicts that stay (banned, name in use, device
// unlinked, removed) go to `State.connect-notice`.

import { IconSet } from "@lucide";
import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { State, Logic, ToastKind } from "globals.slint";
import { Btn, Field, FieldLabel, IconBtn, Dropdown } from "widgets.slint";

export component ConnectView inherits Rectangle {
    background: Theme.bg-primary;

    card := Rectangle {
        // A 375 pt phone is narrower than the card: keep a margin
        // there instead of running off both edges (review P3-40).
        width: Math.min(400px, parent.width - 2 * Theme.gap-md);
        height: layout.preferred-height;
        border-radius: Theme.radius-lg;
        background: Theme.bg-secondary;

        layout := VerticalLayout {
            padding: Theme.gap-xl;
            spacing: Theme.gap-md;

            Text {
                text: "baucord";
                color: Theme.text-primary;
                font-size: Theme.font-title;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: Tr.app-tagline;
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                horizontal-alignment: center;
            }

            // Notice line — reserved height so the form never jumps;
            // colored by the toast's register (a reconnect countdown is
            // not an error).
            Text {
                text: State.error-text;
                color: State.toast-kind == ToastKind.error ? Theme.danger
                    : State.toast-kind == ToastKind.warning ? Theme.warning
                    : State.toast-kind == ToastKind.success ? Theme.success
                    : Theme.text-secondary;
                font-size: Theme.font-sm;
                horizontal-alignment: center;
                wrap: word-wrap;
                min-height: 18px;
            }

            FieldLabel { text: Tr.nickname; }
            nick := Field {
                text <=> State.nickname;
                accepted => { Logic.connect-clicked(); }
            }

            FieldLabel { text: Tr.settings-server; }
            HorizontalLayout {
                spacing: Theme.gap-sm;
                Dropdown {
                    horizontal-stretch: 1;
                    options: State.server-names;
                    current <=> State.server-index;
                    selected(i) => { Logic.connect-server-selected(i); }
                }
                IconBtn {
                    size: 36px;
                    icon: IconSet.Pencil;
                    tooltip: Tr.server-manage;
                    clicked => { Logic.edit-servers(); }
                }
            }

            // The server wants an invite code: ask for it here, then
            // Connect retries with it.
            if State.invite-prompt : VerticalLayout {
                spacing: Theme.gap-sm;
                Text {
                    text: State.invite-prompt-text;
                    color: Theme.warning;
                    font-size: Theme.font-sm;
                    wrap: word-wrap;
                }
                FieldLabel { text: Tr.invite-code; }
                Field {
                    text <=> State.invite-code;
                    placeholder: Tr.invite-code-placeholder;
                    accepted => { Logic.connect-clicked(); }
                }
            }

            // A verdict that stays until the next attempt.
            if State.connect-notice != "" : Text {
                text: State.connect-notice;
                color: Theme.danger;
                font-size: Theme.font-sm;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Btn {
                text: Tr.connect;
                accent: true;
                height: 42px;
                clicked => { Logic.connect-clicked(); }
            }

            HorizontalLayout {
                spacing: Theme.gap-sm;
                Btn { text: Tr.settings; clicked => { Logic.open-settings(); } }
                if State.can-quit : Btn { text: Tr.quit; clicked => { Logic.quit(); } }
            }

            // Connecting is agreeing to the terms (1.2): said once, small,
            // with the whole line a way to read them. One line where it
            // fits; on a narrow phone the link drops to a second line
            // instead of running past the card's edge (360 dp is
            // narrower than the sentence; review P3-40).
            Rectangle {
                property <length> line-width: terms-notice.preferred-width + 3px + terms-link.preferred-width;
                property <bool> stacked: self.line-width > self.width;
                // A little taller than the text: a finger's worth to tap.
                height: (self.stacked ? terms-notice.preferred-height + terms-link.preferred-height
                    : terms-notice.preferred-height) + 10px;
                terms-notice := Text {
                    x: parent.stacked ? (parent.width - self.width) / 2 : (parent.width - parent.line-width) / 2;
                    y: 5px;
                    width: self.preferred-width;
                    height: self.preferred-height;
                    text: Tr.terms-notice;
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                }
                terms-link := Text {
                    x: parent.stacked ? (parent.width - self.width) / 2 : terms-notice.x + terms-notice.width + 3px;
                    y: parent.stacked ? terms-notice.y + terms-notice.height : 5px;
                    width: self.preferred-width;
                    height: self.preferred-height;
                    text: Tr.terms-link;
                    color: terms-touch.has-hover ? Theme.accent-text : Theme.text-secondary;
                    font-size: Theme.font-xs;
                    font-weight: 600;
                    animate color { duration: 120ms; }
                }
                terms-touch := TouchArea {
                    x: Math.min(terms-notice.x, terms-link.x);
                    width: parent.stacked ? Math.max(terms-notice.width, terms-link.width) : parent.line-width;
                    mouse-cursor: pointer;
                    clicked => { Logic.link-clicked(State.terms-url); }
                }
            }

            // "Saved device isn't connected" — the fix (Settings) sits
            // just above it, past the terms line.
            Text {
                text: State.device-warning;
                color: Theme.warning;
                font-size: Theme.font-sm;
                horizontal-alignment: center;
                wrap: word-wrap;
                min-height: 16px;
            }
        }
    }
}
