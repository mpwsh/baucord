// main.slint — the application window.
//
// One Window hosting all phases (splash/update → connect → main), plus
// the in-window overlays: image send preview, screen-share dialog, and
// the per-user audio popover. Every FLTK floating helper window becomes
// an overlay here — which retires the orphaned-popup / focus-churn
// machinery wholesale (there is nothing to strand on the desktop).

import { IconSet, IconDisplay } from "@lucide";
import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { State, Logic, Phase, UserRow, ChatRow, EmojiRow, KeybindRow, ServerRow, ChannelOption, ModAction, ToastKind } from "globals.slint";
import { ConnectView } from "connect.slint";
import { StartupView } from "startup.slint";
import { Sidebar } from "sidebar.slint";
import { ChatPane } from "chat.slint";
import { Btn, IconBtn, Card, HSlider, Field, FieldLabel, Hint, Dropdown, CheckRow, AvatarTile } from "widgets.slint";
import { SettingsWindow, SettingsState, SettingsLogic } from "settings.slint";
import { StreamViewerWindow } from "viewer.slint";

import { BaucordTray } from "tray.slint";

export { SettingsWindow, SettingsState, SettingsLogic, StreamViewerWindow, BaucordTray, State, Logic, Tr, Theme, Phase, UserRow, ChatRow, EmojiRow, KeybindRow, ServerRow, ChannelOption, ModAction, ToastKind }

export component MainWindow inherits Window {
    title: "baucord";
    background: Theme.bg-primary;
    preferred-width: 1000px;
    preferred-height: 640px;
    min-width: 500px;
    min-height: 400px;
    icon: @image-url("../../../assets/icons/icon.png");   // app icon (workspace assets/); Windows exe/taskbar icon is embedded by desktop/build.rs

    // Share-dialog local state
    in-out property <bool> share-dialog-open: false;
    property <int> share-monitor: State.default-monitor;
    property <int> share-quality: State.default-quality;
    property <int> share-scope: State.default-scope;   // 0 = my channel, 1 = everyone

    public function chat-at-bottom() -> bool { return chat-pane.at-bottom(); }
    public function chat-scroll-to-end() { chat-pane.scroll-to-end(); }
    public function chat-pin-bottom() { chat-pane.pin-to-bottom(); }
    public function focus-composer() { chat-pane.focus-composer(); }
    public function composer-set-cursor(pos: int) { chat-pane.composer-set-cursor(pos); }

    // Flipped by the shell after a minimize→restore on Windows: the OS
    // repaints the uncovered window white, but the renderer's damage
    // tracking still trusts the back buffer, so partial presents only
    // patch hovered slivers. Changing this dirties the full window
    // (the overlay spans everything — z-order is irrelevant, only the
    // dirtied region matters) and one full repaint follows. Alpha
    // 1/255 is imperceptible.
    in property <bool> repaint-flip;
    Rectangle {
        width: 100%;
        height: 100%;
        background: root.repaint-flip ? #FFFFFF01 : transparent;
    }
    public function open-share-dialog() {
        share-monitor = State.default-monitor;
        share-quality = State.default-quality;
        // Prefilled from the last share (saved settings) — the dialog
        // shows exactly what the share hotkey would start.
        share-scope = State.default-scope;
        share-dialog-open = true;
    }

    // ── Phases ─────────────────────────────────────────────────────
    // The main screen is a persistent instance (visible-gated, not
    // `if`-gated) so the shell can query/drive chat scroll state at any
    // time; the model is cleared per connection, matching the FLTK
    // build's fresh-chat-per-session semantics.
    if State.phase != Phase.connect && State.phase != Phase.main : StartupView { }
    if State.phase == Phase.connect : ConnectView { }
    main-screen := HorizontalLayout {
        visible: State.phase == Phase.main;
        Rectangle {
            width: 260px;
            Sidebar { }
        }
        chat-pane := ChatPane {
            horizontal-stretch: 1;
        }
    }

    // ── Profile card (spec §7.1, §8) ───────────────────────────────
    // Summoned by a roster row or an author's picture in chat, which
    // set `State.card-*` (window coordinates of the hovered element).
    // Shown after a short dwell like a native tooltip; the fields bind
    // to the roster row, so telemetry arriving while the pointer
    // rests updates it live.
    property <int> card-shown-for: -1;
    Timer {
        interval: 450ms;
        running: State.card-index >= 0 && root.card-shown-for != State.card-index;
        triggered => { root.card-shown-for = State.card-index; }
    }
    if State.card-index >= 0 && State.card-index < State.users.length
        && root.card-shown-for == State.card-index
        && !State.users[State.card-index].is-channel : card := Rectangle {
        property <UserRow> who: State.users[State.card-index];
        x: Math.max(Theme.gap-md, Math.min(State.card-x, root.width - self.width - Theme.gap-md));
        y: Math.min(State.card-y + State.card-anchor-h + 4px, root.height - self.height - Theme.gap-md);
        width: 272px;
        height: card-body.preferred-height;
        border-radius: Theme.radius-md;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;

        pure function role-name(r: int) -> string {
            return r == 1 ? Tr.role-guest
                : r == 2 ? Tr.role-member
                : r == 3 ? Tr.role-organizer
                : r == 4 ? Tr.role-admin
                : "";
        }

        card-body := VerticalLayout {
            padding: Theme.gap-md;
            spacing: Theme.gap-sm;
            HorizontalLayout {
                spacing: Theme.gap-md;
                AvatarTile {
                    source: card.who.avatar;
                    has-image: card.who.has-avatar;
                    initial: card.who.initial;
                    tint: card.who.tile-tint;
                    side: 64px;
                    corner: 8px;
                    ring-room: false;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    horizontal-stretch: 1;
                    Text {
                        text: card.who.name;
                        color: card.who.has-name-color ? card.who.name-color : Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: card.who.name-style == 1 ? 700 : 600;
                        font-italic: card.who.name-style == 2;
                        overflow: elide;
                    }
                    if card.who.level-line != "" : Text {
                        text: card.who.level-line;
                        color: Theme.text-secondary;
                        font-size: Theme.font-sm;
                        overflow: elide;
                    }
                    if card.who.role == 1 || card.who.role == 3 || card.who.role == 4 : HorizontalLayout {
                        spacing: Theme.gap-xs;
                        Rectangle {
                            width: 13px;
                            IconDisplay {
                                icon: card.who.role == 4 ? IconSet.Shield
                                    : card.who.role == 3 ? IconSet.Wrench
                                    : IconSet.CircleDashed;
                                size: 13px;
                                stroke: card.who.role == 4 ? Theme.gold : Theme.text-muted;
                            }
                        }
                        Text {
                            text: card.role-name(card.who.role);
                            color: card.who.role == 4 ? Theme.gold : Theme.text-muted;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            if card.who.telemetry != "" : Rectangle {
                height: 1px;
                background: Theme.border;
            }
            if card.who.telemetry != "" : Text {
                text: card.who.telemetry;
                color: Theme.text-secondary;
                font-size: Theme.font-xs;
                font-family: "monospace";
                wrap: word-wrap;
            }
        }
    }

    // ── Toast (any phase; the connect view also shows it inline) ───
    // One register per kind: the glyph and the border carry the color,
    // the message stays in primary text so it reads on the tint. A
    // click dismisses it before the 5 s timer does.
    if State.error-text != "" && State.phase == Phase.main : toast-box := Rectangle {
        property <color> tone: State.toast-kind == ToastKind.error ? Theme.danger
            : State.toast-kind == ToastKind.warning ? Theme.warning
            : State.toast-kind == ToastKind.success ? Theme.success
            : Theme.accent-text;
        x: (root.width - self.width) / 2;
        y: Theme.gap-lg;
        width: Math.min(toast-row.preferred-width + 2 * Theme.gap-md, root.width - 2 * Theme.gap-lg);
        height: toast-row.preferred-height + 2 * Theme.gap-sm + 4px;
        border-radius: Theme.radius-md;
        background: Theme.bg-tertiary;
        border-width: 1px;
        border-color: self.tone.with-alpha(0.6);
        drop-shadow-color: #00000066;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        toast-row := HorizontalLayout {
            padding-left: Theme.gap-md;
            padding-right: Theme.gap-md;
            spacing: Theme.gap-sm;
            Rectangle {
                width: 16px;
                IconDisplay {
                    icon: State.toast-kind == ToastKind.error ? IconSet.CircleX
                        : State.toast-kind == ToastKind.warning ? IconSet.TriangleAlert
                        : State.toast-kind == ToastKind.success ? IconSet.CircleCheck
                        : IconSet.Info;
                    size: 16px;
                    stroke: toast-box.tone;
                }
            }
            toast := Text {
                text: State.error-text;
                color: Theme.text-primary;
                font-size: Theme.font-body;
                vertical-alignment: center;
                wrap: word-wrap;
                max-width: root.width - 2 * Theme.gap-lg - 48px;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { Logic.toast-dismiss(); }
        }
    }

    // ── Image send preview (modal overlay) ─────────────────────────
    if State.preview-open : Rectangle {
        background: #000000AA;
        TouchArea { clicked => { Logic.preview-cancel(); } }
        // Enter = Send, Escape = Cancel — same paths as the buttons;
        // the shell refocuses the composer after the dialog closes.
        preview-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Return) { Logic.preview-send(); return accept; }
                if (ev.text == Key.Escape) { Logic.preview-cancel(); return accept; }
                reject
            }
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(520px, root.width - 48px);
                height: pv.preferred-height;
                TouchArea { }   // swallow clicks inside the card
                pv := VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    Text {
                        text: Tr.image-preview-title;
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Rectangle {
                        height: 300px;
                        border-radius: Theme.radius-md;
                        background: Theme.surface;
                        clip: true;
                        Image {
                            width: parent.width - 2 * Theme.gap-sm;
                            height: parent.height - 2 * Theme.gap-sm;
                            source: State.preview-image;
                            image-fit: contain;
                        }
                    }
                    Text {
                        text: State.preview-caption;
                        color: Theme.text-muted;
                        font-size: Theme.font-sm;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        Btn { text: Tr.cancel; clicked => { Logic.preview-cancel(); } }
                        Btn { text: Tr.send; accent: true; clicked => { Logic.preview-send(); } }
                    }
                }
            }
        }
    }


    // ── Image viewer (modal overlay; darkened scrim like the preview) ──
    if State.viewer-open : Rectangle {
        background: #000000CC;
        TouchArea { clicked => { Logic.viewer-close(); } }
        // Keyboard: Escape closes, ◀ ▶ step the gallery. The scope
        // grabs focus on creation and hands it back to the composer on
        // close, so typing resumes without an extra click.
        viewer-keys := FocusScope {
            init => { self.focus(); }
            function close() {
                Logic.viewer-close();
                chat-pane.focus-composer();
            }
            key-pressed(ev) => {
                if (ev.text == Key.Escape) { close(); return accept; }
                if (ev.text == Key.LeftArrow) {
                    if (State.viewer-has-prev) { Logic.viewer-step(-1); }
                    return accept;
                }
                if (ev.text == Key.RightArrow) {
                    if (State.viewer-has-next) { Logic.viewer-step(1); }
                    return accept;
                }
                reject
            }
            VerticalLayout {
                // A layout inside a plain element sizes to its preferred
                // height unless told otherwise — pin it to the scrim so
                // the picture row actually stretches.
                width: 100%;
                height: 100%;
                padding: Theme.gap-lg;
                spacing: Theme.gap-md;
                HorizontalLayout {
                    height: 32px;
                    Text {
                        text: State.viewer-heading;
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconBtn {
                        icon: IconSet.Download;
                        tooltip: Tr.menu-save-image;
                        clicked => { Logic.viewer-save(); }
                    }
                    IconBtn {
                        icon: IconSet.X;
                        clicked => { viewer-keys.close(); }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.gap-md;
                    vertical-stretch: 1;
                    // The chevrons must not sit directly in this row:
                    // IconBtn pins `height: size` (40px), and a fixed-height
                    // child caps a HorizontalLayout's max-height — the whole
                    // row collapsed to 40px and the picture rendered as a
                    // thumbnail. Height-unconstrained wrappers keep the row
                    // stretchable; each button centers itself inside.
                    Rectangle {
                        width: nav-l.width;
                        nav-l := IconBtn {
                            y: (parent.height - self.height) / 2;
                            icon: IconSet.ChevronLeft;
                            opacity: State.viewer-has-prev ? 1.0 : 0.25;
                            clicked => { if (State.viewer-has-prev) { Logic.viewer-step(-1); } }
                        }
                    }
                    picture := Rectangle {
                        horizontal-stretch: 1;
                        // contain-fitted bounds of the displayed image —
                        // the swallow area matches the pixels, so clicks
                        // on the letterbox fall through to the scrim and
                        // close the viewer.
                        property <float> src-w: Math.max(1, State.viewer-image.width);
                        property <float> src-h: Math.max(1, State.viewer-image.height);
                        property <float> fit: Math.min(
                            self.width / 1px / self.src-w,
                            self.height / 1px / self.src-h);
                        property <length> fit-w: self.src-w * self.fit * 1px;
                        property <length> fit-h: self.src-h * self.fit * 1px;
                        viewer-img := Image {
                            width: parent.width;
                            height: parent.height;
                            source: State.viewer-image;
                            image-fit: contain;
                        }
                        TouchArea {   // swallow clicks over the picture itself
                            x: (parent.width - parent.fit-w) / 2;
                            y: (parent.height - parent.fit-h) / 2;
                            width: parent.fit-w;
                            height: parent.fit-h;
                        }
                    }
                    Rectangle {
                        width: nav-r.width;
                        nav-r := IconBtn {
                            y: (parent.height - self.height) / 2;
                            icon: IconSet.ChevronRight;
                            opacity: State.viewer-has-next ? 1.0 : 0.25;
                            clicked => { if (State.viewer-has-next) { Logic.viewer-step(1); } }
                        }
                    }
                }
            }
        }
    }

    // ── Screen-share dialog (modal overlay) ────────────────────────
    if root.share-dialog-open : Rectangle {
        background: #000000AA;
        TouchArea { clicked => { root.share-dialog-open = false; } }
        share-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape) { root.share-dialog-open = false; return accept; }
                reject
            }
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 380px;
                height: sh.preferred-height;
                TouchArea { }
                sh := VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    Text {
                        text: Tr.share-screen;
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 600;
                    }
                    FieldLabel { text: Tr.monitor; }
                    Dropdown {
                        options: State.monitors;
                        current <=> root.share-monitor;
                    }
                    FieldLabel { text: Tr.quality; }
                    Dropdown {
                        options: State.qualities;
                        current <=> root.share-quality;
                    }
                    FieldLabel { text: Tr.share-visibility; }
                    Dropdown {
                        options: [Tr.share-channel-only, Tr.share-everyone];
                        current <=> root.share-scope;
                    }
                    Btn {
                        text: Tr.start-sharing;
                        accent: true;
                        clicked => {
                            root.share-dialog-open = false;
                            Logic.start-share(root.share-monitor, root.share-quality,
                                root.share-scope == 1);
                        }
                    }
                }
            }
        }
    }
    // ── Channel password prompt (modal overlay) ────────────────────
    // Opened by the shell when a locked channel is clicked with no
    // saved password, or when the server answers WrongPassword. OK
    // saves the password on the server entry and retries the join.
    if State.channel-prompt-open : Rectangle {
        background: #000000AA;
        TouchArea { clicked => { Logic.channel-password-cancel(); } }
        chp-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape) { Logic.channel-password-cancel(); return accept; }
                reject
            }
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 340px;
                height: chp.preferred-height;
                TouchArea { }
                chp := VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    Text {
                        text: "\{Tr.channel-password-title} — \{State.channel-prompt-name}";
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        overflow: elide;
                    }
                    chp-field := Field {
                        placeholder: Tr.channel-password-title;
                        secret: true;
                        text <=> State.channel-password;
                        init => { self.focus-input(); }
                        accepted => { Logic.channel-password-ok(); }
                    }
                    if State.channel-prompt-error != "" : Text {
                        text: State.channel-prompt-error;
                        color: Theme.danger;
                        font-size: Theme.font-xs;
                    }
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        Btn {
                            text: Tr.cancel;
                            clicked => { Logic.channel-password-cancel(); }
                        }
                        Btn {
                            text: Tr.channel-join;
                            accent: true;
                            clicked => { Logic.channel-password-ok(); }
                        }
                    }
                }
            }
        }
    }

    // ── Channel dialog (create / edit; spec §5) ────────────────────
    // The host validates the numbers and sends the spec; the dialog
    // stays open until the server's list update (success) or its
    // refusal, shown inline. Escape cancels, Enter in a field saves.
    if State.channel-dialog-open : Rectangle {
        background: #000000AA;
        TouchArea { clicked => { Logic.channel-dialog-cancel(); } }
        ch-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape) { Logic.channel-dialog-cancel(); return accept; }
                reject
            }
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(400px, root.width - 48px);
                height: chd.preferred-height;
                TouchArea { }
                chd := VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    Text {
                        text: State.channel-dialog-title;
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        overflow: elide;
                    }
                    VerticalLayout {
                        spacing: Theme.gap-xs;
                        FieldLabel { text: Tr.channel-name; }
                        Field {
                            text <=> State.channel-dialog-name;
                            placeholder: Tr.channel-name-placeholder;
                            init => { self.focus-input(); }
                            accepted => { Logic.channel-dialog-save(); }
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.gap-xs;
                        FieldLabel { text: Tr.channel-password-title; }
                        Field {
                            text <=> State.channel-dialog-password;
                            placeholder: Tr.channel-password-placeholder;
                            secret: true;
                            accepted => { Logic.channel-dialog-save(); }
                        }
                        if State.channel-dialog-password-note != "" : Hint {
                            text: State.channel-dialog-password-note;
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.gap-md;
                        VerticalLayout {
                            spacing: Theme.gap-xs;
                            FieldLabel { text: Tr.channel-limit; }
                            Field {
                                text <=> State.channel-dialog-limit;
                                placeholder: Tr.channel-limit-placeholder;
                                accepted => { Logic.channel-dialog-save(); }
                            }
                        }
                        VerticalLayout {
                            spacing: Theme.gap-xs;
                            FieldLabel { text: Tr.channel-afk; }
                            Field {
                                text <=> State.channel-dialog-afk;
                                placeholder: Tr.channel-afk-placeholder;
                                accepted => { Logic.channel-dialog-save(); }
                            }
                        }
                    }
                    CheckRow {
                        text: Tr.channel-keep;
                        hint: Tr.channel-keep-hint;
                        checked <=> State.channel-dialog-keep;
                    }
                    CheckRow {
                        text: Tr.channel-members-only;
                        hint: Tr.channel-members-only-hint;
                        checked <=> State.channel-dialog-members-only;
                    }
                    if State.channel-dialog-error != "" : Text {
                        text: State.channel-dialog-error;
                        color: Theme.danger;
                        font-size: Theme.font-sm;
                        wrap: word-wrap;
                    }
                    if !State.server-persistent : Hint { text: Tr.channel-not-persistent-note; }
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        Btn { text: Tr.cancel; clicked => { Logic.channel-dialog-cancel(); } }
                        Btn {
                            text: State.channel-dialog-editing ? Tr.channel-save : Tr.channel-create;
                            accent: true;
                            clicked => { Logic.channel-dialog-save(); }
                        }
                    }
                }
            }
        }
    }

    // ── Generic confirm (delete a message, later a channel) ────────
    // Title and button repeat the consequence; Enter confirms, Escape
    // cancels. The host remembers what is being confirmed.
    if State.confirm-open : Rectangle {
        background: #000000AA;
        TouchArea { clicked => { Logic.confirm-cancel(); } }
        confirm-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape) { Logic.confirm-cancel(); return accept; }
                if (ev.text == Key.Return) { Logic.confirm-accept(); return accept; }
                reject
            }
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(360px, root.width - 48px);
                height: cf.preferred-height;
                TouchArea { }
                cf := VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    Text {
                        text: State.confirm-title;
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    if State.confirm-body != "" : Hint { text: State.confirm-body; }
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        Btn { text: Tr.cancel; clicked => { Logic.confirm-cancel(); } }
                        Btn {
                            text: State.confirm-label;
                            danger: true;
                            clicked => { Logic.confirm-accept(); }
                        }
                    }
                }
            }
        }
    }

    // ── Moderation dialog (kick / ban / disconnect / mute) ─────────
    // Opened by the shell from the roster menu. The title and the
    // confirm label repeat the consequence, so the dialog is
    // answerable without reading the body; Escape cancels, Enter in
    // the reason field confirms.
    if State.moderation-open : Rectangle {
        background: #000000AA;
        TouchArea { clicked => { Logic.moderation-cancel(); } }
        mod-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape) { Logic.moderation-cancel(); return accept; }
                reject
            }
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(380px, root.width - 48px);
                height: md.preferred-height;
                TouchArea { }
                md := VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    Text {
                        text: State.moderation-title;
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Hint { text: State.moderation-hint; }
                    if State.moderation-durations.length > 0 : VerticalLayout {
                        spacing: Theme.gap-xs;
                        FieldLabel { text: Tr.moderation-duration; }
                        Dropdown {
                            options: State.moderation-durations;
                            current <=> State.moderation-duration;
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.gap-xs;
                        FieldLabel { text: Tr.moderation-reason; }
                        Field {
                            placeholder: Tr.moderation-reason-placeholder;
                            text <=> State.moderation-reason;
                            init => { self.focus-input(); }
                            accepted => { Logic.moderation-confirm(); }
                        }
                    }
                    if !State.server-persistent : Hint { text: Tr.server-not-persistent-note; }
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        Btn { text: Tr.cancel; clicked => { Logic.moderation-cancel(); } }
                        Btn {
                            text: State.moderation-confirm-label;
                            // Mutes and disconnects are reversible; the
                            // raspberry fill is for the two that are not.
                            danger: State.moderation-action == ModAction.kick
                                || State.moderation-action == ModAction.ban;
                            accent: State.moderation-action != ModAction.kick
                                && State.moderation-action != ModAction.ban;
                            clicked => { Logic.moderation-confirm(); }
                        }
                    }
                }
            }
        }
    }

    // ── Per-user audio popover ─────────────────────────────────────
    if State.user-popup-open && State.popup-user-index >= 0
        && State.popup-user-index < State.users.length : Rectangle {
        background: #00000055;
        TouchArea { clicked => { Logic.popup-closed(); } }
        popup-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape) { Logic.popup-closed(); return accept; }
                reject
            }
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 260px;
                height: up.preferred-height;
                background: Theme.bg-tertiary;
                border-width: 1px;
                border-color: Theme.border;
                TouchArea { }
                up := VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    // Only the slider lives here now; mute, reset and
                    // watch moved to the row's menu with the rest.
                    Text {
                        text: State.users[State.popup-user-index].name;
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    FieldLabel { text: Tr.user-volume; }
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        HSlider {
                            horizontal-stretch: 1;
                            minimum: 0.0; maximum: 2.0;
                            value <=> State.popup-volume;
                            released(v) => {
                                Logic.popup-set-volume(State.popup-user-index, v);
                            }
                        }
                        Text {
                            width: 44px;
                            text: "\{Math.round(State.popup-volume * 100)}%";
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                    }
                }
            }
        }
    }
}
