// main.slint — the application window.
//
// One Window hosting all phases (splash/update → connect → main), plus
// the in-window overlays: image send preview, screen-share dialog, the
// dialogs and the context menu. Every FLTK floating helper window becomes
// an overlay here — which retires the orphaned-popup / focus-churn
// machinery wholesale (there is nothing to strand on the desktop).

import { IconSet, IconDisplay } from "@lucide";
import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { State, Logic, Phase, UserRow, ChatRow, EmojiRow, KeybindRow, ServerRow, ChannelOption, ModAction, ToastKind, MenuAction, MenuEntry } from "globals.slint";
import { ConnectView } from "connect.slint";
import { StartupView } from "startup.slint";
import { Sidebar } from "sidebar.slint";
import { ChatPane } from "chat.slint";
import { Btn, IconBtn, Card, Field, FieldLabel, Hint, Dropdown, CheckRow, AvatarTile, MenuPanel, RoleGlyph } from "widgets.slint";
import { SettingsWindow, SettingsPanel, SettingsState, SettingsLogic } from "settings.slint";
import { AdminWindow, AdminState, AdminLogic, AdminUserRow, AdminRoleRow, AdminRestrictionRow, AdminInviteRow, AdminChannelRow, AdminBlobRow, AdminAuditRow } from "admin.slint";
import { StreamViewerWindow, StreamViewerPanel } from "viewer.slint";

import { BaucordTray } from "tray.slint";

export { SettingsWindow, SettingsState, SettingsLogic, StreamViewerWindow, BaucordTray, State, Logic, Tr, Theme, Phase, UserRow, ChatRow, EmojiRow, KeybindRow, ServerRow, ChannelOption, ModAction, ToastKind, MenuAction, MenuEntry }
export { AdminWindow, AdminState, AdminLogic, AdminUserRow, AdminRoleRow, AdminRestrictionRow, AdminInviteRow, AdminChannelRow, AdminBlobRow, AdminAuditRow }

export component MainWindow inherits Window {
    title: "baucord";
    background: Theme.bg-primary;
    preferred-width: 1000px;
    preferred-height: 640px;
    min-width: 500px;
    min-height: 400px;
    icon: @image-url("../../../assets/icons/icon.png");   // app icon (workspace assets/); Windows exe/taskbar icon is embedded by desktop/build.rs

    // Share-dialog local state
    in-out property <bool> share-dialog-open: false;
    property <int> share-monitor: State.default-monitor;
    property <int> share-quality: State.default-quality;
    property <int> share-scope: State.default-scope;   // 0 = my channel, 1 = everyone

    public function chat-at-bottom() -> bool { return chat-pane.at-bottom(); }
    public function chat-scroll-to-end() { chat-pane.scroll-to-end(); }
    public function chat-pin-bottom() { chat-pane.pin-to-bottom(); }
    public function chat-follow-appended() { chat-pane.follow-appended(); }
    // The shell calls this after anything that took the keyboard (a
    // conversation switch, a dialog, menu or page closing, a send). On
    // a touch host the soft keyboard comes up when the composer is
    // tapped, never on the app's own initiative — so the composer
    // keeps focus if it has it, and otherwise `nav-keys` takes it, so
    // Android's Back still finds a handler (ANDROID-SPEC.md D26).
    public function focus-composer() {
        if (!State.touch-host) {
            chat-pane.focus-composer();
        } else if (!chat-pane.composer-focused()) {
            nav-keys.focus();
        }
    }
    public function composer-set-cursor(pos: int) { chat-pane.composer-set-cursor(pos); }
    // The composer's menu entries (the host dispatches the pick).
    public function composer-cut() { chat-pane.composer-cut(); }
    public function composer-copy() { chat-pane.composer-copy(); }

    // Flipped by the shell after a minimize→restore on Windows: the OS
    // repaints the uncovered window white, but the renderer's damage
    // tracking still trusts the back buffer, so partial presents only
    // patch hovered slivers. Changing this dirties the full window
    // (the overlay spans everything — z-order is irrelevant, only the
    // dirtied region matters) and one full repaint follows. Alpha
    // 1/255 is imperceptible.
    in property <bool> repaint-flip;
    Rectangle {
        width: 100%;
        height: 100%;
        background: root.repaint-flip ? #FFFFFF01 : transparent;
    }
    public function open-share-dialog() {
        share-monitor = State.default-monitor;
        share-quality = State.default-quality;
        // Prefilled from the last share (saved settings) — the dialog
        // shows exactly what the share hotkey would start.
        share-scope = State.default-scope;
        share-dialog-open = true;
    }

    // ── Phases ─────────────────────────────────────────────────────
    // The main screen is a persistent instance (visible-gated, not
    // `if`-gated) so the shell can query/drive chat scroll state at any
    // time; the model is cleared per connection, matching the FLTK
    // build's fresh-chat-per-session semantics.
    // ── The part of the window that is ours (ANDROID-SPEC.md D35) ──
    // On a phone the system bars draw over the window's edges (Android
    // 15+ is always edge to edge) and the on-screen keyboard over its
    // bottom: the pages keep clear of both, so the composer rides up
    // above the keyboard instead of under it. Backgrounds still fill the
    // whole window. All zero on the desktop.
    property <length> keyboard-overlap: root.virtual-keyboard-size.height > 0
        ? Math.max(0px, root.height - root.virtual-keyboard-position.y) : 0px;
    // The system's edges: the larger of what the window reports and
    // what the host measured itself (iOS, IOS-SPEC.md §14 D39 — the
    // window's value was 0 under an iPhone SE's status bar).
    property <length> edge-left: Math.max(root.safe-area-insets.left, State.host-inset-left);
    property <length> edge-top: Math.max(root.safe-area-insets.top, State.host-inset-top);
    property <length> edge-right: Math.max(root.safe-area-insets.right, State.host-inset-right);
    property <length> edge-bottom: Math.max(root.safe-area-insets.bottom, State.host-inset-bottom);
    property <length> inset-left: root.edge-left;
    property <length> inset-top: root.edge-top;
    property <length> inset-right: root.edge-right;
    property <length> inset-bottom: Math.max(root.edge-bottom, root.keyboard-overlap);
    property <length> page-width: root.width - root.inset-left - root.inset-right;
    property <length> page-height: root.height - root.inset-top - root.inset-bottom;

    if State.phase != Phase.connect && State.phase != Phase.main : StartupView {
        x: root.inset-left;
        y: root.inset-top;
        width: root.page-width;
        height: root.page-height;
    }
    if State.phase == Phase.connect : ConnectView {
        x: root.inset-left;
        y: root.inset-top;
        width: root.page-width;
        height: root.page-height;
    }
    // ── Wide and narrow (ANDROID-SPEC.md D26) ──────────────────────
    // Wide: the sidebar and the chat side by side, the edge between
    // them draggable. Narrow (a phone held upright): one page at a
    // time — the sidebar as a full-width list; tapping General or a DM
    // slides the chat in from the right, and the chat header's arrow
    // (or Android's Back) slides the list back. The width alone
    // decides, so a phone turned sideways or a desktop window made
    // narrow follows.
    property <bool> narrow: root.width < 600px;
    // 0 = the list, 1 = the chat; animated, so the pages slide.
    property <float> chat-shown: State.narrow-chat-open ? 1 : 0;
    animate chat-shown { duration: 220ms; easing: ease-out; }
    property <bool> chat-page: root.narrow && State.narrow-chat-open
        && State.phase == Phase.main;
    // Back has to reach a key handler that takes it, or Android
    // finishes the activity: the handler is `nav-keys` below, which
    // only sees keys while it or something inside it has focus.
    // Opening the chat page gives it focus (a tap on the composer
    // then takes it over; nav-keys still sees Back first). Leaving it
    // takes focus off the composer it hides, so the keyboard goes too.
    // (Not when the page changes because the window widened or the
    // session ended: the composer or the connect view keeps its focus.)
    changed chat-page => {
        if (root.narrow && State.phase == Phase.main
            && (!root.chat-page || !chat-pane.composer-focused())) {
            nav-keys.focus();
        }
    }
    // While the sidebar's edge is dragged, only a line moves: the
    // width lands on release. Re-laying out the chat (every message
    // re-wraps) on every pointer move flickered the whole window.
    property <length> sidebar-preview: -1px;
    nav-keys := FocusScope {
        // Only ever focused on purpose: a click must leave the
        // desktop's composer its focus, and Tab must not stop here.
        focus-on-click: false;
        focus-on-tab-navigation: false;
        width: 100%;
        height: 100%;
        // The capture phase, so Back is ours before any field inside
        // (a read-only message row forwards every key it gets).
        capture-key-pressed(ev) => {
            if (ev.text == Key.Back && root.chat-page) {
                State.narrow-chat-open = false;
                return accept;
            }
            reject
        }
        main-screen := Rectangle {
            x: root.inset-left;
            y: root.inset-top;
            width: root.page-width;
            height: root.page-height;
            visible: State.phase == Phase.main;
            // The chat pane is a persistent instance (the shell drives
            // its scroll and composer at any time), so both pages are
            // placed by hand rather than swapped with `if`.
            sidebar-box := Rectangle {
                // Narrow: pushed out to the left as the chat comes in
                // from the right (the two never overlap).
                x: root.narrow ? -root.chat-shown * parent.width : 0;
                width: root.narrow ? parent.width : State.sidebar-width;
                visible: !root.narrow || root.chat-shown < 1;
                // Above the chat pane, so a tooltip at the edge is not
                // painted over by it.
                z: 1;
                Sidebar { }
                grip := TouchArea {
                    x: parent.width - 4px;
                    width: 8px;
                    enabled: !root.narrow;
                    mouse-cursor: MouseCursor.col-resize;
                    pure function target() -> length {
                        return Math.clamp(State.sidebar-width + (self.mouse-x - self.pressed-x),
                            220px, Math.min(480px, root.width - 360px));
                    }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            root.sidebar-preview = State.sidebar-width;
                        } else if (ev.kind == PointerEventKind.up && root.sidebar-preview >= 0px) {
                            State.sidebar-width = self.target();
                            root.sidebar-preview = -1px;
                            Logic.sidebar-resized(State.sidebar-width);
                        } else if (ev.kind == PointerEventKind.cancel) {
                            root.sidebar-preview = -1px;
                        }
                    }
                    moved => { if (self.pressed) { root.sidebar-preview = self.target(); } }
                }
            }
            chat-pane := ChatPane {
                narrow: root.narrow;
                x: root.narrow ? (1 - root.chat-shown) * parent.width : State.sidebar-width;
                width: root.narrow ? parent.width : parent.width - State.sidebar-width;
                height: parent.height;
                visible: !root.narrow || root.chat-shown > 0;
            }
        }
    }
    if root.sidebar-preview >= 0px : Rectangle {
        x: root.inset-left + root.sidebar-preview - 1px;
        width: 2px;
        height: 100%;
        background: Theme.accent-text;
    }

    // ── Profile card (spec §7.1, §8) ───────────────────────────────
    // Summoned by a roster row or an author's picture in chat, which
    // set `State.card-*` (window coordinates of the hovered element).
    // Shown after a short dwell like a native tooltip; the fields bind
    // to the roster row, so telemetry arriving while the pointer
    // rests updates it live.
    // Which card is asked for: a roster row (its index), a chat author
    // no longer in the roster (-2, `State.card-guest`), or none (-1).
    property <int> card-key: State.card-index >= 0 ? State.card-index
        : State.card-guest-open ? -2 : -1;
    property <int> card-shown-for: -1;
    Timer {
        interval: 450ms;
        running: root.card-key != -1 && root.card-shown-for != root.card-key;
        triggered => { root.card-shown-for = root.card-key; }
    }
    if root.card-key != -1 && root.card-shown-for == root.card-key
        && (root.card-key == -2
            || (State.card-index < State.users.length
                && !State.users[State.card-index].is-channel)) : card := Rectangle {
        property <UserRow> who: root.card-key == -2 ? State.card-guest : State.users[State.card-index];
        x: Math.max(Theme.gap-md, Math.min(State.card-x, root.width - self.width - Theme.gap-md));
        y: Math.min(State.card-y + State.card-anchor-h + 4px, root.height - self.height - Theme.gap-md);
        width: 272px;
        height: card-body.preferred-height;
        border-radius: Theme.radius-md;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;

        card-body := VerticalLayout {
            padding: Theme.gap-md;
            spacing: Theme.gap-sm;
            HorizontalLayout {
                spacing: Theme.gap-md;
                AvatarTile {
                    source: card.who.avatar;
                    has-image: card.who.has-avatar;
                    initial: card.who.initial;
                    tint: card.who.tile-tint;
                    side: 64px;
                    corner: 8px;
                    ring-room: false;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    horizontal-stretch: 1;
                    Text {
                        text: card.who.name;
                        color: card.who.has-name-color ? card.who.name-color : Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: card.who.name-style == 1 ? 700 : 600;
                        font-italic: card.who.name-style == 2;
                        overflow: elide;
                    }
                    // "Level 5 · 🔧 Organizer": the role in its own
                    // color (gold for admins), or "Offline" for a
                    // guest card.
                    if card.who.level-label != "" || card.who.role-label != "" : HorizontalLayout {
                        spacing: Theme.gap-xs;
                        if card.who.level-label != "" : Text {
                            text: card.who.level-label;
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                        }
                        if card.who.level-label != "" && card.who.role-label != "" : Text {
                            text: "·";
                            color: Theme.text-muted;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                        }
                        // A custom role's own glyph and color first; the
                        // built-ins keep theirs.
                        if card.who.role-icon != "" : RoleGlyph {
                            name: card.who.role-icon;
                            size: 13px;
                            stroke: card.who.has-role-color ? card.who.role-color : Theme.text-secondary;
                        }
                        if card.who.role-icon == ""
                            && (card.who.role == 1 || card.who.role == 3 || card.who.role == 4) : Rectangle {
                            width: 13px;
                            IconDisplay {
                                icon: card.who.role == 4 ? IconSet.Shield
                                    : card.who.role == 3 ? IconSet.Wrench
                                    : IconSet.CircleDashed;
                                size: 13px;
                                stroke: card.who.role == 4 ? Theme.admin
                                    : card.who.role == 3 ? Theme.accent-text
                                    : Theme.text-muted;
                            }
                        }
                        if card.who.role-label != "" : Text {
                            text: card.who.role-label;
                            color: card.who.has-role-color ? card.who.role-color
                                : card.who.role == 4 ? Theme.admin
                                : card.who.role == 3 ? Theme.accent-text
                                : card.who.role == 1 ? Theme.text-muted
                                : Theme.text-secondary;
                            font-size: Theme.font-sm;
                            font-weight: card.who.role >= 3 ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    // How far into the level (spec §9.1): a bar and
                    // the numbers, once the server has said.
                    if card.who.xp-pct >= 0 : VerticalLayout {
                        spacing: 3px;
                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.subtle;
                            Rectangle {
                                x: 0;
                                width: parent.width * Math.clamp(card.who.xp-pct, 0, 100) / 100;
                                height: parent.height;
                                border-radius: 3px;
                                background: Theme.accent-text;
                                animate width { duration: 200ms; }
                            }
                        }
                        Text {
                            text: card.who.xp-line;
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            overflow: elide;
                        }
                    }
                }
            }
            if card.who.telemetry != "" : Rectangle {
                height: 1px;
                background: Theme.border;
            }
            if card.who.telemetry != "" : Text {
                text: card.who.telemetry;
                color: Theme.text-secondary;
                font-size: Theme.font-xs;
                font-family: "monospace";
                wrap: word-wrap;
            }
        }
    }

    // ── Context menu ───────────────────────────────────────────────
    // The host fills `State.menu-*` and opens it; a click anywhere
    // outside the columns (consumed, as a native menu would) or
    // Escape closes it. A second column opens beside an entry with a
    // submenu while the pointer rests on it, to the right when there
    // is room, else to the left; both columns stay inside the window.
    if State.menu-open : menu-layer := Rectangle {
        property <int> open-entry: -1;
        property <int> open-model: -1;
        property <length> open-y;
        TouchArea {
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) { Logic.menu-closed(); }
            }
        }
        menu-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape || ev.text == Key.Back) { Logic.menu-closed(); return accept; }
                reject
            }
        }
        main-column := MenuPanel {
            entries: State.menu-entries;
            open-entry: menu-layer.open-entry;
            volume <=> State.menu-volume;
            volume-changed(v) => { Logic.menu-volume-changed(v); }
            volume-released(v) => { Logic.menu-volume-released(v); }
            x: Math.max(Theme.gap-sm, Math.min(State.menu-x, root.width - self.width - Theme.gap-sm));
            y: Math.max(Theme.gap-sm, Math.min(State.menu-y, root.height - self.height - Theme.gap-sm));
            submenu-hovered(entry, model, y) => {
                menu-layer.open-entry = model >= 0 ? entry : -1;
                menu-layer.open-model = model;
                menu-layer.open-y = y;
            }
            activated(action, arg) => { Logic.menu-activated(action, arg); }
        }
        if menu-layer.open-model >= 0 && menu-layer.open-model < State.menu-submenus.length : MenuPanel {
            entries: State.menu-submenus[menu-layer.open-model];
            x: main-column.x + main-column.width - 4px + self.width <= root.width - Theme.gap-sm
                ? main-column.x + main-column.width - 4px
                : Math.max(Theme.gap-sm, main-column.x - self.width + 4px);
            y: Math.max(Theme.gap-sm, Math.min(main-column.y + menu-layer.open-y - 4px,
                root.height - self.height - Theme.gap-sm));
            activated(action, arg) => { Logic.menu-activated(action, arg); }
        }
    }

    // ── Stream viewer as a page (single-window hosts; ANDROID-SPEC.md D23)
    // The desktop never sets State.watch-open (it opens a
    // StreamViewerWindow per peer). Above the main screen, below the
    // settings page so Settings can be opened over a running stream.
    if State.watch-open : Rectangle {
        background: black;
        TouchArea { }
        StreamViewerPanel {
            // The whole screen, edge to edge: the picture is no UI and
            // may sit under the notch, the home indicator and the
            // system bars. Only the chrome keeps to the safe area (not
            // the keyboard's: nothing types here).
            width: parent.width;
            height: parent.height;
            chrome-inset-left: root.edge-left;
            chrome-inset-top: root.edge-top;
            chrome-inset-right: root.edge-right;
            chrome-inset-bottom: root.edge-bottom;
            // Takes the keyboard so Back / M / Escape reach it; the
            // composer gets it back when the page closes.
            init => { self.focus(); }
            peer-name: State.watch-peer-name;
            frame: State.watch-frame;
            stats: State.watch-stats;
            fullscreen-available: false;
            // Zoom-to-fill, kept for the session across streams.
            fill-available: true;
            fill <=> State.watch-fill;
            // A quarter turn for a phone held upright with its rotation
            // locked (the bar's Rotate button), kept the same way.
            rotate-available: true;
            rotated <=> State.watch-rotated;
            stream-muted <=> State.watch-muted;
            volume <=> State.watch-volume;
            // Your own mic and headphones, without leaving (IOS-SPEC.md
            // §14 D43): the sidebar's buttons, here too.
            self-controls: true;
            pinch-from-touch: true;
            self-muted: State.muted;
            self-deafened: State.deafened;
            volume-changed(v) => { Logic.watch-volume-changed(v); }
            mute-toggled(m) => { Logic.watch-mute-toggled(m); }
            stop-watching => { Logic.watch-stop(); }
            self-mute-toggled => { Logic.toggle-mute(); }
            self-deafen-toggled => { Logic.toggle-deafen(); }
        }
    }

    // ── Settings as a page (single-window hosts; ANDROID-SPEC.md D22) ──
    // The desktop never sets State.settings-open (it opens
    // SettingsWindow), so this is not instantiated there. Above the
    // main screen and the context menu, below the toast and dialogs.
    if State.settings-open : Rectangle {
        background: Theme.bg-primary;
        // Swallow taps on the page's empty areas so nothing reaches
        // the roster and chat underneath (the other overlays do the
        // same with their scrims).
        TouchArea { }
        // Android's Back steps back (a section → the list → out, saved,
        // as the button does): taken in the capture phase, before any
        // field inside sees it.
        // Focused on open so it is in the focus chain from the start
        // (the shell hands focus back when the page closes).
        FocusScope {
            x: root.inset-left;
            y: root.inset-top;
            width: root.page-width;
            height: root.page-height;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            init => { self.focus(); }
            capture-key-pressed(ev) => {
                if (ev.text == Key.Back) {
                    settings-panel.back();
                    return accept;
                }
                reject
            }
            settings-panel := SettingsPanel {
                tab <=> State.settings-tab;
                section-open <=> State.settings-section-open;
                narrow: root.narrow;
            }
        }
    }

    // ── Toast (any phase; the connect view also shows it inline) ───
    // One register per kind: the glyph and the border carry the color,
    // the message stays in primary text so it reads on the tint. A
    // click dismisses it before the 5 s timer does.
    // A file dragged in from the OS: the whole window says where it
    // will go. No TouchArea, so a stale hover (a cancel the platform
    // never sent) still lets clicks through.
    if State.drop-hover && State.phase == Phase.main : Rectangle {
        background: Theme.bg-primary.with-alpha(0.82);
        Rectangle {
            width: Math.min(root.width - 4 * Theme.gap-lg, 420px);
            height: 140px;
            border-radius: Theme.radius-lg;
            border-width: 2px;
            border-color: Theme.accent-text;
            background: Theme.bg-tertiary;
            VerticalLayout {
                alignment: center;
                spacing: Theme.gap-sm;
                HorizontalLayout {
                    alignment: center;
                    IconDisplay {
                        icon: IconSet.Upload;
                        size: 32px;
                        stroke: Theme.accent-text;
                    }
                }
                Text {
                    text: Tr.drop-to-send;
                    color: Theme.text-primary;
                    font-size: Theme.font-lg;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }
    }

    if State.error-text != "" && State.phase == Phase.main : toast-box := Rectangle {
        property <color> tone: State.toast-kind == ToastKind.error ? Theme.danger
            : State.toast-kind == ToastKind.warning ? Theme.warning
            : State.toast-kind == ToastKind.success ? Theme.success
            : Theme.accent-text;
        x: (root.width - self.width) / 2;
        y: Theme.gap-lg;
        width: Math.min(toast-row.preferred-width + 2 * Theme.gap-md, root.width - 2 * Theme.gap-lg);
        height: toast-row.preferred-height + 2 * Theme.gap-sm + 4px;
        border-radius: Theme.radius-md;
        background: Theme.bg-tertiary;
        border-width: 1px;
        border-color: self.tone.with-alpha(0.6);
        drop-shadow-color: #00000066;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        toast-row := HorizontalLayout {
            padding-left: Theme.gap-md;
            padding-right: Theme.gap-md;
            spacing: Theme.gap-sm;
            Rectangle {
                width: 16px;
                IconDisplay {
                    icon: State.toast-kind == ToastKind.error ? IconSet.CircleX
                        : State.toast-kind == ToastKind.warning ? IconSet.TriangleAlert
                        : State.toast-kind == ToastKind.success ? IconSet.CircleCheck
                        : IconSet.Info;
                    size: 16px;
                    stroke: toast-box.tone;
                }
            }
            toast := Text {
                text: State.error-text;
                color: Theme.text-primary;
                font-size: Theme.font-body;
                vertical-alignment: center;
                wrap: word-wrap;
                max-width: root.width - 2 * Theme.gap-lg - 48px;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { Logic.toast-dismiss(); }
        }
    }

    // ── Image send preview (modal overlay) ─────────────────────────
    if State.preview-open : Rectangle {
        background: #000000AA;
        TouchArea { clicked => { Logic.preview-cancel(); } }
        // Enter = Send, Escape = Cancel — same paths as the buttons;
        // the shell refocuses the composer after the dialog closes.
        preview-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Return) { Logic.preview-send(); return accept; }
                if (ev.text == Key.Escape || ev.text == Key.Back) { Logic.preview-cancel(); return accept; }
                reject
            }
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(520px, root.width - 48px);
                height: pv.preferred-height;
                TouchArea { }   // swallow clicks inside the card
                pv := VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    Text {
                        text: Tr.image-preview-title;
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Rectangle {
                        height: 300px;
                        border-radius: Theme.radius-md;
                        background: Theme.surface;
                        clip: true;
                        Image {
                            width: parent.width - 2 * Theme.gap-sm;
                            height: parent.height - 2 * Theme.gap-sm;
                            source: State.preview-image;
                            image-fit: contain;
                        }
                    }
                    Text {
                        text: State.preview-caption;
                        color: Theme.text-muted;
                        font-size: Theme.font-sm;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        Btn { text: Tr.cancel; clicked => { Logic.preview-cancel(); } }
                        Btn { text: Tr.send; accent: true; clicked => { Logic.preview-send(); } }
                    }
                }
            }
        }
    }


    // ── Image viewer (modal overlay; darkened scrim like the preview) ──
    if State.viewer-open : Rectangle {
        background: #000000CC;
        TouchArea {
            clicked => {
                Logic.viewer-close();
                root.focus-composer();
            }
        }
        // Keyboard: Escape (Back) closes, ◀ ▶ step the gallery. The
        // scope grabs focus on creation and hands it back to the
        // composer on close, so typing resumes without an extra click.
        viewer-keys := FocusScope {
            init => { self.focus(); }
            function close() {
                Logic.viewer-close();
                root.focus-composer();
            }
            key-pressed(ev) => {
                if (ev.text == Key.Escape || ev.text == Key.Back) { close(); return accept; }
                if (ev.text == Key.LeftArrow) {
                    if (State.viewer-has-prev) { Logic.viewer-step(-1); }
                    return accept;
                }
                if (ev.text == Key.RightArrow) {
                    if (State.viewer-has-next) { Logic.viewer-step(1); }
                    return accept;
                }
                reject
            }
            VerticalLayout {
                // A layout inside a plain element sizes to its preferred
                // height unless told otherwise — pin it to the scrim so
                // the picture row actually stretches.
                width: 100%;
                height: 100%;
                padding: Theme.gap-lg;
                spacing: Theme.gap-md;
                HorizontalLayout {
                    height: 32px;
                    Text {
                        text: State.viewer-heading;
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconBtn {
                        icon: IconSet.Copy;
                        tooltip: Tr.menu-copy-image;
                        clicked => { Logic.viewer-copy(); }
                    }
                    IconBtn {
                        icon: IconSet.Download;
                        tooltip: Tr.menu-save-image;
                        clicked => { Logic.viewer-save(); }
                    }
                    IconBtn {
                        icon: IconSet.X;
                        clicked => { viewer-keys.close(); }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.gap-md;
                    vertical-stretch: 1;
                    // The chevrons must not sit directly in this row:
                    // IconBtn pins `height: size` (40px), and a fixed-height
                    // child caps a HorizontalLayout's max-height — the whole
                    // row collapsed to 40px and the picture rendered as a
                    // thumbnail. Height-unconstrained wrappers keep the row
                    // stretchable; each button centers itself inside.
                    Rectangle {
                        width: nav-l.width;
                        nav-l := IconBtn {
                            y: (parent.height - self.height) / 2;
                            icon: IconSet.ChevronLeft;
                            opacity: State.viewer-has-prev ? 1.0 : 0.25;
                            clicked => { if (State.viewer-has-prev) { Logic.viewer-step(-1); } }
                        }
                    }
                    picture := Rectangle {
                        horizontal-stretch: 1;
                        // contain-fitted bounds of the displayed image —
                        // the swallow area matches the pixels, so clicks
                        // on the letterbox fall through to the scrim and
                        // close the viewer.
                        property <float> src-w: Math.max(1, State.viewer-image.width);
                        property <float> src-h: Math.max(1, State.viewer-image.height);
                        property <float> fit: Math.min(
                            self.width / 1px / self.src-w,
                            self.height / 1px / self.src-h);
                        property <length> fit-w: self.src-w * self.fit * 1px;
                        property <length> fit-h: self.src-h * self.fit * 1px;
                        viewer-img := Image {
                            width: parent.width;
                            height: parent.height;
                            source: State.viewer-image;
                            image-fit: contain;
                        }
                        TouchArea {   // swallow clicks over the picture itself
                            x: (parent.width - parent.fit-w) / 2;
                            y: (parent.height - parent.fit-h) / 2;
                            width: parent.fit-w;
                            height: parent.fit-h;
                        }
                    }
                    Rectangle {
                        width: nav-r.width;
                        nav-r := IconBtn {
                            y: (parent.height - self.height) / 2;
                            icon: IconSet.ChevronRight;
                            opacity: State.viewer-has-next ? 1.0 : 0.25;
                            clicked => { if (State.viewer-has-next) { Logic.viewer-step(1); } }
                        }
                    }
                }
            }
        }
    }

    // ── Screen-share dialog (modal overlay) ────────────────────────
    if root.share-dialog-open : Rectangle {
        background: #000000AA;
        TouchArea { clicked => { root.share-dialog-open = false; } }
        share-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape || ev.text == Key.Back) { root.share-dialog-open = false; return accept; }
                reject
            }
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 380px;
                height: sh.preferred-height;
                TouchArea { }
                sh := VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    Text {
                        text: Tr.share-screen;
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 600;
                    }
                    FieldLabel { text: Tr.monitor; }
                    Dropdown {
                        options: State.monitors;
                        current <=> root.share-monitor;
                    }
                    FieldLabel { text: Tr.quality; }
                    Dropdown {
                        options: State.qualities;
                        current <=> root.share-quality;
                    }
                    FieldLabel { text: Tr.share-visibility; }
                    Dropdown {
                        options: [Tr.share-channel-only, Tr.share-everyone];
                        current <=> root.share-scope;
                    }
                    Btn {
                        text: Tr.start-sharing;
                        accent: true;
                        clicked => {
                            root.share-dialog-open = false;
                            Logic.start-share(root.share-monitor, root.share-quality,
                                root.share-scope == 1);
                        }
                    }
                }
            }
        }
    }
    // ── Channel password prompt (modal overlay) ────────────────────
    // Opened by the shell when a locked channel is clicked with no
    // saved password, or when the server answers WrongPassword. OK
    // saves the password on the server entry and retries the join.
    if State.channel-prompt-open : Rectangle {
        background: #000000AA;
        TouchArea { clicked => { Logic.channel-password-cancel(); } }
        chp-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape || ev.text == Key.Back) { Logic.channel-password-cancel(); return accept; }
                reject
            }
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 340px;
                height: chp.preferred-height;
                TouchArea { }
                chp := VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    Text {
                        text: "\{Tr.channel-password-title} — \{State.channel-prompt-name}";
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        overflow: elide;
                    }
                    chp-field := Field {
                        placeholder: Tr.channel-password-title;
                        secret: true;
                        text <=> State.channel-password;
                        init => { self.focus-input(); }
                        accepted => { Logic.channel-password-ok(); }
                    }
                    if State.channel-prompt-error != "" : Text {
                        text: State.channel-prompt-error;
                        color: Theme.danger;
                        font-size: Theme.font-xs;
                    }
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        Btn {
                            text: Tr.cancel;
                            clicked => { Logic.channel-password-cancel(); }
                        }
                        Btn {
                            text: Tr.channel-join;
                            accent: true;
                            clicked => { Logic.channel-password-ok(); }
                        }
                    }
                }
            }
        }
    }

    // ── Invite dialog (spec §3.1) ──────────────────────────────────
    // Pick who the code admits, for how long and how many times; the
    // code appears in the same dialog once the server minted it (and
    // is on the clipboard already). Escape closes.
    if State.invite-dialog-open : Rectangle {
        background: #000000AA;
        TouchArea { clicked => { Logic.invite-dialog-cancel(); } }
        inv-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape || ev.text == Key.Back) { Logic.invite-dialog-cancel(); return accept; }
                if (ev.text == Key.Return && State.invite-dialog-code == "") {
                    Logic.invite-dialog-create();
                    return accept;
                }
                reject
            }
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(400px, root.width - 48px);
                height: invd.preferred-height;
                TouchArea { }
                invd := VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    Text {
                        text: Tr.invite-dialog-title;
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 600;
                    }
                    if State.invite-dialog-code == "" : VerticalLayout {
                        spacing: Theme.gap-md;
                        VerticalLayout {
                            spacing: Theme.gap-xs;
                            FieldLabel { text: Tr.invite-role; }
                            Dropdown {
                                options: State.invite-role-options;
                                current <=> State.invite-dialog-role;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.gap-md;
                            VerticalLayout {
                                spacing: Theme.gap-xs;
                                FieldLabel { text: Tr.invite-expiry; }
                                Dropdown {
                                    options: State.invite-expiry-options;
                                    current <=> State.invite-dialog-expiry;
                                }
                            }
                            VerticalLayout {
                                spacing: Theme.gap-xs;
                                FieldLabel { text: Tr.invite-uses-label; }
                                Dropdown {
                                    options: State.invite-uses-options;
                                    current <=> State.invite-dialog-uses;
                                }
                            }
                        }
                        if State.invite-dialog-expiry > 1 && !State.perm-manage-invites : Hint {
                            text: Tr.invite-expiry-note;
                        }
                    }
                    // The minted code: big, monospace, one click to copy.
                    if State.invite-dialog-code != "" : VerticalLayout {
                        spacing: Theme.gap-sm;
                        Rectangle {
                            height: 56px;
                            border-radius: Theme.radius-md;
                            background: code-t.has-hover ? Theme.hover : Theme.bg-primary;
                            border-width: 1px;
                            border-color: Theme.border;
                            animate background { duration: 150ms; }
                            HorizontalLayout {
                                padding-left: Theme.gap-md;
                                padding-right: Theme.gap-md;
                                spacing: Theme.gap-sm;
                                Text {
                                    text: State.invite-dialog-code;
                                    color: Theme.text-primary;
                                    font-family: "monospace";
                                    font-size: Theme.font-lg;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Rectangle {
                                    width: 18px;
                                    IconDisplay {
                                        icon: IconSet.Copy;
                                        size: 18px;
                                        stroke: Theme.text-secondary;
                                    }
                                }
                            }
                            code-t := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { Logic.invite-dialog-copy(); }
                            }
                        }
                        Text {
                            text: State.invite-dialog-summary;
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            wrap: word-wrap;
                        }
                        Hint { text: Tr.invite-share-hint; }
                    }
                    if State.invite-dialog-error != "" : Text {
                        text: State.invite-dialog-error;
                        color: Theme.danger-text;
                        font-size: Theme.font-sm;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        Btn {
                            text: State.invite-dialog-code == "" ? Tr.cancel : Tr.invite-close;
                            clicked => { Logic.invite-dialog-cancel(); }
                        }
                        if State.invite-dialog-code == "" : Btn {
                            text: Tr.invite-create;
                            accent: true;
                            clicked => { Logic.invite-dialog-create(); }
                        }
                        if State.invite-dialog-code != "" : Btn {
                            text: Tr.invite-copy;
                            accent: true;
                            clicked => { Logic.invite-dialog-copy(); }
                        }
                    }
                }
            }
        }
    }

    // ── Channel dialog (create / edit; spec §5) ────────────────────
    // The host validates the numbers and sends the spec; the dialog
    // stays open until the server's list update (success) or its
    // refusal, shown inline. Escape cancels, Enter in a field saves.
    if State.channel-dialog-open : Rectangle {
        background: #000000AA;
        TouchArea { clicked => { Logic.channel-dialog-cancel(); } }
        ch-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape || ev.text == Key.Back) { Logic.channel-dialog-cancel(); return accept; }
                reject
            }
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(400px, root.width - 48px);
                height: chd.preferred-height;
                TouchArea { }
                chd := VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    Text {
                        text: State.channel-dialog-title;
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        overflow: elide;
                    }
                    VerticalLayout {
                        spacing: Theme.gap-xs;
                        FieldLabel { text: Tr.channel-name; }
                        Field {
                            text <=> State.channel-dialog-name;
                            placeholder: Tr.channel-name-placeholder;
                            init => { self.focus-input(); }
                            accepted => { Logic.channel-dialog-save(); }
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.gap-xs;
                        FieldLabel { text: Tr.channel-password-title; }
                        Field {
                            text <=> State.channel-dialog-password;
                            placeholder: Tr.channel-password-placeholder;
                            secret: true;
                            accepted => { Logic.channel-dialog-save(); }
                        }
                        if State.channel-dialog-password-note != "" : Hint {
                            text: State.channel-dialog-password-note;
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.gap-md;
                        VerticalLayout {
                            spacing: Theme.gap-xs;
                            FieldLabel { text: Tr.channel-limit; }
                            Field {
                                text <=> State.channel-dialog-limit;
                                placeholder: Tr.channel-limit-placeholder;
                                accepted => { Logic.channel-dialog-save(); }
                            }
                        }
                        VerticalLayout {
                            spacing: Theme.gap-xs;
                            FieldLabel { text: Tr.channel-afk; }
                            Field {
                                text <=> State.channel-dialog-afk;
                                placeholder: Tr.channel-afk-placeholder;
                                accepted => { Logic.channel-dialog-save(); }
                            }
                        }
                    }
                    CheckRow {
                        text: Tr.channel-keep;
                        hint: Tr.channel-keep-hint;
                        checked <=> State.channel-dialog-keep;
                    }
                    CheckRow {
                        text: Tr.channel-members-only;
                        hint: Tr.channel-members-only-hint;
                        checked <=> State.channel-dialog-members-only;
                    }
                    if State.channel-dialog-error != "" : Text {
                        text: State.channel-dialog-error;
                        color: Theme.danger;
                        font-size: Theme.font-sm;
                        wrap: word-wrap;
                    }
                    if !State.server-persistent : Hint { text: Tr.channel-not-persistent-note; }
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        Btn { text: Tr.cancel; clicked => { Logic.channel-dialog-cancel(); } }
                        Btn {
                            text: State.channel-dialog-editing ? Tr.channel-save : Tr.channel-create;
                            accent: true;
                            clicked => { Logic.channel-dialog-save(); }
                        }
                    }
                }
            }
        }
    }

    // ── Generic confirm (delete a message, later a channel) ────────
    // Title and button repeat the consequence; Enter confirms, Escape
    // cancels. The host remembers what is being confirmed.
    if State.confirm-open : Rectangle {
        background: #000000AA;
        TouchArea { clicked => { Logic.confirm-cancel(); } }
        confirm-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape || ev.text == Key.Back) { Logic.confirm-cancel(); return accept; }
                if (ev.text == Key.Return) { Logic.confirm-accept(); return accept; }
                reject
            }
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(360px, root.width - 48px);
                height: cf.preferred-height;
                TouchArea { }
                cf := VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    Text {
                        text: State.confirm-title;
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    if State.confirm-body != "" : Hint { text: State.confirm-body; }
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        Btn { text: Tr.cancel; clicked => { Logic.confirm-cancel(); } }
                        Btn {
                            text: State.confirm-label;
                            danger: true;
                            clicked => { Logic.confirm-accept(); }
                        }
                    }
                }
            }
        }
    }

    // ── Moderation dialog (kick / ban / disconnect / mute) ─────────
    // Opened by the shell from the roster menu. The title and the
    // confirm label repeat the consequence, so the dialog is
    // answerable without reading the body; Escape cancels, Enter in
    // the reason field confirms.
    if State.moderation-open : Rectangle {
        background: #000000AA;
        TouchArea { clicked => { Logic.moderation-cancel(); } }
        mod-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape || ev.text == Key.Back) { Logic.moderation-cancel(); return accept; }
                reject
            }
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(380px, root.width - 48px);
                height: md.preferred-height;
                TouchArea { }
                md := VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    Text {
                        text: State.moderation-title;
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Hint { text: State.moderation-hint; }
                    if State.moderation-durations.length > 0 : VerticalLayout {
                        spacing: Theme.gap-xs;
                        FieldLabel { text: Tr.moderation-duration; }
                        Dropdown {
                            options: State.moderation-durations;
                            current <=> State.moderation-duration;
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.gap-xs;
                        FieldLabel { text: Tr.moderation-reason; }
                        Field {
                            placeholder: Tr.moderation-reason-placeholder;
                            text <=> State.moderation-reason;
                            init => { self.focus-input(); }
                            accepted => { Logic.moderation-confirm(); }
                        }
                    }
                    if !State.server-persistent : Hint { text: Tr.server-not-persistent-note; }
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        Btn { text: Tr.cancel; clicked => { Logic.moderation-cancel(); } }
                        Btn {
                            text: State.moderation-confirm-label;
                            // Mutes and disconnects are reversible; the
                            // raspberry fill is for the two that are not.
                            danger: State.moderation-action == ModAction.kick
                                || State.moderation-action == ModAction.ban;
                            accent: State.moderation-action != ModAction.kick
                                && State.moderation-action != ModAction.ban;
                            clicked => { Logic.moderation-confirm(); }
                        }
                    }
                }
            }
        }
    }

}
