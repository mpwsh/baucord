// tr.slint — localizable UI strings.
//
// Fluent stays on the Rust side (the `i18n` crate is unchanged): the
// shell writes every one of these `in` properties from `t!(...)` at
// startup and again on every language change, so switching languages
// re-renders live — no view rebuilds, unlike the FLTK build.
//
// Strings with arguments (chat notices, stats lines, error toasts,
// window titles) are *not* here: Rust formats them and pushes the
// final string through state properties instead.
//
// The English defaults keep `slint-viewer` previews readable.

export global Tr {
    // Connect view
    in property <string> app-tagline: "voice, chat & screen share for your crew";
    in property <string> nickname: "Nickname";
    in property <string> invite-code: "Invite code";
    in property <string> invite-code-placeholder: "e.g. K7FQ-2MX9-ABCD — only needed the first time";
    in property <string> connect: "Connect";
    in property <string> settings: "Settings";
    in property <string> quit: "Quit";

    // Sidebar
    in property <string> voice-header: "Voice";
    in property <string> lobby-banner: "Join a voice channel to start talking";
    in property <string> drop-to-send: "Drop to send";
    in property <string> lobby-mic-hint: "Join a channel to talk";
    in property <string> messages-collapse: "Collapse messages";
