// tr.slint — the localizable UI strings, by name only.
//
// The words live in `crates/i18n/locales/*.ftl`, under the same names
// (English included: no text here). The frontend's build script turns
// this list into `fill_tr`, which sets every property from Fluent at
// startup and on every language change, so switching languages
// re-renders live; the build fails when a locale lacks one of them.
// A new string: a line here, and a message in each .ftl.
//
// Strings with arguments (chat notices, stats lines, error toasts,
// window titles) are *not* here: Rust formats them and pushes the
// final string through state properties instead.
//
// Previews (`slint-viewer`) show these empty unless given data.

export global Tr {
    // Connect view
    in property <string> app-tagline;
    in property <string> nickname;
    in property <string> invite-code;
    in property <string> invite-code-placeholder;
    in property <string> connect;
    in property <string> settings;
    in property <string> quit;
    // Quitting with unsaved Settings changes
    in property <string> quit-unsaved-title;
    in property <string> quit-unsaved-body;
    in property <string> quit-unsaved-save;
    in property <string> quit-unsaved-discard;

    // Sidebar
    in property <string> voice-header;
    in property <string> lobby-banner;
    in property <string> drop-to-send;
    in property <string> lobby-mic-hint;
    in property <string> messages-collapse;
    in property <string> messages-expand;
    in property <string> invite-button;
    // Invite dialog
