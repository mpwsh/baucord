name: Build FFmpeg prebuilt (Windows)

# Builds the pinned FFmpeg with vcpkg and uploads the resulting
# x64-windows-static-md tree to R2 as a zip. "Build and Release" then just
# downloads that zip (seconds) instead of spending ~45-50 min in vcpkg on
# every run.
#
# Run this manually (Actions -> Build FFmpeg prebuilt (Windows) -> Run
# workflow) whenever VCPKG_COMMIT, the feature set, or the triplet changes.
# The object is named the way release.yml's "Download prebuilt FFmpeg
# (Windows)" step asks for it: ci/ffmpeg-<first 10 of VCPKG_COMMIT>-
# x264-gpl-nvcodec-amf-x64-windows-static-md.zip. A new pin is a new
# name by itself; a new feature set or triplet changes the name here
# and there together. Never overwrite an object that a shipped workflow
# revision still references -- old commits must stay buildable. (This
# took a name to type, whose default matched nothing release.yml reads:
# review 2026-10. Kept disabled by the owner's decision; enable it by
# dropping `.disabled` when the pin moves.)

on:
  workflow_dispatch:

env:
  # FFmpeg comes from vcpkg PINNED to the last ffmpeg 7.1.2 port. vcpkg
  # HEAD ships FFmpeg 9.x, which ffmpeg-next 8.1 cannot build against
  # (FFmpeg 8 deleted the deprecated AVCodec field API the crate's
  # fallback path uses, and its version detection is unreliable under
  # vcpkg). Do NOT bump this without re-testing the full Windows build
  # AND a real stream -- encoder options are validated at runtime, not
  # compile time.
  # Must match VCPKG_COMMIT in release.yml.
  VCPKG_COMMIT: 34823ada10080ddca99b60e85f80f55e18a44eea # ffmpeg 7.1.2

jobs:
  build-ffmpeg:
    runs-on: windows-latest
    steps:
      # Shallow-fetch exactly the pinned commit instead of cloning HEAD
      # (HEAD's ffmpeg port is 9.x -- see VCPKG_COMMIT above).
      - name: Clone and bootstrap vcpkg (pinned)
        shell: pwsh
        run: |
          git init C:\vcpkg
          git -C C:\vcpkg remote add origin https://github.com/microsoft/vcpkg.git
          git -C C:\vcpkg fetch --depth 1 origin $env:VCPKG_COMMIT
          git -C C:\vcpkg checkout FETCH_HEAD
          C:\vcpkg\bootstrap-vcpkg.bat -disableMetrics

      # qsv is deliberately absent: at the pinned port it pulls the legacy
      # mfx dispatch (the vpl switch came later) and is untested with our
      # static-md link; the runtime encoder probe handles its absence.
      # Re-add only with a full retest.
      # vcpkg's default features also build avfilter, swresample and
      # avdevice, which nothing links since review 2026-10 P3-38:
      # harmless in the zip. Trimming them (`core,avcodec,avformat,
      # swscale`, as readme.md does for local builds) is a new feature
      # set: a new object name here and in release.yml, and a run of
      # this workflow before the next release.
      - name: Build FFmpeg via vcpkg
        shell: pwsh
        run: C:\vcpkg\vcpkg.exe install ffmpeg[x264,gpl,nvcodec,amf]:x64-windows-static-md --recurse

      - name: Package installed tree
        shell: pwsh
        run: |
          # Drop the debug tree: ffmpeg-sys-next only ever links
          # $FFMPEG_DIR/lib (the release libs) and CI builds the deploy
          # profile, so debug/ is dead weight -- roughly halves the zip.
          Remove-Item -Recurse -Force C:\vcpkg\installed\x64-windows-static-md\debug
          # 7z keeps x64-windows-static-md as the archive's root folder,
          # which is the layout the download step expects when it extracts
          # into C:\ffmpeg-prebuilt.
          7z a ffmpeg-prebuilt.zip C:\vcpkg\installed\x64-windows-static-md

      - name: Upload to R2
        shell: pwsh
        env:
          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
        run: |
          $obj = "ci/ffmpeg-$($env:VCPKG_COMMIT.Substring(0,10))-x264-gpl-nvcodec-amf-x64-windows-static-md.zip"
          aws s3 cp ffmpeg-prebuilt.zip "s3://baucord/$obj" --endpoint-url https://6bcc35de83e46a771896026baf11b4ac.r2.cloudflarestorage.com
